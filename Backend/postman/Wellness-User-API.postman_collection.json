    {
      "name": "Consultancy Payment",
      "description": "Checkout, Razorpay/mock payment, and transaction history. Optional referral code applies coach discount when valid.\n\nManual development flow requires `NODE_ENV=development`, `MOCK_PAYMENTS=true`, and `AUTO_CONFIRM_MOCK_PAYMENT=false`; restart Backend after changing environment values. Run Create Payment Order, then Verify Payment (mock dev).",
      "item": [
        {
          "name": "Checkout Preview",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/consultancy-payment/checkout-preview?referralCode={{referralCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["user", "consultancy-payment", "checkout-preview"],
              "query": [{ "key": "referralCode", "value": "{{referralCode}}", "description": "Optional valid referral code" }]
            }
          },
          "response": []
        },
        {
          "name": "Create Payment Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  const txnId = json?.data?.transaction?.id;",
                  "  const orderId = json?.data?.payment?.orderId;",
                  "  if (txnId) pm.collectionVariables.set('transactionId', txnId);",
                  "  if (orderId) pm.collectionVariables.set('razorpayOrderId', orderId);",
                  "  pm.test('Development mock order returned', function () {",
                  "    pm.expect(json?.data?.payment?.mockPayment).to.eql(true);",
                  "    pm.expect(orderId).to.match(/^order_mock_/);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"healthConcernId\": \"{{primaryHealthConcernId}}\",\n  \"referralCode\": \"{{referralCode}}\",\n  \"paymentMethod\": \"upi\"\n}"
            },
            "url": "{{baseUrl}}/user/consultancy-payment/orders"
          },
          "response": []
        },
        {
          "name": "Verify Payment (mock dev)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"{{transactionId}}\",\n  \"razorpay_order_id\": \"{{razorpayOrderId}}\",\n  \"razorpay_payment_id\": \"pay_mock_test\",\n  \"razorpay_signature\": \"mock\"\n}"
            },
            "url": "{{baseUrl}}/user/consultancy-payment/verify",
            "description": "Manual development confirmation. Requires `NODE_ENV=development`, `MOCK_PAYMENTS=true`, and `AUTO_CONFIRM_MOCK_PAYMENT=false`. Uses the transaction/order ids saved by Create Payment Order. The order id must start with `order_mock_`."
          },
          "response": []
        },
        {
          "name": "My Transaction History",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/user/consultancy-payment/transactions"
          },
          "response": []
        },
        {
          "name": "Get Transaction by ID",
