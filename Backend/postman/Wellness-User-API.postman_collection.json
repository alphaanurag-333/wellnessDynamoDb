        {
          "name": "Profile",
          "description": "Get / update own profile. Changing WhatsApp to a **different** number requires the WhatsApp OTP flow below. Dedicated phone OTP endpoints are preferred for mobile number changes.",
          "item": [
            {
              "name": "Get My Profile",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/user/auth/me"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
