# Copy to .env and fill secrets. Defaults live in config/index.js.

# --- Server ---
PORT=5000
NODE_ENV=development
ADMIN_REGISTRATION_ENABLED=false
EXPOSE_OTP_IN_RESPONSE=true
OTP_MAX_SENDS_BEFORE_COOLDOWN=3
OTP_COOLDOWN_MINUTES=10
BIRTHDAY_JOB_CRON_ENABLED=false
MONTHLY_CHAMPION_CRON_ENABLED=false
ENERGY_EXCHANGE_FY_CRON_ENABLED=false

# --- JWT ---
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# --- AWS ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_PUBLIC_BASE_URL=

# --- Firebase / OpenAI ---
FIREBASE_SERVICE_ACCOUNT_PATH=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- BhashSMS WhatsApp ---
BHASHSMS_USER=
BHASHSMS_PASS=
BHASHSMS_SENDER=BUZWAP
BHASHSMS_BASE_URL=http://bhashsms.com/api/sendmsgutil.php
BHASHSMS_TEMPLATE=invoice_irw01
BHASHSMS_INVOICE_TEMPLATE=invoice_irw01
BHASHSMS_TEMPLATE_PARAMS=1
BHASHSMS_REMINDER_TEMPLATE=general_reminder
BHASHSMS_ONBOARDING_REMINDER_TEMPLATE=gen_rem01
BHASHSMS_AUTH_BASE_URL=http://bhashsms.com/api/sendmsg.php
BHASHSMS_OTP_TEMPLATE=otp_auth_irw
BHASHSMS_PWC_USER_TEMPLATE=pwc_user_intim_01
BHASHSMS_PWC_COACH_TEMPLATE=pwc_initimate_021
BHASHSMS_PROGRAM_CONFIRM_TEMPLATE=ir_prg_confirm_01
BHASHSMS_UOB_BA_TEMPLATE=ir_uob_ba_01
BHASHSMS_UOB_BR_TEMPLATE=ir_uob_br_01
BHASHSMS_UOB_CL_TEMPLATE=ir_uob_cl_01
BHASHSMS_UOB_HAP_TEMPLATE=ir_uob_hap_01
BHASHSMS_UOB_LAU_TEMPLATE=ir_uob_lau_01
BHASHSMS_UOB_PI_COACH_TEMPLATE=ir_uob_pi_011
BHASHSMS_UOB_PI_USER_TEMPLATE=ir_uob_pi_012
BHASHSMS_UOB_RB_TEMPLATE=ir_uob_rb_01
