# Copy to .env and fill secrets. Defaults live in config/index.js.

# --- Server ---
PORT=5000
NODE_ENV=development
MOCK_PAYMENTS=true
AUTO_CONFIRM_MOCK_PAYMENT=false
ADMIN_REGISTRATION_ENABLED=false
EXPOSE_OTP_IN_RESPONSE=true
BIRTHDAY_JOB_CRON_ENABLED=false
MONTHLY_CHAMPION_CRON_ENABLED=false
ENERGY_EXCHANGE_FY_CRON_ENABLED=false

# --- JWT ---
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# --- AWS ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_PUBLIC_BASE_URL=

# --- Firebase / OpenAI ---
FIREBASE_SERVICE_ACCOUNT_PATH=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- BhashSMS WhatsApp ---
BHASHSMS_USER=
BHASHSMS_PASS=
BHASHSMS_SENDER=BUZWAP
BHASHSMS_BASE_URL=http://bhashsms.com/api/sendmsgutil.php
BHASHSMS_TEMPLATE=invoice_1
BHASHSMS_TEMPLATE_PARAMS=1
BHASHSMS_DOCUMENT_URL=
BHASHSMS_DOCUMENT_FNAME=PDF File
BHASHSMS_REMINDER_TEMPLATE=general_reminder
BHASHSMS_AUTH_BASE_URL=http://bhashsms.com/api/sendmsg.php
BHASHSMS_OTP_TEMPLATE=ir_otp01
