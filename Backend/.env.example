# Local development payment flow
NODE_ENV=development
MOCK_PAYMENTS=true

# Lab report + meal photo AI analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Keep false to test create-order followed by verify-payment manually.
# Set true to mark mock consultancy orders paid during order creation.
AUTO_CONFIRM_MOCK_PAYMENT=false

# --- BhashSMS WhatsApp (sendmsgutil.php) ---
# invoice_1 is a payment-receipt DOCUMENT template only — do not use it for Admin reminds.
BHASHSMS_USER=
BHASHSMS_PASS=
BHASHSMS_SENDER=BUZWAP
BHASHSMS_BASE_URL=http://bhashsms.com/api/sendmsgutil.php
BHASHSMS_TEMPLATE=invoice_1
BHASHSMS_TEMPLATE_PARAMS=1
BHASHSMS_DOCUMENT_URL=https://bhashsms.com/pushwa/iframe/files/trai.pdf
BHASHSMS_DOCUMENT_FNAME=PDF File
# Approved UTILITY text template for Admin reminds (see body Hi {{1}}, {{2}})
BHASHSMS_REMINDER_TEMPLATE=general_reminder
# Keep false once the utility template above is approved
BHASHSMS_ALLOW_SESSION_TEXT=false
BHASHSMS_USE_MESSAGE_AS_PARAMS=false
