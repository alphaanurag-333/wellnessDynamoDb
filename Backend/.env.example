# Local development payment flow
NODE_ENV=development
MOCK_PAYMENTS=true

# Lab report AI analysis (Report & analysis → Submit to AI)
# Prefer Gemini for PDFs; OpenAI is used if Gemini is not set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Keep false to test create-order followed by verify-payment manually.
# Set true to mark mock consultancy orders paid during order creation.
AUTO_CONFIRM_MOCK_PAYMENT=false
