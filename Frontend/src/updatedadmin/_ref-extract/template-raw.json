tyle=\"flex:1;min-width:0;\"><div style=\"font-size:14px;font-weight:750;color:#16233f;\">{{ cfgVerTitle }} · version history<\u002Fdiv><div style=\"font-size:11px;color:#9aa6b8;\">Web is on {{ cfgVerWebNow }} · App is on {{ cfgVerAppNow }} — assign any version to either surface<\u002Fdiv><\u002Fdiv>\n          <button sc-camel-on-click=\"{{ closeVer }}\" style=\"width:30px;height:30px;border:none;background:#f2f5fa;border-radius:8px;color:#5a6b85;font-size:16px;cursor:pointer;\">×<\u002Fbutton>\n        <\u002Fdiv>\n        <div style=\"padding:15px 17px;display:flex;flex-direction:column;gap:10px;\">\n          <sc-for list=\"{{ cfgVerRows }}\" as=\"v\" hint-placeholder-count=\"3\">\n            <div style=\"{{ v.rowStyle }}\">\n              <div style=\"display:flex;align-items:center;gap:8px;flex-wrap:wrap;\">\n                <span style=\"font-size:11px;font-weight:800;color:#16233f;\">{{ v.id }}<\u002Fspan>\n                <span style=\"font-size:10.5px;color:#5a6b85;\">{{ v.date }}<\u002Fspan>\n                <span style=\"font-size:10px;color:#9aa6b8;\">{{ v.by }}<\u002Fspan>\n                <span style=\"{{ v.liveTag }}\">{{ v.liveLabel }}<\u002Fspan>\n                <span style=\"margin-left:auto;display:flex;gap:6px;flex-wrap:wrap;\">\n                  <button sc-camel-on-click=\"{{ v.setWeb }}\" style=\"{{ v.webStyle }}\">Web<\u002Fbutton>\n                  <button sc-camel-on-click=\"{{ v.setApp }}\" style=\"{{ v.appStyle }}\">App<\u002Fbutton>\n                  <button sc-camel-on-click=\"{{ v.setBoth }}\" style=\"{{ v.bothStyle }}\">Both<\u002Fbutton>\n                  <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ v.toggleEdit }}\" style=\"{{ v.editStyle }}\">{{ v.editLabel }}<\u002Fbutton><\u002Fsc-if>\n                <\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"display:flex;align-items:flex-start;gap:9px;\">\n                <span style=\"{{ v.surfTag }}\">{{ v.surfLabel }}<\u002Fspan>\n                <div contenteditable=\"{{ v.editAttr }}\" style=\"{{ v.bodyStyle }}\" style-focus=\"border-color:#5e6ad2;background:#fbfcff;\">{{ v.text }}<\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n        <div style=\"padding:0 17px 16px;\"><button sc-camel-on-click=\"{{ closeVer }}\" style=\"width:100%;height:40px;border-radius:10px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-weight:650;font-size:13px;cursor:pointer;\">Close<\u002Fbutton><\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsc-if>\n  <sc-if value=\"{{ myProfOpen }}\" hint-placeholder-val=\"{{ false }}\">\n    <div sc-camel-on-click=\"{{ closeMyProfile }}\" style=\"position:fixed;inset:0;z-index:97;background:rgba(16,35,63,.5);display:flex;align-items:center;justify-content:center;padding:24px;animation:fadein .18s ease both;\">\n      <div sc-camel-on-click=\"{{ cdStop }}\" style=\"width:600px;max-width:94vw;max-height:88vh;overflow-y:auto;background:#f7f9fc;border-radius:16px;box-shadow:0 30px 80px rgba(16,35,63,.44);animation:popscale .22s cubic-bezier(.2,1.1,.3,1) both;\">\n        <div style=\"display:flex;align-items:center;gap:13px;padding:16px 18px;background:#fff;border-bottom:1px solid #eef1f6;\">\n          <span style=\"width:46px;height:46px;flex:0 0 46px;border-radius:50%;background:linear-gradient(135deg,#34a56a,#7cc79a);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:750;font-size:17px;\">{{ viewAsInitial }}<\u002Fspan>\n          <div style=\"flex:1;min-width:0;\">\n            <div style=\"font-size:16px;font-weight:770;letter-spacing:-.01em;color:#16233f;\">{{ myProfName }}<\u002Fdiv>\n            <div style=\"font-size:11.5px;color:#9aa6b8;margin-top:2px;\">{{ viewAsName }} · {{ myProfEmail }}<\u002Fdiv>\n          <\u002Fdiv>\n          <button sc-camel-on-click=\"{{ closeMyProfile }}\" style=\"width:30px;height:30px;border:none;background:#f2f5fa;border-radius:8px;color:#5a6b85;font-size:16px;cursor:pointer;flex:0 0 30px;\">×<\u002Fbutton>\n        <\u002Fdiv>\n\n        <div style=\"padding:16px 18px;display:flex;flex-direction:column;gap:13px;\">\n          <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:15px 16px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n            <div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:9px;margin-bottom:11px;\">\n              <div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Your details<\u002Fdiv>\n              <span style=\"font-size:10.5px;color:#9aa6b8;\">Details are set by admin — you can change your photo<\u002Fspan>\n            <\u002Fdiv>\n            <div style=\"display:flex;gap:11px;flex-wrap:wrap;\">\n              <div style=\"flex:1 1 220px;min-width:180px;\">\n                <div style=\"font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#8a97ac;margin-bottom:5px;\">Full name<\u002Fdiv>\n                <div style=\"height:38px;display:flex;align-items:center;padding:0 12px;border:1px solid #eef1f6;border-radius:9px;background:#f7f9fc;font-size:12.5px;font-weight:650;color:#8a97ac;\">{{ myProfName }}<\u002Fdiv>\n              <\u002Fdiv>\n              <div style=\"flex:1 1 220px;min-width:180px;\">\n                <div style=\"font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#8a97ac;margin-bottom:5px;\">WhatsApp number<\u002Fdiv>\n                <div style=\"display:flex;gap:7px;\">\n                  <input value=\"{{ myProfWa }}\" sc-camel-on-input=\"{{ onMyProfWa }}\" placeholder=\"+91 00000 00000\" style=\"flex:1;min-width:0;height:38px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;color:#16233f;outline:none;font-variant-numeric:tabular-nums;\" style-focus=\"border-color:#5e6ad2;\">\n                  <sc-if value=\"{{ myProfWaChanged }}\" hint-placeholder-val=\"{{ false }}\">\n                    <button sc-camel-on-click=\"{{ sendMyProfOtp }}\" style=\"height:38px;padding:0 13px;border-radius:9px;border:none;background:#5e6ad2;color:#fff;font-weight:700;font-size:12px;cursor:pointer;flex:0 0 auto;\">Send OTP<\u002Fbutton>\n                  <\u002Fsc-if>\n                <\u002Fdiv>\n                <sc-if value=\"{{ myProfWaUnchanged }}\" hint-placeholder-val=\"{{ true }}\">\n                  <div style=\"font-size:10.5px;color:#9aa6b8;margin-top:5px;\">Verified · a new number needs an OTP before it replaces this one.<\u002Fdiv>\n                <\u002Fsc-if>\n                <sc-if value=\"{{ myProfOtpSent }}\" hint-placeholder-val=\"{{ false }}\">\n                  <div style=\"background:#fdf9ee;border:1px solid #f2e2a8;border-radius:10px;padding:11px 12px;margin-top:8px;\">\n                    <div style=\"font-size:11.5px;color:#9a7a00;margin-bottom:8px;\">Enter the 6-digit code sent on WhatsApp to {{ myProfOtpTo }}<\u002Fdiv>\n                    <div style=\"display:flex;gap:7px;\">\n                      <input value=\"{{ myProfOtp }}\" sc-camel-on-input=\"{{ onMyProfOtp }}\" placeholder=\"000000\" style=\"flex:1;min-width:0;height:38px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:14px;font-weight:700;letter-spacing:.22em;color:#16233f;outline:none;font-variant-numeric:tabular-nums;\" style-focus=\"border-color:#5e6ad2;\">\n                      <button sc-camel-on-click=\"{{ verifyMyProfOtp }}\" style=\"{{ myProfVerifyStyle }}\">Verify<\u002Fbutton>\n                    <\u002Fdiv>\n                    <div style=\"display:flex;gap:12px;margin-top:8px;\">\n                      <button sc-camel-on-click=\"{{ resendMyProfOtp }}\" style=\"border:none;background:transparent;padding:0;color:#5e6ad2;font-weight:700;font-size:11px;cursor:pointer;font-family:inherit;\">Resend code<\u002Fbutton>\n                      <button sc-camel-on-click=\"{{ cancelMyProfOtp }}\" style=\"border:none;background:transparent;padding:0;color:#8a97ac;font-weight:650;font-size:11px;cursor:pointer;font-family:inherit;\">Cancel<\u002Fbutton>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-if>\n              <\u002Fdiv>\n              <div style=\"flex:1 1 220px;min-width:180px;\">\n                <div style=\"font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#8a97ac;margin-bottom:5px;\">Work email<\u002Fdiv>\n                <div style=\"height:38px;display:flex;align-items:center;padding:0 12px;border:1px solid #eef1f6;border-radius:9px;background:#f7f9fc;font-size:12.5px;color:#8a97ac;\">{{ myProfEmail }}<\u002Fdiv>\n              <\u002Fdiv>\n              <div style=\"flex:1 1 220px;min-width:180px;\">\n                <div style=\"font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#8a97ac;margin-bottom:5px;\">Role<\u002Fdiv>\n                <div style=\"height:38px;display:flex;align-items:center;gap:5px;padding:0 12px;border:1px solid #eef1f6;border-radius:9px;background:#f7f9fc;font-size:12.5px;color:#8a97ac;\"><span>{{ viewAsName }}<\u002Fspan><span>· set by admin<\u002Fspan><\u002Fdiv>\n              <\u002Fdiv>\n              <div style=\"flex:1 1 100%;\">\n                <div style=\"font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#8a97ac;margin-bottom:5px;\">Address<\u002Fdiv>\n                <div style=\"min-height:38px;display:flex;align-items:center;padding:9px 12px;border:1px solid #eef1f6;border-radius:9px;background:#f7f9fc;font-size:12.5px;color:#8a97ac;line-height:1.45;\">{{ myProfAddr }}<\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n            <div style=\"display:flex;align-items:center;gap:11px;margin-top:12px;padding-top:12px;border-top:1px solid #f4f6fa;\">\n              <span style=\"width:52px;height:52px;flex:0 0 52px;border-radius:50%;backgrou