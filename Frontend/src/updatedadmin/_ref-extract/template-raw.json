;line-height:1;padding:0 2px;\" style-hover=\"color:#c0392b;\">×<\u002Fbutton>\n                      <\u002Fspan>\n                    <\u002Fsc-if>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsLogo }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:3px;\">Logo slots<\u002Fdiv>\n              <div style=\"font-size:11.5px;color:#9aa6b8;margin-bottom:12px;\">Upload a variant for each placement — the header, footer, browser tab and app launcher.<\u002Fdiv>\n              <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;\">\n                <sc-for list=\"{{ cfgLogoSlots }}\" as=\"l\" hint-placeholder-count=\"4\">\n                  <div style=\"background:#fbfcfe;border:1px solid #eef1f6;border-radius:12px;padding:12px 13px;\">\n                    <div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-bottom:9px;\">\n                      <div><div style=\"font-size:12px;font-weight:700;color:#16233f;\">{{ l.name }}<\u002Fdiv><div style=\"font-size:10.5px;color:#9aa6b8;\">{{ l.note }}<\u002Fdiv><\u002Fdiv>\n                      <span style=\"font-size:10px;font-weight:700;color:#5e6ad2;background:#eef0fc;border:1px solid #dcdff7;border-radius:5px;padding:2px 7px;white-space:nowrap;\">{{ l.size }}<\u002Fspan>\n                    <\u002Fdiv>\n                    <div style=\"{{ l.frame }}\"><span style=\"font-size:16px;\">🏷️<\u002Fspan><button sc-camel-on-click=\"{{ upLogo }}\" style=\"height:27px;padding:0 12px;border-radius:8px;border:1px solid #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:10.5px;cursor:pointer;\">Upload<\u002Fbutton><\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsLocation }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:11px;flex-wrap:wrap;\">\n                <div><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Locations<\u002Fdiv><div style=\"font-size:11.5px;color:#9aa6b8;margin-top:2px;\">Shown on the contact page and in the footer.<\u002Fdiv><\u002Fdiv>\n                <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ openLocForm }}\" style=\"height:34px;padding:0 14px;border-radius:9px;border:1px dashed #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:12px;cursor:pointer;\">+ Add location<\u002Fbutton><\u002Fsc-if>\n              <\u002Fdiv>\n              <sc-if value=\"{{ locFormOpen }}\" hint-placeholder-val=\"{{ false }}\">\n                <div style=\"background:#fff;border:1.5px solid #dcdff7;border-radius:12px;padding:12px 13px;margin-bottom:10px;box-shadow:0 4px 14px rgba(94,106,210,.12);\">\n                  <div style=\"display:flex;align-items:center;gap:9px;margin-bottom:10px;\">\n                    <span style=\"font-size:13px;\">📍<\u002Fspan>\n                    <div style=\"flex:1;min-width:0;font-size:12px;font-weight:750;color:#16233f;\">New location<\u002Fdiv>\n                    <button sc-camel-on-click=\"{{ closeLocForm }}\" style=\"width:24px;height:24px;border:none;background:#f2f5fa;border-radius:7px;color:#5a6b85;font-size:13px;cursor:pointer;\">×<\u002Fbutton>\n                  <\u002Fdiv>\n                  <div style=\"display:grid;grid-template-columns:1fr 1.6fr auto;gap:8px;align-items:center;\">\n                    <input value=\"{{ locName }}\" sc-camel-on-input=\"{{ onLocName }}\" placeholder=\"Name · e.g. Wellness studio · Delhi\" style=\"height:36px;padding:0 11px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;color:#16233f;outline:none;\" style-focus=\"border-color:#5e6ad2;\">\n                    <input value=\"{{ locAddr }}\" sc-camel-on-input=\"{{ onLocAddr }}\" placeholder=\"Full address\" style=\"height:36px;padding:0 11px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;color:#5a6b85;outline:none;\" style-focus=\"border-color:#5e6ad2;\">\n                    <button sc-camel-on-click=\"{{ saveLoc }}\" style=\"height:36px;padding:0 15px;border-radius:9px;border:none;background:#5e6ad2;color:#fff;font-weight:700;font-size:12.5px;cursor:pointer;white-space:nowrap;\">Add location<\u002Fbutton>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-if>\n              <div style=\"display:flex;flex-direction:column;gap:8px;\">\n                <sc-for list=\"{{ cfgLocRows }}\" as=\"l\" hint-placeholder-count=\"3\">\n                  <div style=\"{{ l.rowStyle }}\">\n                    <span style=\"font-size:14px;margin-top:1px;\">📍<\u002Fspan>\n                    <div style=\"flex:1;min-width:0;\">\n                      <div contenteditable=\"{{ l.editAttr }}\" style=\"{{ l.nameStyle }}\" style-focus=\"border-color:#5e6ad2;background:#fff;\">{{ l.k }}<\u002Fdiv>\n                      <div contenteditable=\"{{ l.editAttr }}\" style=\"{{ l.addrStyle }}\" style-focus=\"border-color:#5e6ad2;background:#fff;\">{{ l.v }}<\u002Fdiv>\n                    <\u002Fdiv>\n                    <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\">\n                      <span style=\"display:flex;align-items:center;gap:6px;flex:0 0 auto;margin-top:1px;\">\n                        <span style=\"{{ l.statusStyle }}\">{{ l.statusLabel }}<\u002Fspan>\n                        <button sc-camel-on-click=\"{{ l.toggleOn }}\" title=\"Show or hide this address\" style=\"{{ l.sw }}\"><span style=\"{{ l.knob }}\"><\u002Fspan><\u002Fbutton>\n                        <button sc-camel-on-click=\"{{ l.toggleEdit }}\" style=\"{{ l.btnStyle }}\">{{ l.btnLabel }}<\u002Fbutton>\n                        <button sc-camel-on-click=\"{{ l.remove }}\" title=\"Remove\" style=\"border:none;background:transparent;color:#c7ccd6;cursor:pointer;font-size:14px;line-height:1;padding:0 2px;\" style-hover=\"color:#c0392b;\">×<\u002Fbutton>\n                      <\u002Fspan>\n                    <\u002Fsc-if>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n          <sc-if value=\"{{ cfgIsSocial }}\" hint-placeholder-val=\"{{ false }}\">\n            <sc-if value=\"{{ socFormOpen }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"background:#fff;border:1.5px solid #dcdff7;border-radius:13px;padding:14px 15px;margin-bottom:12px;box-shadow:0 4px 14px rgba(94,106,210,.12);\">\n                <div style=\"display:flex;align-items:center;gap:9px;margin-bottom:11px;\">\n                  <span style=\"font-size:14px;\">✦<\u002Fspan>\n                  <div style=\"flex:1;min-width:0;\"><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">New stat<\u002Fdiv><div style=\"font-size:11px;color:#9aa6b8;margin-top:1px;\">Give it a label and a value — you can set where it is live after adding.<\u002Fdiv><\u002Fdiv>\n                  <button sc-camel-on-click=\"{{ closeSocForm }}\" style=\"width:26px;height:26px;border:none;background:#f2f5fa;border-radius:7px;color:#5a6b85;font-size:14px;cursor:pointer;\">×<\u002Fbutton>\n                <\u002Fdiv>\n                <div style=\"display:grid;grid-template-columns:1.6fr 1fr auto;gap:8px;align-items:center;\">\n                  <input value=\"{{ socLabel }}\" sc-camel-on-input=\"{{ onSocLabel }}\" placeholder=\"Label · e.g. Facebook followers\" style=\"height:38px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;color:#16233f;outline:none;\" style-focus=\"border-color:#5e6ad2;\">\n                  <input value=\"{{ socValue }}\" sc-camel-on-input=\"{{ onSocValue }}\" placeholder=\"Value · e.g. 42.1K\" style=\"height:38px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;font-weight:650;color:#16233f;outline:none;\" style-focus=\"border-color:#5e6ad2;\">\n                  <button sc-camel-on-click=\"{{ saveSocial }}\" style=\"height:38px;padding:0 16px;border-radius:9px;border:none;background:#5e6ad2;color:#fff;font-weight:700;font-size:12.5px;cursor:pointer;white-space:nowrap;\">Add stat<\u002Fbutton>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\">\n              <div style=\"display:flex;justify-content:flex-end;margin-bottom:11px;\">\n                <button sc-camel-on-click=\"{{ addSocial }}\" style=\"height:32px;padding:0 13px;border-radius:9px;border:1px dashed #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:12px;cursor:pointer;\">+ Create new stat<\u002Fbutton>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n            <div style=\"display:grid;grid-template-columns:repeat(4,1fr);gap:11px;\">\n              <sc-for list=\"{{ cfgSocial }}\" as=\"sc\" hint-placeholder-count=\"4\">\n                <div style=\"{{ sc.cardStyle }}\">\n                  <div style=\"display:flex;align-items:center;gap:7px;\">\n                    <span style=\"font-size:13px;{{ sc.accent }}\">{{ sc.icon }}<\u002Fspan>\n                    <span style=\"flex:1;min-width:0;font-size:10.5px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;color:#8a97ac;line-height:1.25;\">{{ sc.label }}<\u002Fspan>\n                    <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ sc.toggleEdit }}\" style=\"{{ sc.editStyle }}\">{{ sc.editLabel }}<\u002Fbutton><\u002Fsc-if>\n                  <\u002Fdiv>\n                  <div contenteditable=\"{{ sc.editAttr }}\" style=\"{{ sc.valStyle }}\" style-focus=\"border-color:#5e6ad2;\">{{ sc.value }}<\u002Fdiv>\n                  <div style=\"display:flex;background:#f2f5fa;border:1px solid #e6ebf2;border-radius:999px;padding:2px;gap:2px;margin-top:2px;\">\n                    <button sc-camel-on-click=\"{{ sc.setWeb }}\" style=\"{{ sc.webStyle }}\">Web<\u002Fbutton>\n                    <button sc-camel-on-click=\"{{ sc.setApp }}\" style=\"{{ sc.appStyle }}\">App<\u002Fbutton>\n                    <button sc-camel-on-click=\"{{ sc.setBoth }}\" style=\"{{ sc.bothStyle }}\">Both<\u002Fbutton>\n                  <\u002Fdiv>\n                  <div style=\"display:flex;align-items:center;gap:7px;margin-top:2px;\">\n                    <span style=\"{{ sc.statusStyle }}\">{{ sc.statusLabel }}<\u002Fspan>\n                    <button sc-camel-on-click=\"{{ sc.toggleOn }}\" title=\"Enable or disable this stat\" style=\"{{ sc.sw }}\"><span style=\"{{ sc.knob }}\"><\u002Fspan><\u002Fbutton>\n                    <sc-if value=\"{{ sc.isCustom }}\" hint-placeholder-val=\"{{ false }}\"><button sc-camel-on-click=\"{{ sc.socRemove }}\" title=\"Remove this stat\" style=\"border:none;background:transparent;color:#c7ccd6;cursor:pointer;font-size:14px;line-height:1;padding:0 2px;\" style-hover=\"color:#c0392b;\">×<\u002Fbutton><\u002Fsc-if>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsc-if>\n  <!-- DRAWER -->\n  <sc-if value=\"{{ drawerOpen }}\" hint-placeholder-val=\"{{ false }}\">\n    <div style=\"position:fixed;inset:0;background:#eef1f7;z-index:60;display:flex;flex-direction:column;animation:fadein .2s ease;\">\n      <div style=\"height:58px;flex:0 0 58px;background:#fff;border-bottom:1px solid #e6ebf2;display:flex;align-items:center;gap:14px;padding:0 22px;\">\n        <button sc-camel-on-click=\"{{ closeDrawer }}\" style=\"display:flex;align-items:center;gap:8px;height:36px;padding:0 13px;border-radius:9px;border:1px solid #e6ebf2;background:#fff;color:#16233f;font-weight:600;font-size:13px;cursor:pointer;\">← Users<\u002Fbutton>\n        <sc-if value=\"{{ drawerCanBack }}\" hint-placeholder-val=\"{{ false }}\"><button sc-camel-on-click=\"{{ goBackTab }}\" title=\"Back to previous screen\" style=\"display:flex;align-items:center;gap:6px;height:36px;padding:0 13px;border-radius:9px;border:1px solid #e6ebf2;background:#fff;color:#5e6ad2;font-weight:650;font-size:13px;cursor:pointer;\">‹ Back<\u002Fbutton><\u002Fsc-if>\n        <button sc-camel-on-click=\"{{ toggleDrawerMenu }}\" title=\"Toggle menu\" style=\"display:flex;align-items:center;gap:7px;height:36px;padding:0 12px;border-radius:9px;border:1px solid #e6ebf2;background:#fff;color:#16233f;font-weight:600;font-size:13px;cursor:pointer;\">{{ drawerMenuIcon }}<span>{{ drawerMenuLabel }}<\u002Fspan><\u002Fbutton>\n        <div style=\"font-weight:700;font-size:14px;color:#16233f;\">Client profile<\u002Fdiv>\n        <button sc-camel-on-click=\"{{ saveNow }}\" title=\"{{ saveNowTitle }}\" style=\"{{ saveNowStyleRight }}\">{{ saveNowIcon }}<\u002Fbutton>\n        <div style=\"position:relative;\">\n          <button sc-camel-on-click=\"{{ toggleCdBell }}\" title=\"Notifications\" style=\"position:relative;display:flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:10px;border:1px solid #e6ebf2;background:#fff;cursor:pointer;\">\n            <span style=\"font-size:17px;\">🔔<\u002Fspan>\n            <sc-if value=\"{{ cdHasNotifs }}\" hint-placeholder-val=\"{{ true }}\"><span style=\"position:absolute;top:-5px;right:-5px;min-width:18px;height:18px;padding:0 4px;border-radius:9px;background:#e5484d;color:#fff;font-size:10px;font-weight:750;display:flex;align-items:center;justify-content:center;border:2px solid #fff;font-variant-numeric:tabular-nums;\">{{ cdNotifCount }}<\u002Fspan><\u002Fsc-if>\n          <\u002Fbutton>\n          <sc-if value=\"{{ cdBellOpen }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"position:absolute;top:46px;right:0;width:380px;max-width:86vw;background:#fff;border:1px solid #e6ebf2;border-radius:14px;box-shadow:0 16px 40px rgba(16,35,63,.18);z-index:20;overflow:hidden;\">\n              <div style=\"display:flex;align-items:center;gap:8px;padding:14px 16px;border-bottom:1px solid #f1f4f8;\">\n                <span style=\"font-size:14px;font-weight:750;color:#16233f;\">Notifications<\u002Fspan>\n                <span style=\"font-size:11px;font-weight:700;color:#5e6ad2;background:#eef0fc;border:1px solid #dcdff7;border-radius:6px;padding:2px 8px;\">{{ cdNotifCount }}<\u002Fspan>\n                <button sc-camel-on-click=\"{{ toggleCdBell }}\" style=\"margin-left:auto;border:none;background:transparent;color:#9aa6b8;font-size:18px;line-height:1;cursor:pointer;\">×<\u002Fbutton>\n              <\u002Fdiv>\n              <div style=\"padding:12px 16px;background:#f7f8fd;border-bottom:1px solid #f1f4f8;display:flex;align-items:center;gap:11px;\">\n                <span style=\"font-size:16px;flex:0 0 auto;\">{{ cdLastAction.icon }}<\u002Fspan>\n                <div style=\"flex:1;min-width:0;\"><div style=\"font-size:10px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#5e6ad2;\">Last action<\u002Fdiv><div style=\"font-size:12.5px;font-weight:650;color:#16233f;line-height:1.35;\">{{ cdLastAction.text }}<\u002Fdiv><\u002Fdiv>\n                <span style=\"font-size:11px;color:#8a8fc0;font-weight:600;flex:0 0 auto;\">{{ cdLastAction.time }}<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"max-height:320px;overflow-y:auto;padding:4px 16px 10px;\">\n                <sc-for list=\"{{ cdNotifs }}\" as=\"n\" hint-placeholder-count=\"5\">\n                  <div style=\"display:flex;align-items:center;gap:11px;padding:11px 0;border-bottom:1px solid #f4f6fa;\">\n                    <span style=\"font-size:15px;flex:0 0 auto;\">{{ n.icon }}<\u002Fspan>\n                    <div style=\"flex:1;font-size:12.5px;color:#16233f;line-height:1.4;text-wrap:pretty;\">{{ n.text }}<\u002Fdiv>\n                    <span style=\"font-size:11px;color:#9aa6b8;font-variant-numeric:tabular-nums;flex:0 0 auto;\">{{ n.time }}<\u002Fspan>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"flex:1;overflow:hidden;display:flex;\">\n        <sc-if value=\"{{ drawerMenuOpen }}\" hint-placeholder-val=\"{{ true }}\">\n        <div style=\"width:272px;flex:0 0 272px;background:#fff;border-right:1px solid #e6ebf2;overflow-y:auto;padding:18px 14px;\">\n          <div style=\"padding:8px 6px 16px;\">\n            <div style=\"display:flex;align-items:center;gap:13px;margin-bottom:14px;\">\n              <div style=\"width:56px;height:56px;flex:0 0 56px;border-radius:50%;overflow:hidden;box-shadow:0 2px 8px rgba(16,35,63,.14);\"><image-slot id=\"client-avatar\" shape=\"circle\" style=\"width:56px;height:56px;\" placeholder=\"Photo\"><\u002Fimage-slot><\u002Fdiv>\n              <div style=\"min-width:0;flex:1;\">\n                <div style=\"font-size:16px;font-weight:730;letter-spacing:-.01em;line-height:1.25;color:#16233f;\">{{ drawerName }}<\u002Fdiv>\n                <div style=\"font-size:11.5px;color:#8a97ac;font-weight:600;margin-top:4px;\">{{ drawerCode }} · {{ drawerProgCount }} programs<\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n            <div style=\"display:flex;gap:6px;flex-wrap:wrap;align-items:center;\">\n              <sc-for list=\"{{ drawerPrograms }}\" as=\"p\" hint-placeholder-count=\"3\"><span style=\"{{ p.style }}\">{{ p.name }}<\u002Fspan><\u002Fsc-for>\n              <sc-if value=\"{{ drawerProgHasToggle }}\" hint-placeholder-val=\"{{ false }}\"><button sc-camel-on-click=\"{{ toggleDrawerProg }}\" style=\"font-size:11px;font-weight:700;color:#5e6ad2;background:#eef0fc;border:1px solid #dcdff7;border-radius:7px;padding:4px 10px;cursor:pointer;white-space:nowrap;\" style-hover=\"background:#e3e6fb;\">{{ drawerProgMore }}<\u002Fbutton><\u002Fsc-if>\n            <\u002Fdiv>\n          <\u002Fdiv>\n          <sc-if value=\"{{ planActive }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#f2fbf6;border:1px solid #bfe6cf;border-radius:10px;padding:10px 12px;margin:0 4px 16px;display:flex;align-items:center;gap:11px;\">\n              <div style=\"font-size:22px;font-weight:780;color:#2b8f5b;font-variant-numeric:tabular-nums;\">{{ planDaysLeft }}<\u002Fdiv>\n              <div style=\"font-size:11px;color:#5a6b85;font-weight:600;line-height:1.3;\">days left<br>on app subscription<\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n          <div style=\"font-size:11px;font-weight:700;letter-spacing:.06em;color:#8a97ac;text-transform:uppercase;padding:4px 10px 8px;\">Menu list<\u002Fdiv>\n          <div style=\"display:flex;flex-direction:column;gap:2px;\">\n            <sc-for list=\"{{ drawerMenu }}\" as=\"m\" hint-placeholder-count=\"5\">\n              <button sc-camel-on-click=\"{{ m.onClick }}\" style=\"{{ m.style }}\">\n                <span>{{ m.label }}<\u002Fspan>\n                <span style=\"margin-left:auto;display:flex;align-items:center;gap:6px;color:#c0c9d6;\"><sc-if value=\"{{ m.soon }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-size:9px;font-weight:700;color:#c0a24a;background:#fdf3dd;padding:2px 6px;border-radius:5px;\">SOON<\u002Fspan><\u002Fsc-if>{{ m.caret }}<\u002Fspan>\n              <\u002Fbutton>\n            <\u002Fsc-for>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <\u002Fsc-if>\n        <div style=\"flex:1;overflow-y:auto;\" data-drawer-scroll=\"1\">\n          <div style=\"{{ drawerContentWrap }}\">\n\n            <sc-if value=\"{{ mIsDashboard }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:16px;\">\n                <div>\n                  <div style=\"font-size:19px;font-weight:740;letter-spacing:-.02em;\">At a Glance<\u002Fdiv>\n                  <div style=\"font-size:12.5px;color:#8a97ac;margin-top:5px;\">{{ drawerName }} · Joined {{ cdJoinedAgo }}<\u002Fdiv>\n                <\u002Fdiv>\n                <div style=\"display:flex;align-items:center;gap:8px;flex-wrap:wrap;\">\n                  <button sc-camel-on-click=\"{{ openCdReview }}\" title=\"View review history\" style=\"display:inline-flex;align-items:center;gap:6px;font-size:11.5px;font-weight:750;color:#5e6ad2;background:#eef0fc;border:1px solid #d3d7f6;border-radius:8px;padding:5px 11px;white-space:nowrap;cursor:pointer;\" style-hover=\"background:#e3e6fb;\">⏱️ Last reviewed {{ cdLastReviewed }} ›<\u002Fbutton>\n                  <span style=\"display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;color:#2b8f5b;background:#e7f6ee;border:1px solid #cdeede;border-radius:8px;padding:5px 10px;white-space:nowrap;\">⚑ Updated {{ cdUpdated }}<\u002Fspan>\n                <\u002Fdiv>\n              <\u002Fdiv>\n\n              <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:16px;background:#f4f6fb;border:1px dashed #d5dcec;border-radius:11px;padding:8px 11px;flex-wrap:wrap;\">\n                <span style=\"font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#8a97ac;\">Preview<\u002Fspan>\n                <button sc-camel-on-click=\"{{ setCdPre }}\" style=\"{{ cdPreStyle }}\">Onboarding view<\u002Fbutton>\n                <button sc-camel-on-click=\"{{ setCdPost }}\" style=\"{{ cdPostStyle }}\">Onboarded view<\u002Fbutton>\n                <span style=\"font-size:11px;color:#9aa6b8;\">demo toggle — real dashboards switch automatically<\u002Fspan>\n              <\u002Fdiv>\n\n              <sc-if value=\"{{ cdOnbInProgress }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"display:flex;flex-wrap:wrap;gap:10px;margin-bottom:16px;\">\n                <div style=\"display:flex;align-items:center;gap:8px;background:#fff;border:1px solid #eef1f6;border-radius:10px;padding:9px 13px;\"><span style=\"font-size:15px;\">📅<\u002Fspan><div><div style=\"font-size:10.5px;color:#8a97ac;font-weight:600;text-transform:uppercase;letter-spacing:.03em;\">Joined<\u002Fdiv><div style=\"font-size:13px;font-weight:700;color:#16233f;\">{{ cdJoinedAgo }}<\u002Fdiv><\u002Fdiv><\u002Fdiv>\n                <div style=\"display:flex;align-items:center;gap:8px;background:#fff;border:1px solid #eef1f6;border-radius:10px;padding:9px 13px;\"><span style=\"font-size:15px;\">🚀<\u002Fspan><div><div style=\"font-size:10.5px;color:#8a97ac;font-weight:600;text-transform:uppercase;letter-spacing:.03em;\">Onboarding<\u002Fdiv><div style=\"font-size:13px;font-weight:700;color:#16233f;\">{{ cdOnbStatus }}<\u002Fdiv><\u002Fdiv><\u002Fdiv>\n              <\u002Fdiv>\n              <\u002Fsc-if>\n\n              <sc-if value=\"{{ cdOnbInProgress }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;margin-bottom:16px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n                <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;flex-wrap:wrap;\">\n                  <div style=\"display:flex;align-items:center;gap:8px;\"><span style=\"font-size:15px;\">🧭<\u002Fspan><div style=\"font-size:13px;font-weight:700;color:#16233f;\">Onboarding status<\u002Fdiv><\u002Fdiv>\n                  <div style=\"display:flex;align-items:center;gap:10px;\">\n                    <span style=\"font-size:12px;font-weight:750;color:#2b8f5b;font-variant-numeric:tabular-nums;\">{{ cdOnbDoneCount }} / {{ cdOnbTotal }} done<\u002Fspan>\n                    <sc-if value=\"{{ cdHasNext }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ cdRemind }}\" style=\"display:flex;align-items:center;gap:6px;height:32px;padding:0 13px;border-radius:9px;border:1px solid #dcdff7;background:#eef0fc;color:#5e6ad2;font-weight:650;font-size:12px;cursor:pointer;\" style-hover=\"background:#e3e6fb;\">🔔 Remind<\u002Fbutton><\u002Fsc-if>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n                <sc-if value=\"{{ cdHasNext }}\" hint-placeholder-val=\"{{ true }}\">\n                  <div style=\"display:flex;align-items:center;gap:8px;background:#f7f8fd;border:1px solid #e6e8fb;border-radius:9px;padding:9px 12px;margin-bottom:14px;\">\n                    <span style=\"font-size:10px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:#5e6ad2;\">Next step<\u002Fspan>\n                    <span style=\"font-size:12.5px;font-weight:650;color:#16233f;\">{{ cdNextStep }}<\u002Fspan>\n                  <\u002Fdiv>\n                <\u002Fsc-if>\n                <div style=\"display:flex;align-items:center;margin:6px 0 10px;\">\n                  <sc-for list=\"{{ cdOnbSegs }}\" as=\"g\" hint-placeholder-count=\"11\">\n                    <div style=\"{{ g.wrapStyle }}\">\n                      <sc-if value=\"{{ g.hasBar }}\" hint-placeholder-val=\"{{ true }}\"><span style=\"{{ g.barStyle }}\"><\u002Fspan><\u002Fsc-if>\n                      <span sc-camel-on-mouse-enter=\"{{ g.enter }}\" sc-camel-on-mouse-leave=\"{{ g.leave }}\" style=\"{{ g.dotStyle }}\">{{ g.mark }}\n                        <sc-if value=\"{{ g.hovered }}\" hint-placeholder-val=\"{{ false }}\">\n                          <span style=\"{{ g.tipStyle }}\">{{ g.title }}<\u002Fspan>\n                        <\u002Fsc-if>\n                      <\u002Fspan>\n                    <\u002Fdiv>\n                  <\u002Fsc-for>\n                <\u002Fdiv>\n                <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;\">\n                  <span style=\"font-size:11px;color:#9aa6b8;\">{{ cdOnbStepNow }}<\u002Fspan>\n                  <span style=\"font-size:11px;font-weight:700;color:#2b8f5b;font-variant-numeric:tabular-nums;\">{{ cdOnbPct }}%<\u002Fspan>\n                <\u002Fdiv>\n                <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:8px 16px;\">\n                  <sc-for list=\"{{ cdOnbSteps }}\" as=\"o\" hint-placeholder-count=\"10\">\n                    <div style=\"display:flex;align-items:center;gap:10px;padding:4px 0;min-width:0;\">\n                      <button sc-camel-on-click=\"{{ o.toggle }}\" title=\"{{ o.toggleTitle }}\" style=\"{{ o.boxStyle }}\">{{ o.tick }}<\u002Fbutton>\n                      <div sc-camel-on-click=\"{{ o.toggle }}\" style=\"{{ o.textWrapStyle }}\">\n                        <span style=\"{{ o.labelStyle }}\">{{ o.num }}. {{ o.label }}<\u002Fspan>\n                        <sc-if value=\"{{ o.hasNote }}\" hint-placeholder-val=\"{{ false }}\">\n                          <div style=\"font-size:10.5px;color:#2b8f5b;margin-top:1px;\">{{ o.note }}<\u002Fdiv>\n                        <\u002Fsc-if>\n                      <\u002Fdiv>\n                      <sc-if value=\"{{ o.hasAction }}\" hint-placeholder-val=\"{{ false }}\">\n                        <button sc-camel-on-click=\"{{ o.action }}\" style=\"{{ o.actionStyle }}\">{{ o.actionLabel }}<\u002Fbutton>\n                      <\u002Fsc-if>\n                    <\u002Fdiv>\n                  <\u002Fsc-for>\n                <\u002Fdiv>\n                <div style=\"font-size:11px;color:#9aa6b8;margin-top:12px;\">{{ cdOnbFootNote }}<\u002Fdiv>\n              