                 <button sc-camel-on-click=\"{{ upOvVideo }}\" style=\"height:34px;padding:0 14px;border-radius:9px;border:none;background:#5e6ad2;color:#fff;font-weight:700;font-size:12px;cursor:pointer;\">{{ ovVideoBtn }}<\u002Fbutton>\n                      <button sc-camel-on-click=\"{{ setOvLink }}\" style=\"height:34px;padding:0 13px;border-radius:9px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-weight:700;font-size:12px;cursor:pointer;\">{{ ovLinkLabel }}<\u002Fbutton>\n                      <button sc-camel-on-click=\"{{ saveOv }}\" style=\"height:34px;padding:0 13px;border-radius:9px;border:1px solid #e6ebf2;background:#fff;color:#5e6ad2;font-weight:700;font-size:12px;cursor:pointer;\">Save<\u002Fbutton>\n                      <sc-if value=\"{{ ovCanGallery }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ saveOvToGallery }}\" title=\"Keep this cover in the Gallery for reuse\" style=\"{{ ovGalStyle }}\">{{ ovGalLabel }}<\u002Fbutton><\u002Fsc-if>\n                      <span style=\"display:flex;align-items:center;gap:7px;margin-left:auto;\">\n                        <span style=\"font-size:11px;font-weight:700;color:#8a97ac;\">{{ ovLiveLabel }}<\u002Fspan>\n                        <button sc-camel-on-click=\"{{ toggleOvLive }}\" title=\"Publish to this coach's clients\" style=\"{{ ovSw }}\"><span style=\"{{ ovKnob }}\"><\u002Fspan><\u002Fbutton>\n                      <\u002Fspan>\n                    <\u002Fdiv>\n                  <\u002Fsc-if>\n                  <div style=\"font-size:11px;color:#8a97ac;line-height:1.55;\">{{ ovDeliveryNote }}<\u002Fdiv>\n                  <div style=\"font-size:11px;color:#8a97ac;\">{{ ovSourceNote }}<\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n              <sc-if value=\"{{ ovCanGallery }}\" hint-placeholder-val=\"{{ true }}\">\n                <div style=\"margin-top:14px;padding-top:13px;border-top:1px solid #f1f4f9;\">\n                  <div style=\"disp