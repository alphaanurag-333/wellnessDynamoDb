x;background:#f1f4f8;\"><\u002Fdiv>\n                  <div class=\"metcol\" style=\"flex:1;padding:11px 8px;text-align:center;transition:background .15s ease;\" style-hover=\"background:#f7f8fd;\"><div style=\"font-size:9.5px;color:#8a97ac;font-weight:700;text-transform:uppercase;letter-spacing:.03em;margin-bottom:5px;\">Weight<\u002Fdiv><div style=\"font-size:15px;font-weight:780;color:#16233f;font-variant-numeric:tabular-nums;line-height:1.05;\">{{ cdMetab.weight }}<\u002Fdiv><\u002Fdiv>\n                  <div style=\"width:1px;background:#f1f4f8;\"><\u002Fdiv>\n                  <div class=\"metcol\" style=\"flex:1;padding:11px 8px;text-align:center;transition:background .15s ease;\" style-hover=\"background:#f7f8fd;\"><div style=\"font-size:9.5px;color:#8a97ac;font-weight:700;text-transform:uppercase;letter-spacing:.03em;margin-bottom:5px;\">BMR<\u002Fdiv><div style=\"font-size:15px;font-weight:780;color:#5e6ad2;font-variant-numeric:tabular-nums;line-height:1.05;\">{{ cdMetab.bmr }}<\u002Fdiv><\u002Fdiv>\n                  <div style=\"width:1px;background:#f1f4f8;\"><\u002Fdiv>\n                  <div class=\"metcol\" style=\"flex:1;padding:11px 8px;text-align:center;transition:background .15s ease;\" style-hover=\"background:#f7f8fd;\"><div style=\"font-size:9.5px;color:#8a97ac;font-weight:700;text-transform:uppercase;letter-spacing:.03em;margin-bottom:5px;\">TDEE<\u002Fdiv><div style=\"font-size:15px;font-weight:780;color:#0d9488;font-variant-numeric:tabular-nums;line-height:1.05;\">{{ cdMetab.tdee }}<\u002Fdiv><\u002Fdiv>\n                  <div style=\"width:1px;background:#f1f4f8;\"><\u002Fdiv>\n                  <div class=\"metcol\" style=\"flex:1;padding:11px 8px;text-align:center;transition:background .15s ease;\" style-hover=\"background:#f7f8fd;\"><div style=\"font-size:9.5px;color:#8a97ac;font-weight:700;text-transform:uppercase;letter-spacing:.03em;margin-bottom:5px;\">Body fat<\u002Fdiv><div style=\"font-size:15px;font-weight:780;color:#b8860b;font-variant-numeric:tabular-nums;line-height:1.05;\">{{ cdMetab.bf }}<\u002Fdiv><\u002Fdiv>\n                  <div style=\"width:1px;background:#f1f4f8;\"><\u002Fdiv>\n                  <div class=\"metcol\" style=\"flex:1;padding:11px 8px;text-align:center;transition:background .15s ease;\" style-hover=\"background:#f7f8fd;\"><div style=\"font-size:9.5px;color:#8a97ac;font-weight:700;text-transform:uppercase;letter-spacing:.03em;margin-bottom:5px;\">Lean mass<\u002Fdiv><div style=\"font-size:15px;font-weight:780;color:#2b8f5b;font-variant-numeric:tabular-nums;line-height:1.05;\">{{ cdMetab.lean }}<\u002Fdiv><\u002Fdiv>\n                  <div style=\"width:1px;background:#f1f4f8;\"><\u002Fdiv>\n                  <div class=\"metcol\" style=\"flex:1;padding:11px 8px;text-align:center;transition:background .15s ease;\" style-hover=\"background:#f7f8fd;\"><div style=\"font-size:9.5px;color:#8a97ac;font-weight:700;text-transform:uppercase;letter-spacing:.03em;margin-bottom:5px;\">Visceral<\u002Fdiv><div style=\"font-size:15px;font-weight:780;font-variant-numeric:tabular-nums;line-height:1.05;{{ cdMetab.viscCol }}\">{{ cdMetab.visc }}<\u002Fdiv><\u002Fdiv>\n                <\u002Fdiv>\n              <div style=\"display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;\">\n                <sc-for list=\"{{ cdTargets }}\" as=\"t\" hint-placeholder-count=\"2\">\n                  <button sc-camel-on-click=\"{{ t.go }}\" style=\"{{ t.soft }}\" class=\"cdact\" style-hover=\"filter:brightness(.98);\">\n                    <span style=\"display:flex;align-items:center;gap:9px;padding:2px 2px;\">\n                      <span style=\"display:flex;flex-direction:column;align-items:flex-start;gap:1px;\">\n                        <span style=\"font-size:9.5px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:#8a97ac;\">{{ t.label }} target<\u002Fspan>\n                        <span style=\"font-size:14px;font-weight:780;font-variant-numeric:tabular-nums;{{ t.accent }}\">{{ t.val }}<\u002Fspan>\n                        <span style=\"font-size:9.5px;color:#9aa6b8;font-weight:600;\">{{ t.by }}<\u002Fspan>\n                      <\u002Fspan>\n                    <\u002Fspan>\n                  <\u002Fbutton>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n              <div style=\"display:flex;align-items:stretch;gap:12px;background:linear-gradient(120deg,#eef0fe 0%,#f3faf7 55%,#fdf6ec 100%);border:1px solid #e0e3f7;border-radius:16px;padding:7px 12px;margin-bottom:16px;box-shadow:0 8px 26px rgba(94,106,210,.12);flex-wrap:nowrap;animation:risein .4s ease both;\">\n                <div style=\"flex:1.5 1 140px;display:flex;align-items:center;justify-content:space-around;gap:12px;\">\n                  <button sc-camel-on-click=\"{{ goLaunchLifestyle }}\" title=\"Open LAUNCH — lifestyle score history\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;background:transparent;border:none;padding:2px 4px;cursor:pointer;font-family:inherit;border-radius:10px;\" style-hover=\"background:rgba(94,106,210,.08);\">\n                    <div style=\"font-size:9.5px;color:#8a97ac;font-weight:700;text-transform:uppercase;letter-spacing:.05em;\">Lifestyle<\u002Fdiv>\n                    <div style=\"{{ cdLifeRing }}\" class=\"cdlifering\"><div style=\"width:40px;height:40px;border-radius:50%;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 2px 6px rgba(16,35,63,.12);\"><span style=\"font-size:16px;font-weight:800;color:#5e6ad2;font-variant-numeric:tabular-nums;line-height:1;\">{{ cdLifeScore }}<\u002Fspan><\u002Fdiv><\u002Fdiv>\n                    <div style=\"font-size:8.5px;font-weight:700;color:#5e6ad2;letter-spacing:.02em;\">History ›<\u002Fdiv>\n                  <\u002Fbutton>\n                  <button sc-camel-on-click=\"{{ goLaunchPrakriti }}\" title=\"Open LAUNCH — Prakriti type history\" style=\"display:flex;flex-direction:column;align-items:center;gap:4px;background:transparent;border:none;padding:2px 4px;cursor:pointer;font-family:inherit;border-radius:10px;\" style-hover=\"background:rgba(109,79,208,.08);\">\n                    <div style=\"font-size:9.5px;color:#8a97ac;font-weight:700;text-transform:uppercase;letter-spacing:.05em;\">Prakriti<\u002Fdiv>\n                    <span class=\"prakchip\" style=\"display:inline-flex;align-items:center;gap:5px;font-size:13px;font-weight:700;color:#6d4fd0;background:#f0ecfd;border:1px solid #ddd3f9;border-radius:999px;padding:8px 14px;\"><span class=\"prakemoji\">🧘<\u002Fspan> {{ cdPrakriti }}<\u002Fspan>\n                    <div style=\"font-size:8.5px;font-weight:700;color:#6d4fd0;letter-spacing:.02em;\">History ›<\u002Fdiv>\n                  <\u002Fbutton>\n                <\u002Fdiv>\n                <div style=\"flex:1.15 1 130px;display:flex;align-items:stretch;background:#fff;border:1px solid #eef1f6;border-radius:12px;padding:4px 4px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n                  <button sc-camel-on-click=\"{{ cdGoReflection }}\" class=\"herostat\" style=\"flex:1;padding:4px 8px;text-align:center;display:flex;flex-direction:column;justify-content:center;background:transparent;border:none;cursor:pointer;font:inherit;border-radius:8px;transition:background .15s ease;\" style-hover=\"background:#f5f6fe;\"><div style=\"font-size:9.5px;color:#8a97ac;font-weight:600;text-transform:uppercase;letter-spacing:.03em;margin-bottom:4px;\">Daily<\u002Fdiv><div style=\"font-size:16px;font-weight:780;letter-spacing:-.02em;color:#5e6ad2;font-variant-numeric:tabular-nums;line-height:1;\">{{ cdDaily }}<span style=\"font-size:11px;color:#9aa6b8;font-weight:600;\"> /100<\u002Fspan><\u002Fdiv><div style=\"font-size:9px;color:#9aa6b8;font-weight:600;margin-top:3px;\">from DRF ›<\u002Fdiv><\u002Fbutton>\n                  <div style=\"width:1px;background:#f1f4f8;\"><\u002Fdiv>\n                  <button sc-camel-on-click=\"{{ cdCelebrate }}\" class=\"herostat\" style=\"flex:1;padding:4px 8px;text-align:center;display:flex;flex-direction:column;justify-content:center;background:transparent;border:none;cursor:pointer;font:inherit;border-radius:8px;transition:background .15s ease;\" style-hover=\"background:#f0fbf7;\"><div style=\"font-size:9.5px;color:#8a97ac;font-weight:600;text-transform:uppercase;letter-spacing:.03em;margin-bottom:4px;\">Monthly<\u002Fdiv><div style=\"font-size:16px;font-weight:780;letter-spacing:-.02em;color:#0d9488;font-variant-numeric:tabular-nums;line-height:1;\">{{ cdMonthly }}<\u002Fdiv><div style=\"font-size:9px;color:#1f7a4d;font-weight:700;margin-top:3px;\">{{ cdMonthlyDelta }}<\u002Fdiv><\u002Fbutton>\n                <\u002Fdiv>\n                <div style=\"flex:5 1 0;min-width:0;display:flex;flex-direction:column;background:linear-gradient(135deg,#fff 0%,#fbfcff 100%);border:1.5px solid #dfe3f7;border-radius:12px;padding:6px 11px;box-shadow:0 3px 12px rgba(94,106,210,.1);\">\n                  <div style=\"display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:5px;\">\n                    <div style=\"font-size:10px;color:#5e6ad2;font-weight:800;text-transform:uppercase;letter-spacing:.06em;white-space:nowrap;\">Health progress<\u002Fdiv>\n                    <sc-if value=\"{{ cdProgHasMany }}\" hint-placeholder-val=\"{{ false }}\">\n                      <div style=\"display:flex;align-items:center;gap:5px;flex:0 0 auto;\">\n                        <button sc-camel-on-click=\"{{ cdProgPrev }}\" title=\"Previous program\" style=\"width:20px;height:20px;border-radius:50%;border:none;background:#eef0fc;color:#5e6ad2;font-size:12px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .15s ease;\" style-hover=\"background:#dfe3f7;\">‹<\u002Fbutton>\n                        <div style=\"display:flex;align-items:center;gap:3px;\">\n                          <sc-for list=\"{{ cdProgDots }}\" as=\"d\" hint-placeho