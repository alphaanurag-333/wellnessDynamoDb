02Fdiv>\n        <span style=\"font-size:10.5px;color:#9aa6b8;white-space:nowrap;\">{{ cfgArtNote }}<\u002Fspan>\n        <sc-raw-select value=\"{{ cfgRole }}\" sc-camel-on-change=\"{{ setCfgRole }}\" title=\"Preview this page as a role\" style=\"display:none;height:34px;padding:0 24px 0 10px;border:1px solid #e6ebf2;border-radius:9px;background:#f6f8fb;font-size:11.5px;font-weight:650;color:#5a6b85;cursor:pointer;outline:none;flex:0 0 auto;\">\n          <option value=\"admin\">As Admin<\u002Foption>\n          <option value=\"wc\">As Wellness Coach<\u002Foption>\n          <option value=\"awc\">As Assistant WC<\u002Foption>\n          <option value=\"support\">As Support<\u002Foption>\n        <\u002Fsc-raw-select>\n        <button sc-camel-on-click=\"{{ previewCfg }}\" style=\"height:34px;padding:0 13px;border-radius:9px;border:1px solid #dcdff7;background:#eef0fc;color:#5e6ad2;font-weight:700;font-size:12px;cursor:pointer;\">Preview<\u002Fbutton>\n        <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ publishCfg }}\" style=\"height:34px;padding:0 15px;border-radius:9px;border:none;background:#5e6ad2;color:#fff;font-weight:700;font-size:12px;cursor:pointer;\">Publish<\u002Fbutton><\u002Fsc-if>\n      <\u002Fdiv>\n      <div style=\"flex:1;overflow-y:auto;\">\n        <div style=\"max-width:960px;margin:0 auto;padding:22px 26px 60px;\">\n\n          <sc-if value=\"{{ cfgIsFeatures }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"font-size:12.5px;color:#8a97ac;margin-bottom:12px;text-wrap:pretty;\">Feature-flag manager. Toggle availability per platform and track rollout. <b>Admin-only edit.<\u002Fb><\u002Fdiv>\n          <div style=\"background:#fff;border:1px solid #e6ebf2;border-radius:12px;overflow:hidden;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n            <div style=\"display:grid;grid-template-columns:2.4fr 1fr 1.2fr 80px;gap:12px;padding:13px 22px;background:#f7f9fc;border-bottom:1px solid #eef1f6;font-size:11px;font-weight:700;letter-spacing:.05em;color:#8a97ac;text-transform:uppercase;\"><div>Feature<\u002Fdiv><div>Target<\u002Fdiv><div>Rollout<\u002Fdiv><div style=\"text-align:right;\">State<\u002Fdiv><\u002Fdiv>\n            <sc-for list=\"{{ flags }}\" as=\"f\" hint-placeholder-count=\"6\">\n              <div style=\"display:grid;grid-template-columns:2.4fr 1fr 1.2fr 80px;gap:12px;padding:16px 22px;border-bottom:1px solid #f1f4f9;align-items:center;\">\n                <div><div style=\"font-size:13.5px;font-weight:640;\">{{ f.name }}<\u002Fdiv><div style=\"font-size:12px;color:#8a97ac;margin-top:2px;\">{{ f.desc }}<\u002Fdiv><\u002Fdiv>\n                <div><span style=\"{{ f.targetStyle }}\">{{ f.target }}<\u002Fspan><\u002Fdiv>\n                <div><div style=\"display:flex;align-items:center;gap:9px;\"><div style=\"flex:1;height:6px;background:#eef1f6;border-radius:4px;overflow:hidden;\"><div style=\"{{ f.barStyle }}\"><\u002Fdiv><\u002Fdiv><span style=\"font-size:11.5px;color:#8a97ac;font-variant-numeric:tabular-nums;width:34px;\">{{ f.rollout }}<\u002Fspan><\u002Fdiv><\u002Fdiv>\n                <div style=\"display:flex;justify-content:flex-end;\"><button sc-camel-on-click=\"{{ f.toggle }}\" style=\"{{ f.switch }}\"><span style=\"{{ f.knob }}\"><\u002Fspan><\u002Fbutton><\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-for>\n          <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgReadOnly }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"display:flex;align-items:center;gap:9px;background:#fbf3df;border:1px solid #f2e2a8;border-radius:11px;padding:10px 14px;margin-bottom:16px;\">\n              <span style=\"font-size:14px;\">🔒<\u002Fspan><span style=\"font-size:12px;font-weight:650;color:#8a6d00;\">{{ cfgRoleNote }}<\u002Fspan>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgHasSurfSwitches }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:14px 16px;margin-bottom:14px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;\">\n                <div><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Where this is live<\u002Fdiv><div style=\"font-size:11.5px;color:#9aa6b8;margin-top:2px;\">Turn it on for the app, the website, or both.<\u002Fdiv><\u002Fdiv>\n                <div style=\"display:flex;gap:9px;flex-wrap:wrap;\">\n                  <sc-for list=\"{{ cfgSurfSwitches }}\" as=\"sw\" hint-placeholder-count=\"2\">\n                    <div style=\"{{ sw.rowStyle }}\">\n                      <span style=\"{{ sw.nameStyle }}\">{{ sw.label }}<\u002Fspan>\n                      <span style=\"{{ sw.statusStyle }}\">{{ sw.statusLabel }}<\u002Fspan>\n                      <button sc-camel-on-click=\"{{ sw.toggle }}\" style=\"{{ sw.sw }}\"><span style=\"{{ sw.knob }}\"><\u002Fspan><\u002Fbutton>\n                    <\u002Fdiv>\n                  <\u002Fsc-for>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:14px 16px;margin-bottom:14px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n            <div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin-bottom:10px;flex-wrap:wrap;\">\n              <div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">{{ cfgTitle }}<\u002Fdiv>\n              <span style=\"font-size:10.5px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;color:#8a97ac;\">{{ cfgGroupName }}<\u002Fspan>\n            <\u002Fdiv>\n            <div style=\"display:flex;gap:10px;flex-wrap:wrap;\">\n              <sc-for list=\"{{ cfgAbout }}\" as=\"ab\" hint-placeholder-count=\"3\">\n                <div style=\"flex:1 1 150px;min-width:0;background:#fbfcfe;border:1px solid #eef1f6;border-radius:10px;padding:9px 11px;\">\n                  <div style=\"font-size:9.5px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#9aa6b8;\">{{ ab.k }}<\u002Fdiv>\n                  <div style=\"font-size:12px;font-weight:650;color:#16233f;margin-top:2px;text-wrap:pretty;\">{{ ab.v }}<\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fdiv>\n\n          <sc-if value=\"{{ cfgIsBanner }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"display:grid;grid-template-columns:1.25fr 1fr;gap:14px;\">\n              <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n                <div style=\"margin-bottom:13px;\">\n                  <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:7px;\">Banner type<\u002Fdiv>\n                  <sc-raw-select value=\"{{ cfgBType }}\" sc-camel-on-change=\"{{ setCfgBType }}\" disabled=\"{{ cfgReadOnly }}\" style=\"{{ cfgSelectStyle }}\">\n                    <sc-for list=\"{{ cfgBTypeOpts }}\" as=\"o\" hint-placeholder-count=\"5\"><option value=\"{{ o.id }}\">{{ o.label }}<\u002Foption><\u002Fsc-for>\n                  <\u002Fsc-raw-select>\n                <\u002Fdiv>\n\n                <div style=\"display:flex;align-items:center;gap:11px;background:#fbfcfe;border:1px solid #eef1f6;border-radius:11px;padding:10px 12px;margin-bottom:13px;\">\n                  <span style=\"font-size:14px;\">🖥️<\u002Fspan>\n                  <div style=\"flex:1;min-width:0;\"><div style=\"font-size:12px;font-weight:700;color:#16233f;\">Split web &amp; mobile<\u002Fdiv><div style=\"font-size:11px;color:#9aa6b8;margin-top:1px;\">{{ cfgSplitLabel }}<\u002Fdiv><\u002Fdiv>\n                  <button sc-camel-on-click=\"{{ toggleSplit }}\" style=\"{{ cfgSplitSw }}\"><span style=\"{{ cfgSplitKnob }}\"><\u002Fspan><\u002Fbutton>\n                <\u002Fdiv>\n\n                <sc-if value=\"{{ cfgSplitOn }}\" hint-placeholder-val=\"{{ false }}\">\n                  <div style=\"display:grid;grid-template-columns:1.5fr 1fr;gap:11px;margin-bottom:13px;\">\n                    <sc-for list=\"{{ cfgSplitFrames }}\" as=\"f\" hint-placeholder-count=\"2\">\n                      <div>\n                        <div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:6px;margin-bottom:6px;\">\n                          <span style=\"{{ f.headStyle }}\">{{ f.label }}<\u002Fspan>\n                          <span style=\"font-size:9.5px;color:#9aa6b8;\">{{ f.note }}<\u002Fspan>\n                        <\u002Fdiv>\n                        <div style=\"{{ f.frame }}\"><span style=\"font-size:16px;\">🖼️<\u002Fspan><button sc-camel-on-click=\"{{ upWeb }}\" style=\"height:27px;padding:0 12px;border-radius:8px;border:1px solid rgba(16,35,63,.14);background:#fff;color:#16233f;font-weight:700;font-size:10.5px;cursor:pointer;\">Upload {{ f.label }}<\u002Fbutton><\u002Fdiv>\n                      <\u002Fdiv>\n                    <\u002Fsc-for>\n                  <\u002Fdiv>\n                <\u002Fsc-if>\n\n                <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:11px;flex-wrap:wrap;\">\n                  <div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Placement<\u002Fdiv>\n                  <span style=\"font-size:11px;font-weight:700;color:#5e6ad2;background:#eef0fc;border:1px solid #dcdff7;border-radius:6px;padding:2px 8px;\">{{ cfgRatioLabel }}<\u002Fspan>\n                <\u002Fdiv>\n                <sc-raw-select value=\"{{ cfgPlace }}\" sc-camel-on-change=\"{{ setCfgPlace }}\" style=\"width:100%;height:40px;padding:0 26px 0 11px;border:1px solid #e6ebf2;border-radius:10px;background:#fff;font-size:12.5px;color:#16233f;cursor:pointer;outline:none;margin-bottom:13px;\">\n                  <sc-for list=\"{{ cfgPlaceOpts }}\" as=\"o\" hint-placeholder-count=\"6\"><option value=\"{{ o.id }}\">{{ o.label }}<\u002Foption><\u002Fsc-for>\n                <\u002Fsc-raw-select>\n                <div style=\"{{ cfgFrameStyle }}\">\n                  <span style=\"font-size:22px;\">🖼️<\u002Fspan>\n                  <div style=\"font-size:12px;font-weight:650;color:#8a97ac;\">Drop banner · {{ cfgRatioLabel }}<\u002Fdiv>\n                  <button sc-camel-on-click=\"{{ upBanner }}\" style=\"height:30px;padding:0 14px;border-radius:8px;border:1px solid #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:11.5px;cursor:pointer;\">Upload banner<\u002Fbutton>\n                <\u002Fdiv>\n                <div style=\"margin-top:13px;padding-top:13px;border-top:1px solid #f1f4f9;\">\n                  <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:7px;\">Banner copy<\u002Fdiv>\n                  <sc-raw-select value=\"{{ cfgHeadline }}\" sc-camel-on-change=\"{{ setCfgHeadline }}\" disabled=\"{{ cfgReadOnly }}\" style=\"{{ cfgSelectStyle }}\">\n                    <sc-for list=\"{{ cfgHeadOpts }}\" as=\"h\" hint-placeholder-count=\"4\"><option value=\"{{ h.id }}\">{{ h.label }}<\u002Foption><\u002Fsc-for>\n                  <\u002Fsc-raw-select>\n                  <div style=\"height:8px;\"><\u002Fdiv>\n                  <textarea sc-camel-read-only=\"{{ cfgReadOnly }}\" placeholder=\"Description shown under the headline…\" style=\"{{ cfgTextArea }}\">{{ cfgBannerDesc }}<\u002Ftextarea>\n                  <input value=\"{{ cfgBannerCta }}\" sc-camel-read-only=\"{{ cfgReadOnly }}\" placeholder=\"Button label\" style=\"width:100%;height:38px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;color:#16233f;outline:none;margin-top:8px;\">\n                <\u002Fdiv>\n                <div style=\"{{ cfgUploadRow }}\">\n                  <button style=\"flex:1;height:38px;border-radius:10px;border:1px dashed #cbd5e6;background:#fff;color:#5e6ad2;font-weight:650;font-size:12.5px;cursor:pointer;\">Upload image<\u002Fbutton>\n                  <button style=\"height:38px;padding:0 14px;border-radius:10px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-weight:650;font-size:12.5px;cursor:pointer;\">Replace<\u002Fbutton>\n                <\u002Fdiv>\n              <\u002Fdiv>\n              <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n                <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:11px;\">Live in this placement<\u002Fdiv>\n                <div style=\"display:flex;flex-direction:column;gap:8px;\">\n                  <sc-for list=\"{{ cfgItems }}\" as=\"it\" hint-placeholder-count=\"3\">\n                    <div draggable=\"{{ it.dragAttr }}\" sc-camel-on-drag-start=\"{{ it.onDragStart }}\" sc-camel-on-drag-over=\"{{ it.onDragOver }}\" sc-camel-on-drop=\"{{ it.onDrop }}\" style=\"{{ it.rowStyle }}\">\n                      <span style=\"font-size:11px;color:#c0c9d6;letter-spacing:-2px;flex:0 0 auto;\">{{ it.grip }}<\u002Fspan>\n                      <span style=\"{{ it.thumbStyle }}\"><\u002Fspan>\n                      <span style=\"{{ it.nameStyle }}\">{{ it.name }}<\u002Fspan>\n                      <span style=\"{{ it.statusStyle }}\">{{ it.statusLabel }}<\u002Fspan>\n                      <button sc-camel-on-click=\"{{ it.toggle }}\" style=\"{{ it.sw }}\"><span style=\"{{ it.knob }}\"><\u002Fspan><\u002Fbutton>\n                      <span style=\"font-size:10px;color:#b0bacb;font-variant-numeric:tabular-nums;\">#{{ it.ord }}<\u002Fspan>\n                      <span style=\"{{ cfgOrderBtns }}\"><button sc-camel-on-click=\"{{ it.up }}\" style=\"width:22px;height:22px;border-radius:6px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-size:10px;cursor:pointer;\">↑<\u002Fbutton><button sc-camel-on-click=\"{{ it.down }}\" style=\"width:22px;height:22px;border-radius:6px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-size:10px;cursor:pointer;\">↓<\u002Fbutton><\u002Fspan>\n                    <\u002Fdiv>\n                  <\u002Fsc-for>\n                <\u002Fdiv>\n                <div style=\"margin-top:14px;padding-top:13px;border-top:1px solid #f1f4f9;\">\n                  <div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-bottom:9px;\">\n                    <div><div style=\"font-size:12px;font-weight:750;color:#16233f;\">Gallery<\u002Fdiv><div style=\"font-size:11px;color:#9aa6b8;margin-top:1px;\">Previously uploaded assets — tap to reuse here.<\u002Fdiv><\u002Fdiv>\n                    <span style=\"font-size:10px;font-weight:700;color:#9aa6b8;\">{{ cfgGalleryCount }}<\u002Fspan>\n                  <\u002Fdiv>\n                  <div style=\"display:flex;gap:8px;flex-wrap:wrap;\">\n                    <sc-for list=\"{{ cfgGalleryPick }}\" as=\"gp\" hint-placeholder-count=\"6\">\n                      <button sc-camel-on-click=\"{{ gp.pick }}\" class=\"cdact\" style=\"{{ gp.tileStyle }}\" style-hover=\"box-shadow:0 5px 14px rgba(16,35,63,.12);\">\n                        <span style=\"{{ gp.thumbStyle }}\"><\u002Fspan>\n                        <span style=\"font-size:10px;font-weight:650;color:#16233f;line-height:1.25;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">{{ gp.name }}<\u002Fspan>\n                        <span style=\"{{ gp.badgeStyle }}\">{{ gp.badge }}<\u002Fspan>\n                      <\u002Fbutton>\n                    <\u002Fsc-for>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;margin-top:14px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:13px;flex-wrap:wrap;\">\n                <div><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Live preview<\u002Fdiv><div style=\"font-size:11.5px;color:#9aa6b8;margin-top:2px;\">{{ cfgPrevBothNote }} · {{ cfgRatioLabel }}<\u002Fdiv><\u002Fdiv>\n                <span style=\"font-size:11px;font-weight:700;color:#5e6ad2;background:#eef0fc;border:1px solid #dcdff7;border-radius:6px;padding:2px 8px;\">{{ cfgPlace }} · {{ cfgRatioLabel }}<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"display:grid;grid-template-columns:1.55fr 1fr;gap:16px;align-items:start;\">\n\n                <sc-if value=\"{{ cfgPrevWeb }}\" hint-placeholder-val=\"{{ true }}\">\n                <div>\n                  <div style=\"font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#0d9488;margin-bottom:7px;\">Website<\u002Fdiv>\n                  <div style=\"border:1px solid #dde3ec;border-radius:11px;overflow:hidden;background:#fff;box-shadow:0 6px 18px rgba(16,35,63,.1);\">\n                    <div style=\"display:flex;align-items:center;gap:6px;padding:7px 10px;background:#f2f5fa;border-bottom:1px solid #e6ebf2;\">\n                      <span style=\"width:7px;height:7px;border-radius:50%;background:#e5484d;\"><\u002Fspan><span style=\"width:7px;height:7px;border-radius:50%;background:#f0a91b;\"><\u002Fspan><span style=\"width:7px;height:7px;border-radius:50%;background:#2b8f5b;\"><\u002Fspan>\n                      <span style=\"flex:1;height:15px;border-radius:4px;background:#fff;border:1px solid #e6ebf2;display:flex;align-items:center;padding:0 7px;font-size:8.5px;color:#a7b2c2;\">irwellness.in<\u002Fspan>\n                    <\u002Fdiv>\n                    <div style=\"padding:10px 12px 14px;\">\n                      <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:9px;\">\n                        <span style=\"width:18px;height:18px;border-radius:5px;background:linear-gradient(135deg,#2fa968,#268a54);color:#fff;display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:800;\">IR<\u002Fspan>\n                        <span style=\"font-size:8.5px;font-weight:700;color:#16233f;\">India Redefining Wellness<\u002Fspan>\n                        <span style=\"margin-left:auto;display:flex;gap:7px;\"><span style=\"width:26px;height:5px;border-radius:3px;background:#eef1f6;\"><\u002Fspan><span style=\"width:22px;height:5px;border-radius:3px;background:#eef1f6;\"><\u002Fspan><span style=\"width:30px;height:14px;border-radius:4px;background:#2fa968;\"><\u002Fspan><\u002Fspan>\n                      <\u002Fdiv>\n                      <div style=\"{{ cfgWebSlot }}\">BANNER<\u002Fdiv>\n                      <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:10px;\">\n                        <div style=\"height:34px;border-radius:6px;background:#f7f9fc;border:1px solid #eef1f6;\"><\u002Fdiv>\n                        <div style=\"height:34px;border-radius:6px;background:#f7f9fc;border:1px solid #eef1f6;\"><\u002Fdiv>\n                        <div style=\"height:34px;border-radius:6px;background:#f7f9fc;border:1px solid #eef1f6;\"><\u002Fdiv>\n                      <\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n                <\u002Fsc-if>\n\n                <sc-if value=\"{{ cfgPrevApp }}\" hint-placeholder-val=\"{{ true }}\">\n                <div>\n                  <div style=\"font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#5e6ad2;margin-bottom:7px;\">App<\u002Fdiv>\n                  <div style=\"max-width:196px;border:7px solid #16233f;border-radius:26px;overflow:hidden;background:#fff;box-shadow:0 8px 22px rgba(16,35,63,.18);\">\n                    <div style=\"display:flex;align-items:center;justify-content:space-between;padding:5px 12px 4px;background:#16233f;color:#c9d4e6;font-size:7.5px;font-weight:700;\">\n                      <span>9:41<\u002Fspan><span style=\"display:flex;gap:3px;\"><span>▮▮▮<\u002Fspan><span>◗<\u002Fspan><\u002Fspan>\n                    <\u002Fdiv>\n                    <div style=\"padding:9px 10px 12px;\">\n                      <div style=\"display:flex;align-items:center;gap:6px;margin-bottom:8px;\">\n                        <span style=\"width:16px;height:16px;border-radius:5px;background:linear-gradient(135deg,#2fa968,#268a54);color:#fff;display:flex;align-items:center;justify-content:center;font-size:7px;font-weight:800;\">IR<\u002Fspan>\n                        <span style=\"font-size:8px;font-weight:700;color:#16233f;\">Good morning<\u002Fspan>\n                        <span style=\"margin-left:auto;font-size:9px;\">🔔<\u002Fspan>\n                      <\u002Fdiv>\n                      <div style=\"{{ cfgAppSlot }}\">BANNER<\u002Fdiv>\n                      <div style=\"display:flex;gap:5px;margin-top:9px;\">\n                        <div style=\"flex:1;height:30px;border-radius:7px;background:#f1faf5;border:1px solid #d7f0e2;\"><\u002Fdiv>\n                        <div style=\"flex:1;height:30px;border-radius:7px;background:#eef0fc;border:1px solid #dcdff7;\"><\u002Fdiv>\n                      <\u002Fdiv>\n                      <div style=\"height:26px;border-radius:7px;background:#f7f9fc;border:1px solid #eef1f6;margin-top:5px;\"><\u002Fdiv>\n                      <div style=\"display:flex;justify-content:space-between;gap:6px;margin-top:9px;padding-top:7px;border-top:1px solid #f1f4f9;\">\n                        <span style=\"font-size:9px;\">🏠<\u002Fspan><span style=\"font-size:9px;opacity:.4;\">🍽️<\u002Fspan><span style=\"font-size:9px;opacity:.4;\">📈<\u002Fspan><span style=\"font-size:9px;opacity:.4;\">👤<\u002Fspan>\n                      <\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n                <\u002Fsc-if>\n\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsCard }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;padding-bottom:12px;margin-bottom:13px;border-bottom:1px solid #f1f4f9;flex-wrap:wrap;\">\n                <div><div style=\"font-size:12px;font-weight:750;color:#16233f;\">Add an asset<\u002Fdiv><div style=\"font-size:11px;color:#9aa6b8;margin-top:1px;\">Create, upload, reuse from the gallery, or embed a link.<\u002Fdiv><\u002Fdiv>\n                <div style=\"{{ cfgAssetBar }}\">\n                  <sc-for list=\"{{ cfgAssetActions }}\" as=\"a\" hint-placeholder-count=\"4\"><button sc-camel-on-click=\"{{ a.act }}\" style=\"{{ a.style }}\">{{ a.icon }} {{ a.label }}<\u002Fbutton><\u002Fsc-for>\n                <\u002Fdiv>\n              <\u002Fdiv>\n\n              <sc-if value=\"{{ cfgIsBirthdayCard }}\" hint-placeholder-val=\"{{ false }}\">\n                <div style=\"background:#fbfcfe;border:1px solid #eef1f6;border-radius:12px;padding:13px 14px;margin-bottom:14px;\">\n                  <div style=\"display:flex;align-items:center;gap:11px;margin-bottom:12px;flex-wrap:wrap;\">\n                    <span style=\"font-size:15px;\">⏱️<\u002Fspan>\n                    <div style=\"flex:1;min-width:0;\"><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Automatic trigger<\u002Fdiv><div style=\"font-size:11px;color:#9aa6b8;margin-top:1px;\">Runs every night and sends a card to everyone whose birthday it is.<\u002Fdiv><\u002Fdiv>\n                    <sc-raw-select value=\"{{ cfgCronTime }}\" sc-camel-on-change=\"{{ setCfgCronTime }}\" disabled=\"{{ cfgReadOnly }}\" style=\"height:32px;padding:0 22px 0 10px;border:1px solid #e6ebf2;border-radius:8px;background:#fff;font-size:11.5px;font-weight:650;color:#16233f;cursor:pointer;outline:none;\">\n                      <sc-for list=\"{{ cfgCronTimeOpts }}\" as=\"o\" hint-placeholder-count=\"4\"><option value=\"{{ o.id }}\">{{ o.label }}<\u002Foption><\u002Fsc-for>\n                    <\u002Fsc-raw-select>\n                    <button sc-camel-on-click=\"{{ toggleCron }}\" style=\"{{ cfgCronSw }}\"><span style=\"{{ cfgCronKnob }}\"><\u002Fspan><\u002Fbutton>\n                  <\u002Fdiv>\n                  <div style=\"display:flex;gap:9px;flex-wrap:wrap;margin-bottom:11px;\">\n                    <sc-for list=\"{{ cfgCronStats }}\" as=\"cs\" hint-placeholder-count=\"3\">\n                      <div style=\"{{ cs.cardStyle }}\">\n                        <span style=\"font-size:9.5px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;{{ cs.accent }}\">{{ cs.label }}<\u002Fspan>\n                        <span style=\"font-size:13px;font-weight:780;color:#16233f;font-variant-numeric:tabular-nums;\">{{ cs.value }}<\u002Fspan>\n                        <span style=\"font-size:10px;color:#9aa6b8;\">{{ cs.note }}<\u002Fspan>\n                      <\u002Fdiv>\n                    <\u002Fsc-for>\n                  <\u002Fdiv>\n                  <div style=\"display:flex;align-items:center;gap:11px;padding-top:11px;border-top:1px solid #f1f4f9;flex-wrap:wrap;\">\n                    <span style=\"font-size:14px;\">🔁<\u002Fspan>\n                    <div style=\"flex:1;min-width:0;\"><div style=\"font-size:11.5px;font-weight:700;color:#16233f;\">Auto-retry if the job fails<\u002Fdiv><div style=\"font-size:10.5px;color:#9aa6b8;\">Retries hourly for 6 hours, then alerts admin.<\u002Fdiv><\u002Fdiv>\n                    <button sc-camel-on-click=\"{{ toggleRetry }}\" style=\"{{ cfgRetrySw }}\"><span style=\"{{ cfgRetryKnob }}\"><\u002Fspan><\u002Fbutton>\n                    <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ runCronNow }}\" style=\"height:32px;padding:0 13px;border-radius:8px;border:none;background:#5e6ad2;color:#fff;font-weight:700;font-size:11.5px;cursor:pointer;\">Run now<\u002Fbutton><\u002Fsc-if>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n\n                <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:12px;padding:13px 14px;margin-bottom:14px;\">\n                  <div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-bottom:10px;\">\n                    <div><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Today's birthdays<\u002Fdiv><div style=\"font-size:11px;color:#9aa6b8;margin-top:1px;\">More than one person can share a date — each gets their own card.<\u002Fdiv><\u002Fdiv>\n                    <span style=\"font-size:10px;font-weight:700;color:#9aa6b8;\">{{ cfgBdayToday }}<\u002Fspan>\n                  <\u002Fdiv>\n                  <div style=\"display:flex;flex-direction:column;gap:7px;\">\n                    <sc-for list=\"{{ cfgBdayQueue }}\" as=\"bq\" hint-placeholder-count=\"5\">\n                      <div style=\"display:flex;align-items:center;gap:10px;background:#fbfcfe;border:1px solid #eef1f6;border-radius:10px;padding:8px 11px;\">\n                        <span style=\"{{ bq.avatar }}\">🎂<\u002Fspan>\n                        <div style=\"flex:1;min-width:0;\"><div style=\"font-size:12px;font-weight:700;color:#16233f;\">{{ bq.name }}<\u002Fdiv><div style=\"font-size:10.5px;color:#9aa6b8;\">{{ bq.role }}<\u002Fdiv><\u002Fdiv>\n                        <span style=\"font-size:10.5px;color:#b0bacb;font-variant-numeric:tabular-nums;\">{{ bq.time }}<\u002Fspan>\n                        <span style=\"{{ bq.stStyle }}\">{{ bq.status }}<\u002Fspan>\n                        <sc-if value=\"{{ bq.failed }}\" hint-placeholder-val=\"{{ false }}\"><button sc-camel-on-click=\"{{ bq.resend }}\" style=\"height:26px;padding:0 10px;border-radius:7px;border:1px solid #f6d0d1;background:#fff;color:#c0392b;font-weight:700;font-size:10.5px;cursor:pointer;\">Resend<\u002Fbutton><\u002Fsc-if>\n                      <\u002Fdiv>\n                    <\u002Fsc-for>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-if>\n\n              <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:3px;\">Card copy<\u002Fdiv>\n              <div style=\"font-size:11.5px;color:#9aa6b8;margin-bottom:10px;\">Text printed on the card — edit any line.<\u002Fdiv>\n              <div style=\"display:flex;flex-direction:column;gap:9px;margin-bottom:14px;\">\n                <sc-for list=\"{{ cfgCardCopy }}\" as=\"cc\" hint-placeholder-count=\"4\">\n                  <div>\n                    <div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-bottom:5px;\">\n                      <span style=\"font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#8a97ac;\">{{ cc.label }}<\u002Fspan>\n                      <span style=\"font-size:9.5px;color:#b0bacb;\">{{ cc.hint }}<\u002Fspan>\n                    <\u002Fdiv>\n                    <sc-if value=\"{{ cc.long }}\" hint-placeholder-val=\"{{ false }}\">\n                      <div contenteditable=\"{{ cc.editAttr }}\" style=\"font-size:12.5px;color:#2c3a54;line-height:1.55;text-wrap:pretty;background:#fbfcfe;border:1px solid #eef1f6;border-radius:10px;padding:10px 12px;outline:none;\" style-focus=\"border-color:#5e6ad2;background:#fff;\">{{ cc.value }}<\u002Fdiv>\n                    <\u002Fsc-if>\n                    <sc-if value=\"{{ cc.short }}\" hint-placeholder-val=\"{{ true }}\">\n                      <div contenteditable=\"{{ cc.editAttr }}\" style=\"font-size:12.5px;font-weight:650;color:#16233f;background:#fbfcfe;border:1px solid #eef1f6;border-radius:9px;padding:9px 12px;outline:none;\" style-focus=\"border-color:#5e6ad2;background:#fff;\">{{ cc.value }}<\u002Fdiv>\n                    <\u002Fsc-if>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n\n              <div style=\"display:flex;align-items:center;gap:11px;background:#fbfcfe;border:1px solid #eef1f6;border-radius:11px;padding:10px 12px;margin-bottom:13px;\">\n                <span style=\"font-size:14px;\">🧑<\u002Fspan>\n                <div style=\"flex:1;min-width:0;\"><div style=\"font-size:12px;font-weight:700;color:#16233f;\">Show the client's photo on the card<\u002Fdiv><div style=\"font-size:11px;color:#9aa6b8;margin-top:1px;\">Adds a photo slot to whichever template you pick.<\u002Fdiv><\u002Fdiv>\n                <button sc-camel-on-click=\"{{ togglePhoto }}\" style=\"{{ cfgPhotoSw }}\"><span style=\"{{ cfgPhotoKnob }}\"><\u002Fspan><\u002Fbutton>\n              <\u002Fdiv>\n\n              <sc-if value=\"{{ cfgPhotoOn }}\" hint-placeholder-val=\"{{ true }}\">\n                <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:3px;\">Photo position<\u002Fdiv>\n                <div style=\"font-size:11.5px;color:#9aa6b8;margin-bottom:10px;\">Where the photo sits inside the card.<\u002Fdiv>\n                <div style=\"display:flex;gap:9px;margin-bottom:14px;\">\n                  <sc-for list=\"{{ cfgPhotoSpots }}\" as=\"ps\" hint-placeholder-count=\"4\">\n                    <button sc-camel-on-click=\"{{ ps.pick }}\" style=\"{{ ps.cardStyle }}\">\n                      <span style=\"{{ ps.mockStyle }}\"><span style=\"{{ ps.avatarStyle }}\"><\u002Fspan><span style=\"{{ ps.barStyle }}\"><\u002Fspan><span style=\"{{ ps.bar2Style }}\"><\u002Fspan><\u002Fspan>\n                      <span style=\"{{ ps.labelStyle }}\">{{ ps.label }}<\u002Fspan>\n                      <span style=\"font-size:9.5px;color:#9aa6b8;line-height:1.3;\">{{ ps.note }}<\u002Fspan>\n                    <\u002Fbutton>\n                  <\u002Fsc-for>\n                <\u002Fdiv>\n                <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:3px;\">Photo source<\u002Fdiv>\n                <div style=\"font-size:11.5px;color:#9aa6b8;margin-bottom:10px;\">Where the image comes from when a card is generated.<\u002Fdiv>\n                <div style=\"display:flex;flex-direction:column;gap:7px;margin-bottom:14px;\">\n                  <sc-for list=\"{{ cfgPhotoSrc }}\" as=\"src\" hint-placeholder-count=\"3\">\n                    <button sc-camel-on-click=\"{{ src.pick }}\" style=\"{{ src.rowStyle }}\">\n                      <span style=\"{{ src.dotStyle }}\"><\u002Fspan>\n                      <span style=\"flex:1;min-width:0;font-size:12px;font-weight:650;color:#16233f;\">{{ src.label }}<\u002Fspan>\n                      <span style=\"font-size:10.5px;color:#9aa6b8;\">{{ src.note }}<\u002Fspan>\n                    <\u002Fbutton>\n                  <\u002Fsc-for>\n                <\u002Fdiv>\n              <\u002Fsc-if>\n\n              <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:4px;\">Card design<\u002Fdiv>\n              <div style=\"font-size:11.5px;color:#9aa6b8;margin-bottom:13px;\">Pick a ready-made card, or add your own with the actions above.<\u002Fdiv>\n              <div style=\"{{ cfgTplRow }}\">\n                <sc-for list=\"{{ cfgCardTpls }}\" as=\"c\" hint-placeholder-count=\"5\">\n                  <button sc-camel-on-click=\"{{ c.pick }}\" style=\"{{ c.style }}\">\n                    <span style=\"{{ c.thumb }}\">🏆<\u002Fspan>\n                    <span style=\"font-size:11px;font-weight:650;color:#16233f;line-height:1.3;\">{{ c.label }}<\u002Fspan>\n                  <\u002Fbutton>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsTransform }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;margin-bottom:14px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n\n              <div style=\"display:grid;grid-template-columns:auto 1fr;gap:16px;align-items:start;\">\n                <div style=\"min-width:0;\">\n                  <sc-if value=\"{{ cfgIsHealing }}\" hint-placeholder-val=\"{{ false }}\">\n                    <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:11px;\">Photo<\u002Fdiv>\n                    <div style=\"{{ cfgCompareGrid }}\">\n                      <div style=\"{{ photoFrame }}\">\n                        <span style=\"font-size:20px;\">📷<\u002Fspan><span style=\"font-size:11.5px;font-weight:700;color:#2b8f5b;\">{{ photoLabel }}<\u002Fspan>\n                        <button sc-camel-on-click=\"{{ upPhoto }}\" style=\"height:29px;padding:0 13px;border-radius:8px;border:1px solid #bfe3ce;background:#fff;color:#2b8f5b;font-weight:700;font-size:11px;cursor:pointer;\">Upload photo<\u002Fbutton>\n                      <\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fsc-if>\n                  <sc-if value=\"{{ cfgIsCompare }}\" hint-placeholder-val=\"{{ true }}\">\n                  <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:11px;\">Comparison images<\u002Fdiv>\n                  <div style=\"{{ cfgCompareGrid }}\">\n                    <div style=\"{{ beforeFrame }}\">\n                      <span style=\"font-size:20px;\">📷<\u002Fspan><span style=\"font-size:11.5px;font-weight:700;color:#8a97ac;\">{{ beforeLabel }}<\u002Fspan>\n                      <button sc-camel-on-click=\"{{ upBefore }}\" style=\"height:29px;padding:0 13px;border-radius:8px;border:1px solid #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:11px;cursor:pointer;\">Upload photo<\u002Fbutton>\n                    <\u002Fdiv>\n                    <div style=\"{{ afterFrame }}\">\n                      <span style=\"font-size:20px;\">📷<\u002Fspan><span style=\"font-size:11.5px;font-weight:700;color:#2b8f5b;\">{{ afterLabel }}<\u002Fspan>\n                      <button sc-camel-on-click=\"{{ upAfter }}\" style=\"height:29px;padding:0 13px;border-radius:8px;border:1px solid #bfe3ce;background:#fff;color:#2b8f5b;font-weight:700;font-size:11px;cursor:pointer;\">Upload photo<\u002Fbutton>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                  <\u002Fsc-if>\n                <\u002Fdiv>\n\n                <div style=\"min-width:0;\">\n                  <div style=\"display:flex;align-items:center;justify-content:space-between;gap:9px;margin-bottom:9px;flex-wrap:wrap;\">\n                    <div><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Data points<\u002Fdiv><div style=\"font-size:11px;color:#9aa6b8;margin-top:1px;\">Pick from the dropdown · values auto-fill, edit any of them.<\u002Fdiv><\u002Fdiv>\n                    <sc-if value=\"{{ cfgDpHasAdd }}\" hint-placeholder-val=\"{{ true }}\">\n                      <sc-raw-select value=\"\" sc-camel-on-change=\"{{ addDataPt }}\" disabled=\"{{ cfgReadOnly }}\" style=\"height:30px;padding:0 22px 0 10px;border:1px dashed #cbd5e6;border-radius:8px;background:#fff;font-size:11.5px;font-weight:650;color:#5e6ad2;cursor:pointer;outline:none;\">\n                        <option value=\"\">+ Add data point<\u002Foption>\n                        <sc-for list=\"{{ cfgDpAddOpts }}\" as=\"o\" hint-placeholder-count=\"5\"><option value=\"{{ o.id }}\">{{ o.label }}<\u002Foption><\u002Fsc-for>\n                      <\u002Fsc-raw-select>\n                    <\u002Fsc-if>\n                  <\u002Fdiv>\n                  <div style=\"border:1px solid #eef1f6;border-radius:11px;overflow:hidden;max-height:154px;overflow-y:auto;\">\n                    <div style=\"display:grid;grid-template-columns:1fr 1.2fr 58px 26px;gap:8px;padding:8px 11px;background:#fbfcfe;border-bottom:1px solid #eef1f6;position:sticky;top:0;z-index:1;font-size:9.5px;font-weight:700;letter-spacing:.05em;color:#8a97ac;text-transform:uppercase;\"><div>Field<\u002Fdiv><div>Value<\u002Fdiv><div>Source<\u002Fdiv><div><\u002Fdiv><\u002Fdiv>\n                    <sc-if value=\"{{ cfgIsHealing }}\" hint-placeholder-val=\"{{ false }}\">\n                      <sc-for list=\"{{ cfgHealingRows }}\" as=\"hr\" hint-placeholder-count=\"2\">\n                        <div style=\"display:grid;grid-template-columns:1fr 1.2fr 58px 26px;gap:8px;padding:8px 11px;border-bottom:1px solid #f4f6fa;align-items:center;background:#fbfcff;\">\n                          <div style=\"font-size:11.5px;font-weight:650;color:#16233f;\">{{ hr.label }}<\u002Fdiv>\n                          <sc-raw-select value=\"{{ hr.value }}\" sc-camel-on-change=\"{{ hr.onChange }}\" disabled=\"{{ cfgReadOnly }}\" style=\"width:100%;height:26px;padding:0 18px 0 7px;border:1px solid #e6ebf2;border-radius:6px;background:#fff;font-size:11px;font-weight:650;color:#16233f;cursor:pointer;outline:none;\">\n                            <sc-for list=\"{{ hr.opts }}\" as=\"o\" hint-placeholder-count=\"5\"><option value=\"{{ o.id }}\">{{ o.label }}<\u002Foption><\u002Fsc-for>\n                          <\u002Fsc-raw-select>\n                          <div style=\"font-size:9px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;color:#c2661d;\">Required<\u002Fdiv>\n                          <div><\u002Fdiv>\n                        <\u002Fdiv>\n                      <\u002Fsc-for>\n                    <\u002Fsc-if>\n                    <sc-if value=\"{{ cfgManualEmpty }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"padding:18px;text-align:center;font-size:11.5px;color:#9aa6b8;\">Add more data points as needed.<\u002Fdiv><\u002Fsc-if>\n                    <sc-for list=\"{{ cfgDpRows }}\" as=\"dp\" hint-placeholder-count=\"3\">\n                      <div style=\"display:grid;grid-template-columns:1fr 1.2fr 58px 26px;gap:8px;padding:8px 11px;border-bottom:1px solid #f4f6fa;align-items:center;\">\n                        <div style=\"font-size:11.5px;font-weight:650;color:#16233f;\">{{ dp.label }}<\u002Fdiv>\n                        <div contenteditable=\"{{ dp.editAttr }}\" style=\"font-size:11.5px;font-weight:650;color:#16233f;outline:none;border-radius:5px;padding:2px 6px;border:1px dashed transparent;background:#fbfcfe;\" style-focus=\"border-color:#5e6ad2;background:#fff;\">{{ dp.value }}<\u002Fdiv>\n                        <div style=\"{{ dp.srcStyle }}\">{{ dp.srcLabel }}<\u002Fdiv>\n                        <div style=\"display:flex;justify-content:flex-end;\"><sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ dp.remove }}\" title=\"Remove\" style=\"border:none;background:transparent;color:#c7ccd6;cursor:pointer;font-size:13px;line-height:1;\" style-hover=\"color:#c0392b;\">×<\u002Fbutton><\u002Fsc-if><\u002Fdiv>\n                      <\u002Fdiv>\n                    <\u002Fsc-for>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n\n              <div style=\"margin-top:14px;padding-top:13px;border-top:1px solid #f1f4f9;display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:stretch;\">\n                <div style=\"display:flex;flex-direction:column;min-width:0;\">\n                  <div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Story<\u002Fdiv>\n                  <div style=\"font-size:11px;color:#9aa6b8;margin-top:1px;\">Shown beside the photos on the website and in the app.<\u002Fdiv>\n                  <textarea placeholder=\"Story / caption shown with the photo…\" sc-camel-read-only=\"{{ cfgReadOnly }}\" style=\"{{ cfgTextAreaTall }}\"><\u002Ftextarea>\n                <\u002Fdiv>\n                <div style=\"display:flex;flex-direction:column;min-width:0;\">\n                  <div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-bottom:8px;\">\n                    <div><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Preview<\u002Fdiv><div style=\"font-size:11px;color:#9aa6b8;margin-top:1px;\">{{ cfgPrevBothNote }}<\u002Fdiv><\u002Fdiv>\n                    <button sc-camel-on-click=\"{{ previewCfg }}\" style=\"height:26px;padding:0 10px;border-radius:7px;border:1px solid #dcdff7;background:#eef0fc;color:#5e6ad2;font-weight:700;font-size:10.5px;cursor:pointer;\">Open full ›<\u002Fbutton>\n                  <\u002Fdiv>\n                  <div style=\"display:flex;gap:10px;align-items:flex-start;\">\n                    <sc-if value=\"{{ cfgPrevWeb }}\" hint-placeholder-val=\"{{ true }}\">\n                      <div style=\"flex:1;min-width:0;\">\n                        <div style=\"font-size:9px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:#0d9488;margin-bottom:4px;\">Web<\u002Fdiv>\n                        <div style=\"border:1px solid #dde3ec;border-radius:8px;overflow:hidden;background:#fff;\">\n                          <div style=\"display:flex;align-items:center;gap:3px;padding:4px 6px;background:#f2f5fa;border-bottom:1px solid #e6ebf2;\"><span style=\"width:4px;height:4px;border-radius:50%;background:#e5484d;\"><\u002Fspan><span style=\"width:4px;height:4px;border-radius:50%;background:#f0a91b;\"><\u002Fspan><span style=\"width:4px;height:4px;border-radius:50%;background:#2b8f5b;\"><\u002Fspan><\u002Fdiv>\n                          <div style=\"padding:6px;display:flex;gap:5px;\">\n                            <span style=\"{{ cfgPrevWebSlot }}\"><\u002Fspan>\n                            <span style=\"flex:1;min-width:0;display:flex;flex-direction:column;gap:3px;justify-content:center;\"><span style=\"height:4px;border-radius:2px;background:#e6ebf2;width:80%;\"><\u002Fspan><span style=\"height:3px;border-radius:2px;background:#eef1f6;\"><\u002Fspan><span style=\"height:3px;border-radius:2px;background:#eef1f6;width:65%;\"><\u002Fspan><\u002Fspan>\n                          <\u002Fdiv>\n                        <\u002Fdiv>\n                      <\u002Fdiv>\n                    <\u002Fsc-if>\n                    <sc-if value=\"{{ cfgPrevApp }}\" hint-placeholder-val=\"{{ true }}\">\n                      <div style=\"flex:0 0 76px;\">\n                        <div style=\"font-size:9px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:#5e6ad2;margin-bottom:4px;\">App<\u002Fdiv>\n                        <div style=\"border:4px solid #16233f;border-radius:13px;overflow:hidden;background:#fff;\">\n                          <div style=\"height:6px;background:#16233f;\"><\u002Fdiv>\n                          <div style=\"padding:5px;\">\n                            <span style=\"{{ cfgPrevAppSlot }}\"><\u002Fspan>\n                            <span style=\"display:flex;flex-direction:column;gap:2px;margin-top:4px;\"><span style=\"height:3px;border-radius:2px;background:#e6ebf2;width:70%;\"><\u002Fspan><span style=\"height:3px;border-radius:2px;background:#eef1f6;\"><\u002Fspan><\u002Fspan>\n                          <\u002Fdiv>\n                        <\u002Fdiv>\n                      <\u002Fdiv>\n                    <\u002Fsc-if>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:11px;\">\n                <div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Priority order<\u002Fdiv>\n                <span style=\"font-size:11px;color:#9aa6b8;\">Top item appears first<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"display:flex;flex-direction:column;gap:8px;\">\n                <sc-for list=\"{{ cfgItems }}\" as=\"it\" hint-placeholder-count=\"3\">\n                  <div draggable=\"{{ it.dragAttr }}\" sc-camel-on-drag-start=\"{{ it.onDragStart }}\" sc-camel-on-drag-over=\"{{ it.onDragOver }}\" sc-camel-on-drop=\"{{ it.onDrop }}\" style=\"{{ it.rowStyle }}\">\n                    <span style=\"font-size:11px;color:#c0c9d6;letter-spacing:-2px;flex:0 0 auto;\">{{ it.grip }}<\u002Fspan>\n                    <span style=\"width:20px;height:20px;flex:0 0 20px;border-radius:50%;background:#eef0fc;color:#5e6ad2;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:750;\">{{ it.ord }}<\u002Fspan>\n                    <span style=\"{{ it.nameStyle }}\">{{ it.name }}<\u002Fspan>\n                    <span style=\"{{ it.tagStyle }}\">{{ it.tag }}<\u002Fspan>\n                    <span style=\"{{ it.statusStyle }}\">{{ it.statusLabel }}<\u002Fspan>\n                    <button sc-camel-on-click=\"{{ it.toggle }}\" style=\"{{ it.sw }}\"><span style=\"{{ it.knob }}\"><\u002Fspan><\u002Fbutton>\n                    <span style=\"{{ cfgOrderBtns }}\"><button sc-camel-on-click=\"{{ it.up }}\" style=\"width:22px;height:22px;border-radius:6px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-size:10px;cursor:pointer;\">↑<\u002Fbutton><button sc-camel-on-click=\"{{ it.down }}\" style=\"width:22px;height:22px;border-radius:6px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-size:10px;cursor:pointer;\">↓<\u002Fbutton><\u002Fspan>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsReview }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;overflow:hidden;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 16px;border-bottom:1px solid #eef1f6;\">\n                <div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Review queue<\u002Fdiv>\n                <span style=\"font-size:11px;color:#9aa6b8;\">Submitted by clients in the app · <span style=\"font-weight:750;color:#b8860b;\">{{ cfgRevPendingCount }}<\u002Fspan> awaiting review<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"max-height:262px;overflow-y:auto;\">\n              <sc-for list=\"{{ cfgReviewsQueue }}\" as=\"r\" hint-placeholder-count=\"3\">\n                <div style=\"{{ r.rowStyle }}\">\n                  <span style=\"width:38px;height:38px;flex:0 0 38px;border-radius:50%;background:linear-gradient(135deg,#eef1f7,#dde3ec);display:flex;align-items:center;justify-content:center;font-size:15px;\">👤<\u002Fspan>\n                  <div style=\"flex:1;min-width:0;\">\n                    <div style=\"display:flex;align-items:center;gap:8px;flex-wrap:wrap;\"><span style=\"font-size:13px;font-weight:700;color:#16233f;\">{{ r.name }}<\u002Fspan><span style=\"font-size:12px;color:#f0a91b;\">{{ r.stars }}<\u002Fspan><span style=\"{{ r.stStyle }}\">{{ r.status }}<\u002Fspan><\u002Fdiv>\n                    <div style=\"font-size:12px;color:#5a6b85;line-height:1.45;margin-top:3px;text-wrap:pretty;\">{{ r.text }}<\u002Fdiv>\n                  <\u002Fdiv>\n                  <span style=\"{{ cfgActionRow }}\">\n                    <button sc-camel-on-click=\"{{ r.modify }}\" style=\"height:30px;padding:0 12px;border-radius:8px;border:1px solid #e6ebf2;background:#fff;color:#5e6ad2;font-weight:700;font-size:11.5px;cursor:pointer;\">Modify<\u002Fbutton>\n                    <button sc-camel-on-click=\"{{ r.approve }}\" style=\"height:30px;padding:0 12px;border-radius:8px;border:none;background:#e7f6ee;color:#2b8f5b;font-weight:700;font-size:11.5px;cursor:pointer;\">Approve<\u002Fbutton>\n                    <button sc-camel-on-click=\"{{ r.reject }}\" style=\"height:30px;padding:0 12px;border-radius:8px;border:1px solid #f6d0d1;background:#fff;color:#c0392b;font-weight:700;font-size:11.5px;cursor:pointer;\">Reject<\u002Fbutton>\n                  <\u002Fspan>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n              <\u002Fdiv>\n              <sc-if value=\"{{ cfgRevQueueEmpty }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"padding:22px;text-align:center;font-size:12px;color:#9aa6b8;\">Nothing awaiting review.<\u002Fdiv><\u002Fsc-if>\n            <\u002Fdiv>\n\n            <div style=\"background:#fff;border:1px solid #cdeede;border-radius:14px;overflow:hidden;box-shadow:0 1px 2px rgba(16,35,63,.04);margin-top:14px;\">\n              <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 16px;background:#f4fbf7;border-bottom:1px solid #cdeede;\">\n                <div style=\"display:flex;align-items:center;gap:8px;\"><span style=\"font-size:14px;\">✅<\u002Fspan><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Live on site<\u002Fdiv><\u002Fdiv>\n                <span style=\"font-size:11px;color:#5f9e7d;\"><span style=\"font-weight:750;\">{{ cfgRevLiveCount }}<\u002Fspan> published · reorder, tag a program, or disable<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"max-height:262px;overflow-y:auto;\">\n              <sc-for list=\"{{ cfgReviewsLive }}\" as=\"r\" hint-placeholder-count=\"3\">\n                <div style=\"{{ r.rowStyle }}\">\n                  <span style=\"width:38px;height:38px;flex:0 0 38px;border-radius:50%;background:linear-gradient(135deg,#eef1f7,#dde3ec);display:flex;align-items:center;justify-content:center;font-size:15px;\">👤<\u002Fspan>\n                  <div style=\"flex:1;min-width:0;\">\n                    <div style=\"display:flex;align-items:center;gap:8px;flex-wrap:wrap;\"><span style=\"font-size:13px;font-weight:700;color:#16233f;\">{{ r.name }}<\u002Fspan><span style=\"font-size:12px;color:#f0a91b;\">{{ r.stars }}<\u002Fspan><\u002Fdiv>\n                    <div style=\"font-size:12px;color:#5a6b85;line-height:1.45;margin-top:3px;text-wrap:pretty;\">{{ r.text }}<\u002Fdiv>\n                  <\u002Fdiv>\n                  <span style=\"{{ cfgActionRow }}\">\n                    <sc-raw-select value=\"{{ r.prog }}\" sc-camel-on-change=\"{{ r.setProg }}\" disabled=\"{{ cfgReadOnly }}\" title=\"Tag a program (optional)\" style=\"height:28px;padding:0 20px 0 8px;border:1px solid #e6ebf2;border-radius:7px;background:#fff;font-size:10.5px;font-weight:650;color:#5a6b85;cursor:pointer;outline:none;\">\n                      <option value=\"\">No program tag<\u002Foption>\n                      <sc-for list=\"{{ cfgProgList }}\" as=\"p\" hint-placeholder-count=\"6\"><option value=\"{{ p.label }}\">{{ p.label }}<\u002Foption><\u002Fsc-for>\n                    <\u002Fsc-raw-select>\n                    <span style=\"display:flex;gap:3px;\"><button sc-camel-on-click=\"{{ r.up }}\" title=\"Move up\" style=\"width:24px;height:24px;border-radius:6px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-size:10px;cursor:pointer;\">↑<\u002Fbutton><button sc-camel-on-click=\"{{ r.down }}\" title=\"Move down\" style=\"width:24px;height:24px;border-radius:6px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-size:10px;cursor:pointer;\">↓<\u002Fbutton><\u002Fspan>\n                    <span style=\"{{ r.liveStyle }}\">{{ r.liveLabel }}<\u002Fspan>\n                    <button sc-camel-on-click=\"{{ r.toggleLive }}\" title=\"Enable or disable on site\" style=\"{{ r.sw }}\"><span style=\"{{ r.knob }}\"><\u002Fspan><\u002Fbutton>\n                    <sc-if value=\"{{ r.canDelete }}\" hint-placeholder-val=\"{{ false }}\">\n                      <button sc-camel-on-click=\"{{ r.modify }}\" style=\"height:30px;padding:0 12px;border-radius:8px;border:1px solid #e6ebf2;background:#fff;color:#5e6ad2;font-weight:700;font-size:11.5px;cursor:pointer;\">Modify<\u002Fbutton>\n                      <button sc-camel-on-click=\"{{ r.del }}\" style=\"height:30px;padding:0 12px;border-radius:8px;border:1px solid #f6d0d1;background:#fff;color:#c0392b;font-weight:700;font-size:11.5px;cursor:pointer;\">Delete<\u002Fbutton>\n                    <\u002Fsc-if>\n                  <\u002Fspan>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n              <\u002Fdiv>\n              <sc-if value=\"{{ cfgRevLiveEmpty }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"padding:22px;text-align:center;font-size:12px;color:#9aa6b8;\">No reviews published yet — approve one above.<\u002Fdiv><\u002Fsc-if>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsVoice }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:14px;\">\n              <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n                <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:11px;\">Video<\u002Fdiv>\n                <div style=\"{{ cfgVideoFrame }}\"><span style=\"font-size:20px;\">▶<\u002Fspan><button sc-camel-on-click=\"{{ upVideo }}\" style=\"height:29px;padding:0 13px;border-radius:8px;border:1px solid #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:11px;cursor:pointer;\">Upload video<\u002Fbutton><\u002Fdiv>\n                <div style=\"font-size:10.5px;color:#9aa6b8;text-align:center;margin:10px 0;\">or<\u002Fdiv>\n                <input placeholder=\"Paste a video link (YouTube / Vimeo)\" sc-camel-read-only=\"{{ cfgReadOnly }}\" style=\"{{ cfgLinkInput }}\">\n              <\u002Fdiv>\n              <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n                <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:11px;\">Cover &amp; details<\u002Fdiv>\n                <div style=\"{{ cfgCoverFrame }}\"><button sc-camel-on-click=\"{{ upCover }}\" style=\"height:29px;padding:0 13px;border-radius:8px;border:1px solid #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:11px;cursor:pointer;\">Upload cover<\u002Fbutton><\u002Fdiv>\n                <div style=\"{{ cfgFieldCol }}\">\n                  <input placeholder=\"Client name\" sc-camel-read-only=\"{{ cfgReadOnly }}\" style=\"height:38px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;color:#16233f;outline:none;\">\n                  <input placeholder=\"Program / product name\" sc-camel-read-only=\"{{ cfgReadOnly }}\" style=\"height:38px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;color:#16233f;outline:none;\">\n                  <div style=\"font-size:11px;font-weight:750;color:#16233f;margin-top:4px;\">Description<\u002Fdiv>\n                  <textarea placeholder=\"What this story is about…\" sc-camel-read-only=\"{{ cfgReadOnly }}\" style=\"{{ cfgTextAreaSm }}\"><\u002Ftextarea>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;margin-top:14px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:9px;margin-bottom:10px;flex-wrap:wrap;\">\n                <div><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Already uploaded<\u002Fdiv><div style=\"font-size:11px;color:#9aa6b8;margin-top:1px;\">Drag or use the arrows to set the order they appear in.<\u002Fdiv><\u002Fdiv>\n                <span style=\"font-size:10px;font-weight:700;color:#9aa6b8;\">{{ cfgVoiceCount }}<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"display:flex;flex-direction:column;gap:8px;max-height:200px;overflow-y:auto;\">\n                <sc-for list=\"{{ cfgVoiceItems }}\" as=\"v\" hint-placeholder-count=\"4\">\n                  <div draggable=\"{{ v.dragAttr }}\" sc-camel-on-drag-start=\"{{ v.onDragStart }}\" sc-camel-on-drag-over=\"{{ v.onDragOver }}\" sc-camel-on-drop=\"{{ v.onDrop }}\" style=\"{{ v.rowStyle }}\">\n                    <span style=\"font-size:11px;color:#c0c9d6;letter-spacing:-2px;flex:0 0 auto;\">⋮⋮<\u002Fspan>\n                    <span style=\"width:20px;height:20px;flex:0 0 20px;border-radius:50%;background:#eef0fc;color:#5e6ad2;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:750;\">{{ v.ord }}<\u002Fspan>\n                    <span style=\"width:44px;height:30px;flex:0 0 44px;border-radius:6px;background:linear-gradient(135deg,#dfe4f5,#c9d4e6);display:flex;align-items:center;justify-content:center;font-size:11px;color:#5a6b85;\">▶<\u002Fspan>\n                    <span style=\"flex:1;min-width:0;\"><span style=\"display:block;font-size:12px;font-weight:650;color:#16233f;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">{{ v.name }}<\u002Fspan><span style=\"display:block;font-size:10.5px;color:#9aa6b8;\">{{ v.meta }}<\u002Fspan><\u002Fspan>\n                    <span style=\"{{ v.statusStyle }}\">{{ v.statusLabel }}<\u002Fspan>\n                    <button sc-camel-on-click=\"{{ v.toggle }}\" style=\"{{ v.sw }}\"><span style=\"{{ v.knob }}\"><\u002Fspan><\u002Fbutton>\n                    <span style=\"{{ cfgOrderBtns }}\"><button sc-camel-on-click=\"{{ v.up }}\" style=\"width:22px;height:22px;border-radius:6px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-size:10px;cursor:pointer;\">↑<\u002Fbutton><button sc-camel-on-click=\"{{ v.down }}\" style=\"width:22px;height:22px;border-radius:6px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-size:10px;cursor:pointer;\">↓<\u002Fbutton><\u002Fspan>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsMessage }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;margin-bottom:14px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-bottom:3px;flex-wrap:wrap;\">\n                <div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Display photo<\u002Fdiv>\n                <span style=\"font-size:10px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;color:#0d9488;background:#e6f6f2;border:1px solid #c3e8e1;border-radius:6px;padding:2px 8px;\">Shown on web<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"font-size:11px;color:#9aa6b8;margin-bottom:11px;\">Portrait used beside the message on the website. Square or 4:5 works best.<\u002Fdiv>\n              <div style=\"display:flex;gap:14px;align-items:flex-start;flex-wrap:wrap;\">\n                <div style=\"{{ cfgFounderFrame }}\">\n                  <span style=\"font-size:20px;\">🧑<\u002Fspan>\n                  <button sc-camel-on-click=\"{{ upFounder }}\" style=\"height:28px;padding:0 12px;border-radius:8px;border:1px solid #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:11px;cursor:pointer;\">{{ cfgFounderBtn }}<\u002Fbutton>\n                <\u002Fdiv>\n                <div style=\"flex:1;min-width:220px;display:flex;flex-direction:column;gap:8px;\">\n                  <div style=\"display:flex;align-items:center;gap:9px;background:#fbfcfe;border:1px solid #eef1f6;border-radius:10px;padding:9px 11px;\">\n                    <span style=\"flex:1;min-width:0;font-size:11.5px;font-weight:650;color:#16233f;\">{{ cfgFounderState }}<\u002Fspan>\n                    <span style=\"{{ cfgFounderTag }}\">{{ cfgFounderTagLabel }}<\u002Fspan>\n                  <\u002Fdiv>\n                  <sc-if value=\"{{ cfgShowFounderHist }}\" hint-placeholder-val=\"{{ true }}\">\n                  <div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-top:2px;\">\n                    <div style=\"font-size:11px;font-weight:750;color:#16233f;\">Photo history<\u002Fdiv>\n                    <div style=\"font-size:10px;color:#9aa6b8;\">Tick a surface to make one live<\u002Fdiv>\n                  <\u002Fdiv>\n                  <div style=\"display:flex;gap:8px;overflow-x:auto;padding-bottom:3px;\">\n                    <sc-for list=\"{{ cfgFounderHist }}\" as=\"fh\" hint-placeholder-count=\"4\">\n                      <div style=\"{{ fh.tileStyle }}\">\n                        <span style=\"{{ fh.thumbStyle }}\"><\u002Fspan>\n                        <span style=\"display:flex;align-items:center;justify-content:space-between;gap:5px;width:100%;\">\n                          <span style=\"font-size:9.5px;font-weight:650;color:#16233f;white-space:nowrap;\">{{ fh.date }}<\u002Fspan>\n                          <span style=\"{{ fh.liveTag }}\">{{ fh.liveLabel }}<\u002Fspan>\n                        <\u002Fspan>\n                        <span style=\"display:flex;gap:5px;width:100%;\">\n                          <button sc-camel-on-click=\"{{ fh.toggleWeb }}\" style=\"{{ fh.webStyle }}\">Web<\u002Fbutton>\n                          <button sc-camel-on-click=\"{{ fh.toggleApp }}\" style=\"{{ fh.appStyle }}\">App<\u002Fbutton>\n                        <\u002Fspan>\n                        <button sc-camel-on-click=\"{{ fh.makeLive }}\" style=\"{{ fh.bothStyle }}\">{{ fh.bothLabel }}<\u002Fbutton>\n                      <\u002Fdiv>\n                    <\u002Fsc-for>\n                  <\u002Fdiv>\n                  <\u002Fsc-if>\n                  <sc-if value=\"{{ cfgIsLeadership }}\" hint-placeholder-val=\"{{ false }}\">\n                    <div style=\"font-size:10.5px;color:#9aa6b8;line-height:1.5;margin-top:2px;\">{{ cfgLeaderPhotoHint }}<\u002Fdiv>\n                  <\u002Fsc-if>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;margin-bottom:14px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:3px;\">Details<\u002Fdiv>\n              <div style=\"font-size:11px;color:#9aa6b8;margin-bottom:11px;\">Shown alongside the video on both surfaces.<\u002Fdiv>\n              <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:9px;\">\n                <div>\n                  <div style=\"font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#8a97ac;margin-bottom:5px;\">Name<\u002Fdiv>\n                  <input value=\"{{ cfgMsgName }}\" sc-camel-read-only=\"{{ cfgReadOnly }}\" placeholder=\"Name\" style=\"width:100%;height:38px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;font-weight:650;color:#16233f;outline:none;\">\n                <\u002Fdiv>\n                <div>\n                <div style=\"font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#8a97ac;margin-bottom:5px;\">Title<\u002Fdiv>\n                <sc-if value=\"{{ cfgIsLeadership }}\" hint-placeholder-val=\"{{ false }}\">\n                  <sc-raw-select value=\"{{ cfgMsgRole }}\" disabled=\"{{ cfgReadOnly }}\" style=\"width:100%;height:38px;padding:0 24px 0 11px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;color:#16233f;cursor:pointer;outline:none;\">\n                    <sc-for list=\"{{ cfgDesigOpts }}\" as=\"d\" hint-placeholder-count=\"5\"><option value=\"{{ d.id }}\">{{ d.label }}<\u002Foption><\u002Fsc-for>\n                  <\u002Fsc-raw-select>\n                <\u002Fsc-if>\n                <sc-if value=\"{{ cfgIsMsgPlain }}\" hint-placeholder-val=\"{{ true }}\">\n                  <input value=\"{{ cfgMsgRole }}\" sc-camel-on-input=\"{{ onMsgRole }}\" sc-camel-read-only=\"{{ cfgReadOnly }}\" placeholder=\"Title / role\" style=\"width:100%;height:38px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;font-weight:650;color:#16233f;outline:none;\" style-focus=\"border-color:#5e6ad2;\">\n                <\u002Fsc-if>\n                <\u002Fdiv>\n              <\u002Fdiv>\n              <div style=\"font-size:11px;font-weight:750;color:#16233f;margin-top:4px;\">Description<\u002Fdiv>\n              <textarea sc-camel-read-only=\"{{ cfgReadOnly }}\" placeholder=\"Message description…\" style=\"{{ cfgTextAreaMsg }}\">{{ cfgMsgDesc }}<\u002Ftextarea>\n            <\u002Fdiv>\n\n\n            <div style=\"background:#fff;border:1px solid #cdeede;border-radius:14px;overflow:hidden;margin-bottom:14px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;padding:13px 16px;background:#f4fbf7;border-bottom:1px solid #cdeede;\">\n                <div style=\"display:flex;align-items:center;gap:8px;\"><span style=\"font-size:14px;\">✅<\u002Fspan><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">{{ cfgMsgSecTitle }}<\u002Fdiv><\u002Fdiv>\n                <span style=\"font-size:11px;color:#5f9e7d;\">{{ cfgMsgSecHint }}<\u002Fspan>\n              <\u002Fdiv>\n              <sc-for list=\"{{ cfgMsgLive }}\" as=\"lm\" hint-placeholder-count=\"2\">\n                <div style=\"{{ lm.rowStyle }}\">\n                  <span style=\"width:40px;height:30px;flex:0 0 40px;border-radius:6px;background:linear-gradient(135deg,#dfe4f5,#c9d4e6);display:flex;align-items:center;justify-content:center;font-size:11px;color:#5a6b85;\">▶<\u002Fspan>\n                  <span style=\"flex:1;min-width:0;\"><span style=\"display:block;font-size:12px;font-weight:700;color:#16233f;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">{{ lm.name }}<\u002Fspan><span style=\"display:block;font-size:10.5px;color:#9aa6b8;\">{{ lm.meta }}<\u002Fspan><\u002Fspan>\n                  <span style=\"{{ lm.statusStyle }}\">{{ lm.statusLabel }}<\u002Fspan>\n                  <span style=\"display:flex;gap:5px;flex:0 0 auto;\">\n                    <button sc-camel-on-click=\"{{ lm.toggleWeb }}\" style=\"{{ lm.webStyle }}\">Web<\u002Fbutton>\n                    <button sc-camel-on-click=\"{{ lm.toggleApp }}\" style=\"{{ lm.appStyle }}\">App<\u002Fbutton>\n                  <\u002Fspan>\n                  <span style=\"display:flex;gap:4px;flex:0 0 auto;\">\n                    <button sc-camel-on-click=\"{{ lm.up }}\" style=\"{{ lm.upStyle }}\">↑<\u002Fbutton>\n                    <button sc-camel-on-click=\"{{ lm.down }}\" style=\"{{ lm.downStyle }}\">↓<\u002Fbutton>\n                  <\u002Fspan>\n                  <button sc-camel-on-click=\"{{ lm.toggle }}\" style=\"{{ lm.sw }}\"><span style=\"{{ lm.knob }}\"><\u002Fspan><\u002Fbutton>\n                  <button sc-camel-on-click=\"{{ lm.edit }}\" style=\"height:24px;padding:0 10px;border-radius:7px;border:none;background:transparent;color:#5e6ad2;font-weight:700;font-size:10.5px;cursor:pointer;\" style-hover=\"background:#eef0fc;\">Edit<\u002Fbutton>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n\n            <div style=\"display:flex;align-items:center;gap:11px;background:#fff;border:1px solid #eef1f6;border-radius:12px;padding:11px 14px;margin-bottom:14px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <span style=\"font-size:15px;\">🔗<\u002Fspan>\n              <div style=\"flex:1;min-width:0;\"><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Shared upload<\u002Fdiv><div style=\"font-size:11px;color:#9aa6b8;margin-top:1px;\">{{ cfgOneLabel }}<\u002Fdiv><\u002Fdiv>\n              <button sc-camel-on-click=\"{{ toggleOne }}\" style=\"{{ cfgOneSw }}\"><span style=\"{{ cfgOneKnob }}\"><\u002Fspan><\u002Fbutton>\n            <\u002Fdiv>\n\n            <sc-if value=\"{{ cfgOneOn }}\" hint-placeholder-val=\"{{ true }}\">\n              <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;margin-bottom:14px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n                <div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-bottom:11px;flex-wrap:wrap;\">\n                  <div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Video · app + web<\u002Fdiv>\n                  <span style=\"font-size:10px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;color:#5e6ad2;background:#eef0fc;border:1px solid #dcdff7;border-radius:6px;padding:2px 8px;\">Used on both<\u002Fspan>\n                <\u002Fdiv>\n                <div style=\"display:grid;grid-template-columns:1.4fr 1fr;gap:12px;align-items:start;\">\n                  <div style=\"{{ cfgVideoFrame }}\"><span style=\"font-size:20px;\">▶<\u002Fspan><button sc-camel-on-click=\"{{ upVideo }}\" style=\"height:29px;padding:0 13px;border-radius:8px;border:1px solid #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:11px;cursor:pointer;\">Upload video<\u002Fbutton><\u002Fdiv>\n                  <div style=\"{{ cfgFieldCol }}\">\n                    <div style=\"{{ cfgMsgAudio }}\"><span style=\"font-size:14px;\">🧑<\u002Fspan><span style=\"flex:1;font-size:11.5px;font-weight:650;color:#16233f;\">Portrait photo<\u002Fspan><button sc-camel-on-click=\"{{ upCover }}\" style=\"height:26px;padding:0 11px;border-radius:7px;border:1px solid rgba(16,35,63,.12);background:#f7f8fd;color:#5e6ad2;font-weight:700;font-size:10.5px;cursor:pointer;\">Upload<\u002Fbutton><\u002Fdiv>\n                    <input placeholder=\"Paste a video link instead\" sc-camel-read-only=\"{{ cfgReadOnly }}\" style=\"{{ cfgLinkInput }}\">\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <sc-if value=\"{{ cfgSplitUpload }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"display:flex;gap:12px;flex-wrap:wrap;\">\n              <sc-for list=\"{{ cfgSurfaceRows }}\" as=\"sr\" hint-placeholder-count=\"2\">\n                <div style=\"{{ sr.cardStyle }}\">\n                  <div style=\"display:flex;align-items:center;gap:8px;\"><span style=\"font-size:14px;\">{{ sr.icon }}<\u002Fspan><span style=\"font-size:11.5px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;{{ sr.accent }}\">{{ sr.label }}<\u002Fspan><\u002Fdiv>\n                  <div style=\"{{ cfgMsgVideo }}\"><span style=\"font-size:19px;\">▶<\u002Fspan><button style=\"height:27px;padding:0 12px;border-radius:8px;border:1px solid rgba(16,35,63,.16);background:#fff;color:#5e6ad2;font-weight:700;font-size:10.5px;cursor:pointer;\">Upload video<\u002Fbutton><\u002Fdiv>\n                  <div style=\"{{ cfgMsgAudio }}\"><span style=\"font-size:14px;\">🧑<\u002Fspan><span style=\"flex:1;font-size:11.5px;font-weight:650;color:#16233f;\">Portrait photo<\u002Fspan><button sc-camel-on-click=\"{{ upCover }}\" style=\"height:26px;padding:0 11px;border-radius:7px;border:1px solid rgba(16,35,63,.12);background:#f7f8fd;color:#5e6ad2;font-weight:700;font-size:10.5px;cursor:pointer;\">Upload image<\u002Fbutton><\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n            <\u002Fsc-if>\n          <\u002Fsc-if>\n\n\n          <sc-if value=\"{{ cfgIsPosts }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;flex-wrap:wrap;\">\n              <div><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Posts<\u002Fdiv><div style=\"font-size:11px;color:#9aa6b8;margin-top:2px;\">Drag to reorder · {{ blogCount }}<\u002Fdiv><\u002Fdiv>\n              <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ openBlogForm }}\" style=\"height:34px;padding:0 14px;border-radius:9px;border:1px dashed #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:12.5px;cursor:pointer;\">+ Add post<\u002Fbutton><\u002Fsc-if>\n            <\u002Fdiv>\n            <sc-if value=\"{{ blogFormOpen }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"background:#fff;border:1.5px solid #dcdff7;border-radius:13px;padding:13px 15px;margin-bottom:11px;box-shadow:0 4px 14px rgba(94,106,210,.12);\">\n                <div style=\"display:flex;align-items:center;gap:9px;margin-bottom:10px;\">\n                  <span style=\"font-size:14px;\">📝<\u002Fspan>\n                  <div style=\"flex:1;min-width:0;font-size:12.5px;font-weight:750;color:#16233f;\">New post<\u002Fdiv>\n                  <button sc-camel-on-click=\"{{ closeBlogForm }}\" style=\"width:26px;height:26px;border:none;background:#f2f5fa;border-radius:7px;color:#5a6b85;font-size:14px;cursor:pointer;\">×<\u002Fbutton>\n                <\u002Fdiv>\n                <div style=\"display:flex;gap:12px;align-items:flex-start;\">\n                  <div style=\"flex:0 0 160px;\">\n                    <div style=\"{{ blogFormCover }}\">\n                      <span style=\"font-size:18px;\">🖼️<\u002Fspan>\n                      <button sc-camel-on-click=\"{{ upBlogFormCover }}\" style=\"height:26px;padding:0 11px;border-radius:7px;border:1px solid #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:10.5px;cursor:pointer;\">{{ blogFormCoverBtn }}<\u002Fbutton>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                  <div style=\"flex:1;min-width:0;\">\n                    <input value=\"{{ blogT }}\" sc-camel-on-input=\"{{ onBlogT }}\" placeholder=\"Headline · e.g. What your HbA1c really tells you\" style=\"width:100%;height:38px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;font-weight:650;color:#16233f;outline:none;margin-bottom:8px;\" style-focus=\"border-color:#5e6ad2;\">\n                    <textarea value=\"{{ blogD }}\" sc-camel-on-input=\"{{ onBlogD }}\" placeholder=\"Short description shown under the headline…\" style=\"width:100%;min-height:70px;padding:10px 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;color:#3a4a63;outline:none;font-family:inherit;resize:vertical;\"><\u002Ftextarea>\n                    <div style=\"display:flex;gap:8px;align-items:center;margin-top:9px;flex-wrap:wrap;\">\n                      <sc-raw-select value=\"{{ blogPos }}\" sc-camel-on-change=\"{{ onBlogPos }}\" style=\"height:36px;padding:0 24px 0 10px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12px;font-weight:650;color:#16233f;cursor:pointer;outline:none;\">\n                        <sc-for list=\"{{ blogPosOpts }}\" as=\"o\" hint-placeholder-count=\"4\"><option value=\"{{ o.id }}\">{{ o.label }}<\u002Foption><\u002Fsc-for>\n                      <\u002Fsc-raw-select>\n                      <button sc-camel-on-click=\"{{ saveBlog }}\" style=\"height:36px;padding:0 16px;border-radius:9px;border:none;background:#5e6ad2;color:#fff;font-weight:700;font-size:12.5px;cursor:pointer;\">Add post<\u002Fbutton>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n            <div style=\"display:flex;flex-direction:column;gap:9px;\">\n              <sc-for list=\"{{ blogItems }}\" as=\"p\" hint-placeholder-count=\"3\">\n                <div draggable=\"{{ p.dragAttr }}\" sc-camel-on-drag-start=\"{{ p.onDragStart }}\" sc-camel-on-drag-over=\"{{ p.onDragOver }}\" sc-camel-on-drop=\"{{ p.onDrop }}\" style=\"{{ p.cardStyle }}\">\n                  <div style=\"{{ p.coverStyle }}\">\n                    <span style=\"font-size:16px;\">🖼️<\u002Fspan>\n                    <button sc-camel-on-click=\"{{ p.upCover }}\" style=\"height:22px;padding:0 9px;border-radius:6px;border:1px solid #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:9.5px;cursor:pointer;\">{{ p.coverBtn }}<\u002Fbutton>\n                  <\u002Fdiv>\n                  <div style=\"flex:1;min-width:0;\">\n                    <div style=\"display:flex;align-items:center;gap:9px;flex-wrap:wrap;\">\n                      <span style=\"font-size:11px;color:#c0c9d6;letter-spacing:-2px;flex:0 0 auto;\">⋮⋮<\u002Fspan>\n                      <span style=\"{{ p.slotStyle }}\">{{ p.slot }}<\u002Fspan>\n                      <div contenteditable=\"{{ p.editAttr }}\" style=\"{{ p.titleStyle }}\" style-focus=\"border-color:#5e6ad2;background:#fff;\">{{ p.title }}<\u002Fdiv>\n                      <span style=\"{{ p.statusStyle }}\">{{ p.statusLabel }}<\u002Fspan>\n                      <button sc-camel-on-click=\"{{ p.toggleOn }}\" title=\"Show or hide in the app\" style=\"{{ p.sw }}\"><span style=\"{{ p.knob }}\"><\u002Fspan><\u002Fbutton>\n                      <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\">\n                        <span style=\"display:flex;align-items:center;gap:5px;flex:0 0 auto;\">\n                          <button sc-camel-on-click=\"{{ p.toggleEdit }}\" style=\"{{ p.btnStyle }}\">{{ p.btnLabel }}<\u002Fbutton>\n                          <button sc-camel-on-click=\"{{ p.up }}\" style=\"width:22px;height:22px;border-radius:6px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-size:10px;cursor:pointer;\">↑<\u002Fbutton>\n                          <button sc-camel-on-click=\"{{ p.down }}\" style=\"width:22px;height:22px;border-radius:6px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-size:10px;cursor:pointer;\">↓<\u002Fbutton>\n                          <button sc-camel-on-click=\"{{ p.remove }}\" title=\"Remove\" style=\"border:none;background:transparent;color:#c7ccd6;cursor:pointer;font-size:14px;line-height:1;padding:0 2px;\" style-hover=\"color:#c0392b;\">×<\u002Fbutton>\n                        <\u002Fspan>\n                      <\u002Fsc-if>\n                    <\u002Fdiv>\n                    <div contenteditable=\"{{ p.editAttr }}\" sc-camel-on-blur=\"{{ p.onDesc }}\" style=\"{{ p.descStyle }}\" style-focus=\"border-color:#5e6ad2;background:#fff;\">{{ p.desc }}<\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsProse }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:11px;flex-wrap:wrap;\">\n                <div><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">{{ cfgTitle }}<\u002Fdiv><div style=\"font-size:11.5px;color:#9aa6b8;margin-top:2px;\">Write the copy as a paragraph or bullet points.<\u002Fdiv><\u002Fdiv>\n                <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ toggleProse }}\" style=\"{{ proseBtnStyle }}\">{{ proseBtnLabel }}<\u002Fbutton><\u002Fsc-if>\n              <\u002Fdiv>\n              <div contenteditable=\"{{ proseEditAttr }}\" sc-camel-on-blur=\"{{ onProseText }}\" style=\"{{ proseBoxStyle }}\" style-focus=\"border-color:#5e6ad2;\">{{ proseText }}<\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsFaq }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;flex-wrap:wrap;\">\n              <div><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Questions &amp; answers<\u002Fdiv><div style=\"font-size:11px;color:#9aa6b8;margin-top:2px;\">Drag to reorder · {{ faqCount }}<\u002Fdiv><\u002Fdiv>\n              <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ openFaqForm }}\" style=\"height:34px;padding:0 14px;border-radius:9px;border:1px dashed #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:12.5px;cursor:pointer;\">+ Add question<\u002Fbutton><\u002Fsc-if>\n            <\u002Fdiv>\n            <sc-if value=\"{{ faqFormOpen }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"background:#fff;border:1.5px solid #dcdff7;border-radius:13px;padding:13px 15px;margin-bottom:11px;box-shadow:0 4px 14px rgba(94,106,210,.12);\">\n                <div style=\"display:flex;align-items:center;gap:9px;margin-bottom:10px;\">\n                  <span style=\"font-size:14px;\">❓<\u002Fspan>\n                  <div style=\"flex:1;min-width:0;font-size:12.5px;font-weight:750;color:#16233f;\">New question<\u002Fdiv>\n                  <button sc-camel-on-click=\"{{ closeFaqForm }}\" style=\"width:26px;height:26px;border:none;background:#f2f5fa;border-radius:7px;color:#5a6b85;font-size:14px;cursor:pointer;\">×<\u002Fbutton>\n                <\u002Fdiv>\n                <input value=\"{{ faqQ }}\" sc-camel-on-input=\"{{ onFaqQ }}\" placeholder=\"Question · e.g. Can I switch my coach?\" style=\"width:100%;height:38px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;font-weight:650;color:#16233f;outline:none;margin-bottom:8px;\" style-focus=\"border-color:#5e6ad2;\">\n                <textarea value=\"{{ faqA }}\" sc-camel-on-input=\"{{ onFaqA }}\" placeholder=\"Answer shown in the app…\" style=\"width:100%;min-height:70px;padding:10px 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;color:#3a4a63;outline:none;font-family:inherit;resize:vertical;\"><\u002Ftextarea>\n                <button sc-camel-on-click=\"{{ saveFaq }}\" style=\"margin-top:9px;height:36px;padding:0 16px;border-radius:9px;border:none;background:#5e6ad2;color:#fff;font-weight:700;font-size:12.5px;cursor:pointer;\">Add question<\u002Fbutton>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n            <div style=\"display:flex;flex-direction:column;gap:9px;\">\n              <sc-for list=\"{{ faqItems }}\" as=\"f\" hint-placeholder-count=\"4\">\n                <div draggable=\"{{ f.dragAttr }}\" sc-camel-on-drag-start=\"{{ f.onDragStart }}\" sc-camel-on-drag-over=\"{{ f.onDragOver }}\" sc-camel-on-drop=\"{{ f.onDrop }}\" style=\"{{ f.cardStyle }}\">\n                  <div style=\"display:flex;align-items:center;gap:9px;\">\n                    <span style=\"font-size:11px;color:#c0c9d6;letter-spacing:-2px;flex:0 0 auto;\">⋮⋮<\u002Fspan>\n                    <span style=\"font-size:10px;color:#b0bacb;font-variant-numeric:tabular-nums;flex:0 0 auto;\">Q{{ f.num }}<\u002Fspan>\n                    <div contenteditable=\"{{ f.editAttr }}\" style=\"{{ f.qStyle }}\" style-focus=\"border-color:#5e6ad2;background:#fff;\">{{ f.q }}<\u002Fdiv>\n                    <span style=\"{{ f.statusStyle }}\">{{ f.statusLabel }}<\u002Fspan>\n                    <button sc-camel-on-click=\"{{ f.toggleOn }}\" title=\"Show or hide in the app\" style=\"{{ f.sw }}\"><span style=\"{{ f.knob }}\"><\u002Fspan><\u002Fbutton>\n                    <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\">\n                      <span style=\"display:flex;align-items:center;gap:5px;flex:0 0 auto;\">\n                        <button sc-camel-on-click=\"{{ f.toggleEdit }}\" style=\"{{ f.btnStyle }}\">{{ f.btnLabel }}<\u002Fbutton>\n                        <button sc-camel-on-click=\"{{ f.up }}\" style=\"width:22px;height:22px;border-radius:6px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-size:10px;cursor:pointer;\">↑<\u002Fbutton>\n                        <button sc-camel-on-click=\"{{ f.down }}\" style=\"width:22px;height:22px;border-radius:6px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-size:10px;cursor:pointer;\">↓<\u002Fbutton>\n                        <button sc-camel-on-click=\"{{ f.remove }}\" title=\"Remove\" style=\"border:none;background:transparent;color:#c7ccd6;cursor:pointer;font-size:14px;line-height:1;padding:0 2px;\" style-hover=\"color:#c0392b;\">×<\u002Fbutton>\n                      <\u002Fspan>\n                    <\u002Fsc-if>\n                  <\u002Fdiv>\n                  <div contenteditable=\"{{ f.editAttr }}\" sc-camel-on-blur=\"{{ f.onAnswer }}\" style=\"{{ f.aStyle }}\" style-focus=\"border-color:#5e6ad2;background:#fff;\">{{ f.a }}<\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsDietBook }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:9px;margin-bottom:3px;flex-wrap:wrap;\">\n                <div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Diet plan book<\u002Fdiv>\n                <span style=\"font-size:11px;color:#9aa6b8;\">{{ cfgDpCount }}<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"font-size:11.5px;color:#9aa6b8;margin-bottom:12px;\">{{ cfgDpNote }}<\u002Fdiv>\n\n              <div style=\"display:grid;grid-template-columns:repeat(2,1fr);gap:10px;\">\n                <sc-for list=\"{{ cfgDpCards }}\" as=\"d\" hint-placeholder-count=\"4\">\n                  <button sc-camel-on-click=\"{{ d.open }}\" style=\"{{ d.cardStyle }}\" style-hover=\"box-shadow:0 5px 14px rgba(16,35,63,.12);\">\n                    <span style=\"display:flex;align-items:center;gap:8px;width:100%;\">\n                      <span style=\"flex:1;min-width:0;font-size:13px;font-weight:750;color:#16233f;\">{{ d.name }}<\u002Fspan>\n                      <span style=\"{{ d.statusStyle }}\">{{ d.statusLabel }}<\u002Fspan>\n                    <\u002Fspan>\n                    <span style=\"font-size:11.5px;color:#8a97ac;line-height:1.5;text-wrap:pretty;\">{{ d.excerpt }}<\u002Fspan>\n                    <span style=\"font-size:10px;color:#b6c1d1;\">{{ d.words }}<\u002Fspan>\n                  <\u002Fbutton>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n\n            <sc-if value=\"{{ cfgDpEdit }}\" hint-placeholder-val=\"{{ true }}\">\n              <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;margin-top:14px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n                <div style=\"display:flex;align-items:center;gap:10px;flex-wrap:wrap;\">\n                  <div style=\"flex:1;min-width:200px;\">\n                    <div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Add a diet plan<\u002Fdiv>\n                    <div style=\"font-size:11.5px;color:#9aa6b8;margin-top:2px;\">Name it, write it out, and it joins the book for every coach.<\u002Fdiv>\n                  <\u002Fdiv>\n                  <sc-if value=\"{{ cfgDpFormClosed }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ openCfgDpForm }}\" style=\"height:36px;padding:0 15px;border-radius:9px;border:1px dashed #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:12.5px;cursor:pointer;\">+ New diet plan<\u002Fbutton><\u002Fsc-if>\n                <\u002Fdiv>\n                <sc-if value=\"{{ cfgDpFormOpen }}\" hint-placeholder-val=\"{{ false }}\">\n                  <div style=\"margin-top:12px;display:flex;flex-direction:column;gap:9px;\">\n                    <input value=\"{{ cfgDpDraftName }}\" sc-camel-on-input=\"{{ onCfgDpDraftName }}\" placeholder=\"Plan name · e.g. Thyroid care · 14 day\" style=\"height:38px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:13px;font-weight:650;color:#16233f;outline:none;\" style-focus=\"border-color:#5e6ad2;\">\n                    <div contenteditable=\"true\" sc-camel-on-blur=\"{{ onCfgDpDraftBody }}\" style=\"min-height:120px;padding:11px 13px;border:1px solid #e6ebf2;border-radius:10px;background:#fbfcff;font-size:12.5px;color:#3a4a63;line-height:1.7;text-wrap:pretty;outline:none;\" style-focus=\"border-color:#5e6ad2;background:#fff;\"><\u002Fdiv>\n                    <div style=\"display:flex;gap:7px;\">\n                      <button sc-camel-on-click=\"{{ saveCfgDp }}\" style=\"height:36px;padding:0 15px;border-radius:9px;border:none;background:#5e6ad2;color:#fff;font-weight:700;font-size:12.5px;cursor:pointer;\">Add to book<\u002Fbutton>\n                      <button sc-camel-on-click=\"{{ closeCfgDpForm }}\" style=\"height:36px;padding:0 13px;border-radius:9px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-weight:650;font-size:12.5px;cursor:pointer;\">Cancel<\u002Fbutton>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-if>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <sc-if value=\"{{ cfgDpOpen }}\" hint-placeholder-val=\"{{ false }}\">\n              <div sc-camel-on-click=\"{{ closeCfgDp }}\" style=\"position:fixed;inset:0;background:rgba(16,35,63,.42);backdrop-filter:blur(2px);z-index:80;display:flex;align-items:center;justify-content:center;padding:28px;animation:fadein .16s ease;\">\n                <div sc-camel-on-click=\"{{ cfgDpStop }}\" style=\"width:640px;max-width:94vw;max-height:82vh;background:#fff;border-radius:16px;box-shadow:0 24px 60px rgba(16,35,63,.28);display:flex;flex-direction:column;overflow:hidden;\">\n                  <div style=\"display:flex;align-items:center;gap:10px;padding:15px 18px;border-bottom:1px solid #eef1f6;flex-wrap:wrap;\">\n                    <div style=\"flex:1;min-width:0;\">\n                      <div style=\"font-size:15px;font-weight:750;color:#16233f;letter-spacing:-.01em;\">{{ cfgDpName }}<\u002Fdiv>\n                      <div style=\"font-size:11px;color:#9aa6b8;margin-top:2px;\">Diet plan · master book<\u002Fdiv>\n                    <\u002Fdiv>\