2px rgba(16,35,63,.04);\">\n              <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 15px;background:#fdf9ee;border-bottom:1px solid #f2e2a8;\">\n                <div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">{{ staffPermQueueTitle }}<\u002Fdiv>\n                <span style=\"font-size:11px;font-weight:700;color:#9a7a00;\">{{ staffPermQueueCount }}<\u002Fspan>\n              <\u002Fdiv>\n              <sc-for list=\"{{ staffPermQueue }}\" as=\"q\" hint-placeholder-count=\"2\">\n                <div style=\"display:flex;align-items:center;gap:10px;padding:11px 15px;border-bottom:1px solid #f4f6fa;flex-wrap:wrap;\">\n                  <div style=\"flex:1 1 200px;min-width:0;\">\n                    <div style=\"font-size:12.5px;font-weight:700;color:#16233f;\">{{ q.what }}<\u002Fdiv>\n                    <div style=\"font-size:11px;color:#9aa6b8;margin-top:2px;\">{{ q.member }} · {{ q.role }} · requested by {{ q.by }} on {{ q.when }}<\u002Fdiv>\n                  <\u002Fdiv>\n                  <span style=\"{{ q.statusStyle }}\">{{ q.statusLabel }}<\u002Fspan>\n                  <sc-if value=\"{{ q.pending }}\" hint-placeholder-val=\"{{ true }}\">\n                    <sc-if value=\"{{ staffPermVisible }}\" hint-placeholder-val=\"{{ true }}\">\n                      <sc-if value=\"{{ editable }}\" hint-placeholder-val=\"{{ true }}\">\n                        <span style=\"display:flex;gap:6px;flex:0 0 auto;\">\n                          <button sc-camel-on-click=\"{{ q.approve }}\" style=\"height:30px;padding:0 12px;border-radius:8px;border:none;background:#2b8f5b;color:#fff;font-weight:650;font-size:11.5px;cursor:pointer;\">Approve<\u002Fbutton>\n                          <button sc-camel-on-click=\"{{ q.reject }}\" style=\"height:30px;padding:0 12px;border-radius:8px;border:1px solid #f6d0d1;background:#fff;color:#c0392b;font-weight:650;font-size:11.5px;cursor:pointer;\">Reject<\u002Fbutton>\n                        <\u002Fspan>\n                      <\u002Fsc-if>\n                    <\u002Fsc-if>\n                  <\u002Fsc-if>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n          <sc-if value=\"{{ staffPermOpen }}\" hint-placeholder-val=\"{{ true }}\">\n          <div style=\"background:#fff;border:1px solid #e6ebf2;border-radius:12px;overflow:hidden;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n            <div style=\"display:grid;grid-template-columns:1.7fr repeat(7,52px) 52px;gap:6px;padding:11px 16px;background:#f7f9fc;border-bottom:1px solid #eef1f6;\">\n              <div style=\"font-size:10.5px;font-weight:700;letter-spacing:.04em;color:#8a97ac;text-transform:uppercase;\">Feature<\u002Fdiv>\n              <sc-for list=\"{{ permActCols }}\" as=\"a\" hint-placeholder-count=\"7\"><div style=\"font-size:9.5px;font-weight:700;letter-spacing:.03em;color:#8a97ac;text-transform:uppercase;text-align:center;\">{{ a.label }}<\u002Fdiv><\u002Fsc-for>\n              <div style=\"font-size:9.5px;font-weight:700;color:#8a97ac;text-transform:uppercase;text-align:right;\">On<\u002Fdiv>\n            <\u002Fdiv>\n            <sc-for list=\"{{ staffPermGroups }}\" as=\"g\" hint-placeholder-count=\"6\">\n              <div style=\"padding:8px 16px 4px;background:#fbfcfe;border-bottom:1px solid #f1f4f9;font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#5e6ad2;\">{{ g.name }}<\u002Fdiv>\n              <sc-for list=\"{{ g.rows }}\" as=\"r\" hint-placeholder-count=\"3\">\n                <div style=\"display:grid;grid-template-columns:1.7fr repeat(7,52px) 52px;gap:6px;padding:10px 16px;border-bottom:1px solid #f4f6fa;align-items:center;\">\n                  <div style=\"font-size:12.5px;font-weight:600;color:#16233f;min-width:0;line-height:1.3;\">{{ r.label }}<\u002Fdiv>\n                  <sc-for list=\"{{ r.cells }}\" as=\"c\" hint-placeholder-count=\"7\">\n            