veLink }}\" style=\"height:36px;padding:0 15px;border-radius:9px;border:none;background:#5e6ad2;color:#fff;font-weight:700;font-size:12.5px;cursor:pointer;white-space:nowrap;\">Add link<\u002Fbutton>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-if>\n              <div style=\"display:flex;flex-direction:column;gap:8px;\">\n                <sc-for list=\"{{ cfgLinkRows }}\" as=\"l\" hint-placeholder-count=\"5\">\n                  <div style=\"display:flex;align-items:center;gap:11px;background:#fbfcfe;border:1px solid #eef1f6;border-radius:11px;padding:10px 12px;\">\n                    <span style=\"width:30px;height:30px;flex:0 0 30px;border-radius:8px;background:#eef0fc;display:flex;align-items:center;justify-content:center;font-size:13px;\">{{ l.icon }}<\u002Fspan>\n                    <span style=\"flex:0 0 92px;font-size:12px;font-weight:700;color:#16233f;\">{{ l.name }}<\u002Fspan>\n                    <div contenteditable=\"{{ l.rowEditAttr }}\" style=\"{{ l.urlStyle }}\" style-focus=\"border-color:#5e6ad2;background:#fff;\">{{ l.url }}<\u002Fdiv>\n                    <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\">\n                      <span style=\"display:flex;align-items:center;gap:6px;flex:0 0 auto;\">\n                        <button sc-camel-on-click=\"{{ l.toggleEdit }}\" style=\"{{ l.btnStyle }}\">{{ l.btnLabel }}<\u002Fbutton>\n                        <button sc-camel-on-click=\"{{ l.removeLink }}\" title=\"Remove link\" style=\"border:none;background:transparent;color:#c7ccd6;cursor:pointer;font-size:14px;line-height:1;padding:0 2px;\" style-hover=\"color:#c0392b;\">×<\u002Fbutton>\n                      <\u002Fspan>\n                    <\u002Fsc-if>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsContact }}\" hint-placeholder-val=\"{{ false }}\">\n         