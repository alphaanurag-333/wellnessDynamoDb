\">One row per wellness coach. Click a row to open that coach's video.<\u002Fdiv>\n                <div style=\"border:1px solid #eef1f6;border-radius:11px;overflow:hidden;\">\n                  <div style=\"display:grid;grid-template-columns:112px 1.3fr 0.8fr 1.6fr 96px;gap:12px;padding:9px 14px;background:#fbfcfe;border-bottom:1px solid #eef1f6;font-size:10px;font-weight:700;letter-spacing:.05em;color:#8a97ac;text-transform:uppercase;\"><div>Tag<\u002Fdiv><div>Coach<\u002Fdiv><div>Reaches<\u002Fdiv><div>Video<\u002Fdiv><div>Status<\u002Fdiv><\u002Fdiv>\n                  <sc-for list=\"{{ ovRows }}\" as=\"o\" hint-placeholder-count=\"10\">\n                    <div sc-camel-on-click=\"{{ o.pick }}\" style=\"{{ o.rowStyle }}\">\n                      <div style=\"{{ o.codeStyle }}\">{{ o.code }}<\u002Fdiv>\n                      <div style=\"font-size:12.5px;font-weight:650;color:#16233f;\">{{ o.coach }}<\u002Fdiv>\n                      <div style=\"font-size:11.5px;color:#8a97ac;font-variant-numeric:tabular-nums;\">{{ o.clients }}<\u002Fdiv>\n                      <div style=\"{{ o.titleStyle }}\">{{ o.title }} · {{ o.dur }}<\u002Fdiv>\n                      <div><span style=\"{{ o.statusStyle }}\">{{ o.status }}<\u002Fspan><\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fsc-for>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsMedia }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:11px;flex-wrap:wrap;\">\n                <sc-if value=\"{{ libMulti }}\" hint-placeholder-val=\"{{ true }}\">\n                  <div><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Library items<\u002Fdiv><div style=\"font-size:11.5px;color:#9aa6b8;margin-top:2px;\">Admin and Support upload · coaches choose what each client sees.<\u002Fdiv><\u002Fdiv>\n                <\u002Fsc-if>\n                <sc-if value=\"{{ libSingle }}\" hint-placeholder-val=\"{{ false }}\">\n                  <div><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">{{ libSingleTitle }}<\u002Fdiv><div style=\"font-size:11.5px;color:#9aa6b8;margin-top:2px;\">{{ libSingleSub }}<\u002Fdiv><\u002Fdiv>\n                <\u002Fsc-if>\n                <sc-if value=\"{{ libMulti }}\" hint-placeholder-val=\"{{ true }}\"><sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ openLibForm }}\" style=\"height:34px;padding:0 14px;border-radius:9px;border:1px dashed #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:12.5px;cursor:pointer;\">+ Add item<\u002Fbutton><\u002Fsc-if><\u002Fsc-if>\n              <\u002Fdiv>\n              <sc-if value=\"{{ libFormOpen }}\" hint-placeholder-val=\"{{ false }}\">\n                <div style=\"background:#fff;border:1.5px solid #dcdff7;border-radius:13px;padding:13px 15px;margin-bottom:11px;box-shadow:0 4px 14px rgba(94,106,210,.12);\">\n                  <div style=\"display:flex;align-items:center;gap:9px;margin-bottom:10px;\">\n                    <span style=\"font-size:14px;\">🎬<\u002Fspan>\n                    <div style=\"flex:1;min-width:0;font-size:12.5px;font-weight:750;color:#16233f;\">New library item<\u002Fdiv>\n                    <button sc-camel-on-click=\"{{ closeLibForm }}\" style=\"width:26px;height:26px;border:none;background:#f2f5fa;border-radius:7px;color:#5a6b85;font-size:14px;cursor:pointer;\">×<\u002Fbutton>\n                  <\u002Fdiv>\n                  <div style=\"display:flex;gap:12px;align-items:flex-start;\">\n                    <div style=\"flex:0 0 150px;display:flex;flex-direction:column;gap:8px;\">\n                      <div style=\"{{ libCoverFrame }}\">\n                        <span style=\"font-size:18px;\">🖼️<\u002Fspan>\n                        <button sc-camel-on-click=\"{{ upLibCover }}\" style=\"height:26px;padding:0 11px;border-radius:7px;border:1px solid #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:10.5px;cursor:pointer;\">{{ libCoverBtn }}<\u002Fbutton>\n                      <\u002Fdiv>\n                      <div style=\"{{ libVideoFrame }}\">\n                        <span style=\"font-size:15px;\">▶<\u002Fspan>\n                        <button sc-camel-on-click=\"{{ upLibVideo }}\" style=\"height:26px;padding:0 11px;border-radius:7px;border:1px solid #dcdff7;background:#fff;color:#5e6ad2;font-weight:700;font-size:10.5px;cursor:pointer;\">{{ libVideoBtn }}<\u002Fbutton>\n                      <\u002Fdiv>\n                    <\u002Fdiv>\n                    <div style=\"flex:1;min-width:0;\">\n                      <sc-raw-select value=\"{{ libNewCat }}\" sc-camel-on-change=\"{{ onLibNewCat }}\" style=\"width:100%;height:36px;padding:0 24px 0 10px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12px;font-weight:650;color:#c2661d;cursor:pointer;outline:none;margin-bottom:8px;\">\n                    <sc-for list=\"{{ libCatOpts }}\" as=\"c\" hint-placeholder-count=\"4\"><option value=\"{{ c.id }}\">{{ c.label }}<\u002Foption><\u002Fsc-for>\n                  <\u002Fsc-raw-select>\n                  <input value=\"{{ libT }}\" sc-camel-on-input=\"{{ onLibT }}\" placeholder=\"Title · e.g. Ragi dosa · high fibre\" style=\"width:100%;height:38px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;font-weight:650;color:#16233f;outline:none;margin-bottom:8px;\" style-focus=\"border-color:#5e6ad2;\">\n                      <textarea value=\"{{ libD }}\" sc-camel-on-input=\"{{ onLibD }}\" placeholder=\"Recipe description shown in the app…\" style=\"width:100%;min-height:78px;padding:10px 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;color:#3a4a63;outline:none;font-family:inherit;resize:vertical;\"><\u002Ftextarea>\n                      <input value=\"{{ libLink }}\" sc-camel-on-input=\"{{ onLibLink }}\" placeholder=\"Or paste a video link · youtube.com/…\" style=\"width:100%;height:36px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12px;color:#5e6ad2;outline:none;margin-top:8px;\" style-focus=\"border-color:#5e6ad2;\">\n                      <button sc-camel-on-click=\"{{ saveLib }}\" style=\"margin-top:9px;height:36px;padding:0 16px;border-radius:9px;border:none;background:#5e6ad2;color:#fff;font-weight:700;font-size:12.5px;cursor:pointer;\">Add item<\u002Fbutton>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-if>\n              <sc-if value=\"{{ libMulti }}\" hint-placeholder-val=\"{{ true }}\"><div style=\"font-size:11px;color:#9aa6b8;margin-bottom:9px;\">Drag to reorder · {{ cfgLibCount }}<\u002Fdiv><\u002Fsc-if>\n              <sc-if value=\"{{ libSingle }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"font-size:11px;color:#9aa6b8;margin-bottom:9px;\">One video only — uploading a new cover or video replaces what is live.<\u002Fdiv><\u002Fsc-if>\n              <div style=\"display:flex;flex-direction:column;gap:9px;\">\n                <sc-for list=\"{{ cfgLibItems }}\" as=\"m\" hint-placeholder-count=\"4\">\n                  <div draggable=\"{{ m.dragAttr }}\" sc-camel-on-drag-start=\"{{ m.onDragStart }}\" sc-camel-on-drag-over=\"{{ m.onDragOver }}\" sc-camel-on-drop=\"{{ m.onDrop }}\" style=\"{{ m.cardStyle }}\">\n                    <div style=\"{{ m.coverStyle }}\">\n                      <span>▶<\u002Fspan>\n                      <button sc-camel-on-click=\"{{ m.upCover }}\" style=\"height:20px;padding:0 8px;border-radius:6px;border:none;background:rgba(255,255,255,.9);color:#16233f;font-weight:700;font-size:9px;cursor:pointer;\">Cover<\u002Fbutton>\n                    <\u002Fdiv>\n                    <div style=\"flex:1;min-width:0;\">\n                      <div style=\"display:flex;align-items:center;gap:9px;\">\n                        <span style=\"font-size:11px;color:#c0c9d6;letter-spacing:-2px;flex:0 0 auto;\">⋮⋮<\u002Fspan>\n                        <div contenteditable=\"{{ m.editAttr }}\" style=\"{{ m.titleStyle }}\" style-focus=\"border-color:#5e6ad2;background:#fff;\">{{ m.name }}<\u002Fdiv>\n                        <sc-if value=\"{{ m.showCatEdit }}\" hint-placeholder-val=\"{{ false }}\">\n                          <sc-raw-select value=\"{{ m.cat }}\" sc-camel-on-change=\"{{ m.onCat }}\" style=\"height:24px;padding:0 20px 0 7px;border:1px solid #f6dcc4;border-radius:6px;background:#fff4ee;font-size:10px;font-weight:700;color:#c2661d;cursor:pointer;outline:none;\">\n                            <sc-for list=\"{{ m.catOpts }}\" as=\"c\" hint-placeholder-count=\"4\"><option value=\"{{ c.id }}\">{{ c.label }}<\u002Foption><\u002Fsc-for>\n                          <\u002Fsc-raw-select>\n                        <\u002Fsc-if>\n                        <sc-if value=\"{{ m.showCatChip }}\" hint-placeholder-val=\"{{ true }}\"><span style=\"{{ m.catStyle }}\">{{ m.cat }}<\u002Fspan><\u002Fsc-if>\n                        <span style=\"{{ m.typeStyle }}\">{{ m.type }}<\u002Fspan>\n                        <span style=\"font-size:10.5px;color:#9aa6b8;white-space:nowrap;\">{{ m.meta }}<\u002Fspan>\n                        <span style=\"{{ m.statusStyle }}\">{{ m.statusLabel }}<\u002Fspan>\n                        <button sc-camel-on-click=\"{{ m.toggleOn }}\" title=\"Show or hide in the app\" style=\"{{ m.sw }}\"><span style=\"{{ m.knob }}\"><\u002Fspan><\u002Fbutton>\n                        <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\">\n                          <span style=\"display:flex;align-items:center;gap:5px;flex:0 0 auto;\">\n                            <button sc-camel-on-click=\"{{ m.upVideo }}\" style=\"height:26px;padding:0 10px;border-radius:7px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-weight:700;font-size:10.5px;cursor:pointer;\">Video<\u002Fbutton>\n                            <button sc-camel-on-click=\"{{ m.setLink }}\" title=\"Use a link instead of an upload\" style=\"{{ m.linkBtnStyle }}\">{{ m.linkBtnLabel }}<\u002Fbutton>\n                            <button sc-camel-on-click=\"{{ m.toggleEdit }}\" style=\"{{ m.btnStyle }}\">{{ m.btnLabel }}<\u002Fbutton>\n                            <sc-if value=\"{{ m.showOrder }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ m.up }}\" style=\"width:22px;height:22px;border-radius:6px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-size:10px;cursor:pointer;\">↑<\u002Fbutton><\u002Fsc-if>\n                            <sc-if value=\"{{ m.showOrder }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ m.down }}\" style=\"width:22px;height:22px;border-radius:6px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-size:10px;cursor:pointer;\">↓<\u002Fbutton><\u002Fsc-if>\n                            <sc-if value=\"{{ m.showOrder }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ m.remove }}\" title=\"Remove\" style=\"border:none;background:transparent;color:#c7ccd6;cursor:pointer;font-size:14px;line-height:1;padding:0 2px;\" style-hover=\"color:#c0392b;\">×<\u002Fbutton><\u002Fsc-if>\n                          <\u002Fspan>\n                        <\u002Fsc-if>\n                      <\u002Fdiv>\n                      <div contenteditable=\"{{ m.editAttr }}\" sc-camel-on-blur=\"{{ m.onDesc }}\" style=\"{{ m.descStyle }}\" style-focus=\"border-color:#5e6ad2;background:#fff;\">{{ m.desc }}<\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ measShow }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;margin-top:14px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:3px;flex-wrap:wrap;\">\n                <div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Internal parameters<\u002Fdiv>\n                <span style=\"font-size:11px;color:#9aa6b8;\">{{ measCount }}<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"font-size:11.5px;color:#9aa6b8;margin-bottom:12px;\">Reference images shown beside each measurement in the app. Images only — nothing else is editable.<\u002Fdiv>\n              <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\">\n                <div style=\"display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap;\">\n                  <input value=\"{{ measDraft }}\" sc-camel-on-input=\"{{ onMeasDraft }}\" placeholder=\"Add a parameter · e.g. Calves\" style=\"flex:1;min-width:180px;height:36px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12px;color:#16233f;outline:none;\" style-focus=\"border-color:#5e6ad2;\">\n                  <button sc-camel-on-click=\"{{ addMeas }}\" style=\"height:36px;padding:0 15px;border-radius:9px;border:none;background:#5e6ad2;color:#fff;font-weight:700;font-size:12px;cursor:pointer;\">+ Add parameter<\u002Fbutton>\n                <\u002Fdiv>\n              <\u002Fsc-if>\n              <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:10px;\">\n                <sc-for list=\"{{ measItems }}\" as=\"mp\" hint-placeholder-count=\"6\">\n                  <div style=\"{{ mp.cardStyle }}\">\n                    <div style=\"{{ mp.imgStyle }}\">\n                      <span>🧍<\u002Fspan>\n                      <button sc-camel-on-click=\"{{ mp.upImg }}\" style=\"height:24px;padding:0 10px;border-radius:7px;border:1px solid #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:10px;cursor:pointer;\">{{ mp.btnLabel }}<\u002Fbutton>\n                    <\u002Fdiv>\n                    <div style=\"display:flex;align-items:center;gap:7px;\">\n                      <span style=\"flex:1;min-width:0;font-size:12px;font-weight:700;color:#16233f;\">{{ mp.name }}<\u002Fspan>\n                      <span style=\"{{ mp.statusStyle }}\">{{ mp.statusLabel }}<\u002Fspan>\n                    <\u002Fdiv>\n                    <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\">\n                      <div style=\"display:flex;align-items:center;gap:7px;\">\n                        <button sc-camel-on-click=\"{{ mp.toggleOn }}\" title=\"Show or hide in the app\" style=\"{{ mp.sw }}\"><span style=\"{{ mp.knob }}\"><\u002Fspan><\u002Fbutton>\n                        <sc-if value=\"{{ mp.canRemove }}\" hint-placeholder-val=\"{{ false }}\"><button sc-camel-on-click=\"{{ mp.remove }}\" title=\"Remove\" style=\"border:none;background:transparent;color:#c7ccd6;cursor:pointer;font-size:14px;line-height:1;margin-left:auto;padding:0 2px;\" style-hover=\"color:#c0392b;\">×<\u002Fbutton><\u002Fsc-if>\n                      <\u002Fdiv>\n                    <\u002Fsc-if>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsNutBank }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:3px;\">Nutrition bank<\u002Fdiv>\n              <div style=\"font-size:11.5px;color:#9aa6b8;margin-bottom:12px;\">Admin and Support maintain pricing. Coaches pick supplements from this bank for a client.<\u002Fdiv>\n              <div style=\"border:1px solid #eef1f6;border-radius:11px;overflow:hidden;\">\n                <div style=\"display:grid;gap:10px;padding:9px 14px;background:#fbfcfe;border-bottom:1px solid #eef1f6;font-size:10px;font-weight:700;letter-spacing:.05em;color:#8a97ac;text-transform:uppercase;grid-template-columns:1.7fr .9fr 1fr 34px;\"><div>Supplement<\u002Fdiv><div>Pack<\u002Fdiv><div style=\"text-align:right;\">Bottle (Rs.)<\u002Fdiv><div><\u002Fdiv><\u002Fdiv>\n                <sc-for list=\"{{ cfgNutBank }}\" as=\"x\" hint-placeholder-count=\"4\">\n                  <div style=\"display:grid;gap:10px;padding:11px 14px;border-bottom:1px solid #f4f6fa;align-items:center;grid-template-columns:1.7fr .9fr 1fr 34px;\">\n                    <div contenteditable=\"{{ x.editAttr }}\" sc-camel-on-blur=\"{{ x.onName }}\" style=\"font-size:12.5px;font-weight:650;color:#16233f;outline:none;border-radius:6px;padding:2px 6px;border:1px dashed transparent;\" style-focus=\"border-color:#5e6ad2;background:#fbfcff;\">{{ x.name }}<\u002Fdiv>\n                    <div contenteditable=\"{{ x.editAttr }}\" sc-camel-on-blur=\"{{ x.onPack }}\" style=\"font-size:11.5px;color:#5a6b85;outline:none;border-radius:6px;padding:2px 6px;border:1px dashed transparent;\" style-focus=\"border-color:#5e6ad2;background:#fbfcff;\">{{ x.pack }}<\u002Fdiv>\n                    <div contenteditable=\"{{ x.editAttr }}\" sc-camel-on-blur=\"{{ x.onBottle }}\" style=\"font-size:12.5px;font-weight:650;color:#16233f;outline:none;border-radius:6px;padding:2px 6px;border:1px dashed transparent;text-align:right;font-variant-numeric:tabular-nums;\" style-focus=\"border-color:#5e6ad2;background:#fbfcff;\">{{ x.bottle }}<\u002Fdiv>\n                    <div style=\"display:flex;justify-content:flex-end;\">\n                      <sc-if value=\"{{ x.canRemove }}\" hint-placeholder-val=\"{{ false }}\"><button sc-camel-on-click=\"{{ x.remove }}\" title=\"Remove\" style=\"border:none;background:transparent;color:#c7ccd6;cursor:pointer;font-size:15px;line-height:1;padding:0 2px;\" style-hover=\"color:#c0392b;\">×<\u002Fbutton><\u002Fsc-if>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n              <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\">\n                <div style=\"display:flex;gap:8px;margin-top:12px;flex-wrap:wrap;\">\n                  <input value=\"{{ nbName }}\" sc-camel-on-input=\"{{ onNbName }}\" placeholder=\"Supplement name\" style=\"flex:1 1 200px;min-width:160px;height:36px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12px;color:#16233f;outline:none;\" style-focus=\"border-color:#5e6ad2;\">\n                  <input value=\"{{ nbPack }}\" sc-camel-on-input=\"{{ onNbPack }}\" placeholder=\"Pack · e.g. 60 caps\" style=\"flex:0 0 150px;height:36px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12px;color:#16233f;outline:none;\" style-focus=\"border-color:#5e6ad2;\">\n                  <input value=\"{{ nbPrice }}\" sc-camel-on-input=\"{{ onNbPrice }}\" placeholder=\"Bottle (Rs.)\" style=\"flex:0 0 130px;height:36px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12px;color:#16233f;outline:none;font-variant-numeric:tabular-nums;\" style-focus=\"border-color:#5e6ad2;\">\n                  <button sc-camel-on-click=\"{{ addNb }}\" style=\"height:36px;padding:0 15px;border-radius:9px;border:none;background:#5e6ad2;color:#fff;font-weight:700;font-size:12px;cursor:pointer;\">+ Add supplement<\u002Fbutton>\n                <\u002Fdiv>\n              <\u002Fsc-if>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsHpBank }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:3px;\">Program → health-progress mapping<\u002Fdiv>\n              <div style=\"font-size:11.5px;color:#9aa6b8;margin-bottom:12px;\">When a client joins a program these metrics trigger automatically. WC and AWC can override per client.<\u002Fdiv>\n              <div style=\"border:1px solid #eef1f6;border-radius:11px;overflow:hidden;\">\n                <div style=\"display:grid;gap:10px;padding:9px 14px;background:#fbfcfe;border-bottom:1px solid #eef1f6;font-size:10px;font-weight:700;letter-spacing:.05em;color:#8a97ac;text-transform:uppercase;grid-template-columns:1fr 2fr;\"><div>Program<\u002Fdiv><div>Metrics triggered<\u002Fdiv><\u002Fdiv>\n                <sc-for list=\"{{ cfgHpMap }}\" as=\"h\" hint-placeholder-count=\"5\">\n                  <div style=\"display:grid;gap:10px;padding:11px 14px;border-bottom:1px solid #f4f6fa;align-items:center;grid-template-columns:1fr 2fr;\">\n                    <div style=\"font-size:12.5px;font-weight:650;color:#16233f;\">{{ h.prog }}<\u002Fdiv>\n                    <div contenteditable=\"{{ h.editAttr }}\" style=\"font-size:12.5px;font-weight:650;color:#16233f;outline:none;border-radius:6px;padding:2px 6px;border:1px dashed transparent;color:#3a4a63;font-weight:500;\" style-focus=\"border-color:#5e6ad2;background:#fbfcff;\">{{ h.metrics }}<\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsDrfBank }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"display:flex;align-items:center;gap:10px;margin-bottom:3px;flex-wrap:wrap;\">\n                <div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Daily Reflection form · sections<\u002Fdiv>\n                <span style=\"{{ drfCfgTotalStyle }}\">{{ drfCfgTotalLabel }}<\u002Fspan>\n                <span style=\"font-size:11px;color:#9aa6b8;margin-left:auto;\">{{ drfCfgCount }}<\u002Fspan>\n                <span style=\"display:flex;gap:6px;\">\n                  <button sc-camel-on-click=\"{{ drfCfgExpandAll }}\" style=\"height:24px;padding:0 10px;border-radius:7px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-weight:700;font-size:10px;cursor:pointer;\">Expand all<\u002Fbutton>\n                  <button sc-camel-on-click=\"{{ drfCfgCollapseAll }}\" style=\"height:24px;padding:0 10px;border-radius:7px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-weight:700;font-size:10px;cursor:pointer;\">Collapse all<\u002Fbutton>\n                <\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"font-size:11.5px;color:#9aa6b8;margin-bottom:12px;\">{{ drfCfgNote }}<\u002Fdiv>\n\n              <div style=\"display:flex;flex-direction:column;gap:11px;\">\n                <sc-for list=\"{{ drfCfgSections }}\" as=\"sec\" hint-placeholder-count=\"4\">\n                  <div style=\"{{ sec.cardStyle }}\">\n                    <div style=\"display:flex;align-items:center;gap:9px;padding:11px 13px;background:#fbfcfe;border-bottom:1px solid #eef1f6;flex-wrap:wrap;\">\n                      <button sc-camel-on-click=\"{{ sec.toggleOpen }}\" title=\"{{ sec.caretTitle }}\" style=\"{{ sec.caretStyle }}\">{{ sec.caret }}<\u002Fbutton>\n                      <div contenteditable=\"{{ drfCfgEditAttr }}\" sc-camel-on-blur=\"{{ sec.onTitle }}\" style=\"flex:1;min-width:120px;font-size:13px;font-weight:750;color:#16233f;outline:none;border:1px dashed transparent;border-radius:7px;padding:2px 6px;\" style-focus=\"border-color:#5e6ad2;background:#fff;\">{{ sec.title }}<\u002Fdiv>\n                      <span style=\"display:flex;align-items:center;gap:5px;\">\n                        <span style=\"font-size:9.5px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;color:#9aa6b8;\">Weight<\u002Fspan>\n                        <input type=\"number\" min=\"0\" max=\"100\" value=\"{{ sec.weight }}\" sc-camel-on-input=\"{{ sec.onWeight }}\" disabled=\"{{ sec.weightLocked }}\" title=\"Weightage · all sections total 100%\" style=\"{{ sec.weightStyle }}\" style-focus=\"border-color:#5e6ad2;background:#fff;\">\n                        <span style=\"font-size:11.5px;font-weight:700;color:#8a97ac;\">%<\u002Fspan>\n                      <\u002Fspan>\n                      <span style=\"{{ sec.qMetaStyle }}\">{{ sec.qMeta }}<\u002Fspan>\n                      <sc-if value=\"{{ sec.fixShow }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"{{ sec.fixStyle }}\">Fixed<\u002Fspan><\u002Fsc-if>\n                      <sc-if value=\"{{ drfCfgEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ sec.toggleFixed }}\" title=\"{{ sec.fixTitle }}\" style=\"{{ sec.fixStyle }}\">{{ sec.fixLabel }}<\u002Fbutton><\u002Fsc-if>\n                      <span style=\"{{ sec.statusStyle }}\">{{ sec.statusLabel }}<\u002Fspan>\n                      <button sc-camel-on-click=\"{{ sec.toggle }}\" title=\"Show or hide this section\" style=\"{{ sec.sw }}\"><span style=\"{{ sec.knob }}\"><\u002Fspan><\u002Fbutton>\n                      <sc-if value=\"{{ drfCfgEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ sec.remove }}\" title=\"Delete section\" style=\"border:none;background:transparent;color:#c7ccd6;cursor:pointer;font-size:15px;line-height:1;padding:0 2px;\" style-hover=\"color:#c0392b;\">×<\u002Fbutton><\u002Fsc-if>\n                    <\u002Fdiv>\n                    <sc-if value=\"{{ sec.expanded }}\" hint-placeholder-val=\"{{ true }}\">\n                    <div style=\"padding:8px 13px 11px;display:flex;flex-direction:column;gap:6px;\">\n                      <sc-for list=\"{{ sec.qs }}\" as=\"q\" hint-placeholder-count=\"4\">\n                        <div style=\"{{ q.rowStyle }}\">\n                          <span style=\"flex:0 0 auto;font-size:10.5px;font-weight:700;color:#b6c1d1;font-variant-numeric:tabular-nums;\">{{ q.num }}<\u002Fspan>\n                          <div contenteditable=\"{{ drfCfgEditAttr }}\" sc-camel-on-blur=\"{{ q.onText }}\" style=\"flex:1;min-width:0;font-size:12.5px;color:#3a4a63;line-height:1.5;outline:none;border:1px dashed transparent;border-radius:7px;padding:2px 6px;\" style-focus=\"border-color:#5e6ad2;background:#fbfcff;\">{{ q.text }}<\u002Fdiv>\n                          <span style=\"display:flex;align-items:center;gap:4px;\">\n                            <input type=\"number\" min=\"0\" max=\"100\" value=\"{{ q.max }}\" sc-camel-on-input=\"{{ q.onMax }}\" disabled=\"{{ q.maxLocked }}\" title=\"Points · all questions in this section total 100\" style=\"{{ q.maxStyle }}\" style-focus=\"border-color:#5e6ad2;background:#fbfcff;\">\n                            <span style=\"font-size:10px;color:#9aa6b8;\">pts<\u002Fspan>\n                          <\u002Fspan>\n                          <sc-if value=\"{{ q.fixShow }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"{{ q.fixStyle }}\">Fixed<\u002Fspan><\u002Fsc-if>\n                          <sc-if value=\"{{ drfCfgEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ q.toggleFixed }}\" title=\"{{ q.fixTitle }}\" style=\"{{ q.fixStyle }}\">{{ q.fixLabel }}<\u002Fbutton><\u002Fsc-if>\n                          <span style=\"{{ q.statusStyle }}\">{{ q.statusLabel }}<\u002Fspan>\n                          <button sc-camel-on-click=\"{{ q.toggle }}\" title=\"Enable or disable this question\" style=\"{{ q.sw }}\"><span style=\"{{ q.knob }}\"><\u002Fspan><\u002Fbutton>\n                          <sc-if value=\"{{ drfCfgEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ q.remove }}\" title=\"Remove question\" style=\"border:none;background:transparent;color:#c7ccd6;cursor:pointer;font-size:14px;line-height:1;padding:0 2px;\" style-hover=\"color:#c0392b;\">×<\u002Fbutton><\u002Fsc-if>\n                        <\u002Fdiv>\n                      <\u002Fsc-for>\n                      <sc-if value=\"{{ drfCfgEdit }}\" hint-placeholder-val=\"{{ true }}\">\n                        <div style=\"display:flex;gap:7px;margin-top:3px;flex-wrap:wrap;\">\n                          <input value=\"{{ sec.draft }}\" sc-camel-on-input=\"{{ sec.onDraft }}\" placeholder=\"Add a question to this section…\" style=\"flex:1 1 220px;min-width:170px;height:32px;padding:0 11px;border:1px solid #e6ebf2;border-radius:8px;background:#fff;font-size:12px;color:#16233f;outline:none;\" style-focus=\"border-color:#5e6ad2;\">\n                          <input value=\"{{ sec.draftMax }}\" sc-camel-on-input=\"{{ sec.onDraftMax }}\" placeholder=\"Pts\" style=\"flex:0 0 62px;height:32px;padding:0 10px;border:1px solid #e6ebf2;border-radius:8px;background:#fff;font-size:12px;color:#16233f;outline:none;font-variant-numeric:tabular-nums;\" style-focus=\"border-color:#5e6ad2;\">\n                          <button sc-camel-on-click=\"{{ sec.addQ }}\" style=\"height:32px;padding:0 13px;border-radius:8px;border:1px dashed #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:11.5px;cursor:pointer;\">+ Add question<\u002Fbutton>\n                        <\u002Fdiv>\n                      <\u002Fsc-if>\n                    <\u002Fdiv>\n                    <\u002Fsc-if>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n\n            <sc-if value=\"{{ drfCfgEdit }}\" hint-placeholder-val=\"{{ true }}\">\n              <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;margin-top:14px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n                <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:3px;\">Add a section<\u002Fdiv>\n                <div style=\"font-size:11.5px;color:#9aa6b8;margin-bottom:11px;\">Section weights must total 100% — a new section can only take the weight that is still free. Questions inside a section total 100 points.<\u002Fdiv>\n                <div style=\"display:flex;gap:8px;flex-wrap:wrap;\">\n                  <input value=\"{{ drfCfgNewName }}\" sc-camel-on-input=\"{{ onDrfCfgNewName }}\" placeholder=\"Section name · e.g. Sleep quality\" style=\"flex:1 1 220px;min-width:180px;height:36px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;color:#16233f;outline:none;\" style-focus=\"border-color:#5e6ad2;\">\n                  <input value=\"{{ drfCfgNewWeight }}\" sc-camel-on-input=\"{{ onDrfCfgNewWeight }}\" placeholder=\"Weight %\" style=\"flex:0 0 100px;height:36px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;color:#16233f;outline:none;font-variant-numeric:tabular-nums;\" style-focus=\"border-color:#5e6ad2;\">\n                  <button sc-camel-on-click=\"{{ addDrfCfgSection }}\" style=\"height:36px;padding:0 15px;border-radius:9px;border:none;background:#5e6ad2;color:#fff;font-weight:700;font-size:12.5px;cursor:pointer;\">+ Add section<\u002Fbutton>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsPrescBank }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:9px;margin-bottom:3px;flex-wrap:wrap;\">\n                <div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Master prescription book<\u002Fdiv>\n                <span style=\"font-size:11px;color:#9aa6b8;\">{{ cfgPbCount }}<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"font-size:11.5px;color:#9aa6b8;margin-bottom:12px;\">{{ cfgPbNote }}<\u002Fdiv>\n              <div style=\"display:grid;grid-template-columns:repeat(2,1fr);gap:10px;\">\n                <sc-for list=\"{{ cfgPbCards }}\" as=\"p\" hint-placeholder-count=\"4\">\n                  <button sc-camel-on-click=\"{{ p.open }}\" style=\"{{ p.cardStyle }}\" style-hover=\"box-shadow:0 5px 14px rgba(16,35,63,.12);\">\n                    <span style=\"display:flex;align-items:center;gap:8px;width:100%;\">\n                      <span style=\"width:8px;height:8px;border-radius:50%;background:#2b8f5b;flex:0 0 8px;\"><\u002Fspan>\n                      <span style=\"flex:1;min-width:0;font-size:13px;font-weight:750;color:#16233f;\">{{ p.name }}<\u002Fspan>\n                      <span style=\"{{ p.statusStyle }}\">{{ p.statusLabel }}<\u002Fspan>\n                    <\u002Fspan>\n                    <span style=\"font-size:11.5px;color:#8a97ac;line-height:1.5;text-wrap:pretty;\">{{ p.excerpt }}<\u002Fspan>\n                    <span style=\"font-size:10px;color:#b6c1d1;\">{{ p.meta }}<\u002Fspan>\n                  <\u002Fbutton>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n\n            <sc-if value=\"{{ cfgPbEdit }}\" hint-placeholder-val=\"{{ true }}\">\n              <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;margin-top:14px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n                <div style=\"display:flex;align-items:center;gap:10px;flex-wrap:wrap;\">\n                  <div style=\"flex:1;min-width:200px;\">\n                    <div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Add a protocol<\u002Fdiv>\n                    <div style=\"font-size:11.5px;color:#9aa6b8;margin-top:2px;\">Name it and write one pointer per line — it joins the book for every coach.<\u002Fdiv>\n                  <\u002Fdiv>\n                  <sc-if value=\"{{ cfgPbFormClosed }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ openCfgPbForm }}\" style=\"height:36px;padding:0 15px;border-radius:9px;border:1px dashed #bfe3ce;background:#fff;color:#2b8f5b;font-weight:700;font-size:12.5px;cursor:pointer;\">+ New protocol<\u002Fbutton><\u002Fsc-if>\n                <\u002Fdiv>\n                <sc-if value=\"{{ cfgPbFormOpen }}\" hint-placeholder-val=\"{{ false }}\">\n                  <div style=\"margin-top:12px;display:flex;flex-direction:column;gap:9px;\">\n                    <input value=\"{{ cfgPbDraftName }}\" sc-camel-on-input=\"{{ onCfgPbDraftName }}\" placeholder=\"Protocol name · e.g. Alkaline Reset · Day 1-3\" style=\"height:38px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:13px;font-weight:650;color:#16233f;outline:none;\" style-focus=\"border-color:#2b8f5b;\">\n                    <div contenteditable=\"true\" sc-camel-on-blur=\"{{ onCfgPbDraftBody }}\" style=\"min-height:120px;padding:11px 13px;border:1px solid #e6ebf2;border-radius:10px;background:#fbfcff;font-size:12.5px;color:#3a4a63;line-height:1.7;outline:none;\" style-focus=\"border-color:#2b8f5b;background:#fff;\"><\u002Fdiv>\n                    <div style=\"display:flex;gap:7px;\">\n                      <button sc-camel-on-click=\"{{ saveCfgPb }}\" style=\"height:36px;padding:0 15px;border-radius:9px;border:none;background:#2b8f5b;color:#fff;font-weight:700;font-size:12.5px;cursor:pointer;\">Add to book<\u002Fbutton>\n                      <button sc-camel-on-click=\"{{ closeCfgPbForm }}\" style=\"height:36px;padding:0 13px;border-radius:9px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-weight:650;font-size:12.5px;cursor:pointer;\">Cancel<\u002Fbutton>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-if>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <sc-if value=\"{{ cfgPbOpen }}\" hint-placeholder-val=\"{{ false }}\">\n              <div sc-camel-on-click=\"{{ closeCfgPb }}\" style=\"position:fixed;inset:0;background:rgba(16,35,63,.42);backdrop-filter:blur(2px);z-index:80;display:flex;align-items:center;justify-content:center;padding:28px;animation:fadein .16s ease;\">\n                <div sc-camel-on-click=\"{{ cfgPbStop }}\" style=\"width:640px;max-width:94vw;max-height:82vh;background:#fff;border-radius:16px;box-shadow:0 24px 60px rgba(16,35,63,.28);display:flex;flex-direction:column;overflow:hidden;\">\n                  <div style=\"display:flex;align-items:center;gap:10px;padding:15px 18px;border-bottom:1px solid #eef1f6;flex-wrap:wrap;\">\n                    <div style=\"flex:1;min-width:0;\">\n                      <div style=\"font-size:15px;font-weight:750;color:#16233f;letter-spacing:-.01em;\">{{ cfgPbName }}<\u002Fdiv>\n                      <div style=\"font-size:11px;color:#9aa6b8;margin-top:2px;\">Protocol · master prescription book<\u002Fdiv>\n                    <\u002Fdiv>\n                    <span style=\"font-size:11px;font-weight:700;color:#8a97ac;\">{{ cfgPbOpenStatus }}<\u002Fspan>\n                    <button sc-camel-on-click=\"{{ toggleCfgPb }}\" title=\"Show or hide this protocol\" style=\"{{ cfgPbSw }}\"><span style=\"{{ cfgPbKnob }}\"><\u002Fspan><\u002Fbutton>\n                    <sc-if value=\"{{ cfgPbCanDelete }}\" hint-placeholder-val=\"{{ false }}\"><button sc-camel-on-click=\"{{ deleteCfgPb }}\" style=\"height:28px;padding:0 11px;border-radius:8px;border:1px solid #f6d0d1;background:#fff;color:#c0392b;font-weight:700;font-size:11.5px;cursor:pointer;\">Delete<\u002Fbutton><\u002Fsc-if>\n                    <button sc-camel-on-click=\"{{ closeCfgPb }}\" title=\"Close\" style=\"border:none;background:transparent;color:#9aa6b8;font-size:19px;line-height:1;cursor:pointer;padding:0 2px;\">×<\u002Fbutton>\n                  <\u002Fdiv>\n                  <div style=\"overflow-y:auto;padding:14px 18px;display:flex;flex-direction:column;gap:7px;\">\n                    <sc-for list=\"{{ cfgPbPoints }}\" as=\"pt\" hint-placeholder-count=\"6\">\n                      <div style=\"display:flex;align-items:flex-start;gap:10px;\">\n                        <span style=\"flex:0 0 auto;width:6px;height:6px;border-radius:50%;background:#2b8f5b;margin-top:8px;\"><\u002Fspan>\n                        <div contenteditable=\"{{ cfgPbEditAttr }}\" sc-camel-on-blur=\"{{ pt.onEdit }}\" style=\"flex:1;min-width:0;font-size:12.5px;color:#3a4a63;line-height:1.6;text-wrap:pretty;outline:none;border:1px dashed transparent;border-radius:7px;padding:2px 6px;\" style-focus=\"border-color:#bfe3ce;background:#f8fdfa;\">{{ pt.text }}<\u002Fdiv>\n                        <sc-if value=\"{{ cfgPbEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ pt.remove }}\" title=\"Remove pointer\" style=\"border:none;background:transparent;color:#c7ccd6;cursor:pointer;font-size:14px;line-height:1;padding:0 2px;\" style-hover=\"color:#c0392b;\">×<\u002Fbutton><\u002Fsc-if>\n                      <\u002Fdiv>\n                    <\u002Fsc-for>\n                    <sc-if value=\"{{ cfgPbEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ addCfgPbPoint }}\" style=\"align-self:flex-start;margin-top:4px;height:32px;padding:0 13px;border-radius:8px;border:1px dashed #bfe3ce;background:#fff;color:#2b8f5b;font-weight:700;font-size:11.5px;cursor:pointer;\">+ Add pointer<\u002Fbutton><\u002Fsc-if>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsLetter }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:3px;\">Commitment letter<\u002Fdiv>\n              <div style=\"font-size:11.5px;color:#9aa6b8;margin-bottom:12px;\">Signed by the wellness coach at onboarding and shareable with clients.<\u002Fdiv>\n              <div contenteditable=\"{{ cfgEditAttr }}\" sc-camel-on-blur=\"{{ onCfgLetter }}\" style=\"font-size:13px;color:#2c3a54;line-height:1.7;text-wrap:pretty;background:#fbfcfe;border:1px solid #eef1f6;border-radius:11px;padding:16px 18px;outline:none;\" style-focus=\"border-color:#5e6ad2;background:#fff;\">{{ cfgLetterText }}<\u002Fdiv>\n              <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\">\n                <div style=\"display:flex;align-items:center;gap:9px;margin-top:10px;flex-wrap:wrap;\">\n                  <button sc-camel-on-click=\"{{ saveCfgLetter }}\" style=\"height:34px;padding:0 15px;border-radius:9px;border:none;background:#5e6ad2;color:#fff;font-weight:700;font-size:12.5px;cursor:pointer;\">Save text<\u002Fbutton>\n                  <button sc-camel-on-click=\"{{ resetCfgLetter }}\" style=\"height:34px;padding:0 13px;border-radius:9px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-weight:650;font-size:12.5px;cursor:pointer;\">Reset to default<\u002Fbutton>\n                  <span style=\"font-size:11px;color:#9aa6b8;\">{{ cfgLetterSaved }} · {{ cfgLetterVer }}<\u002Fspan>\n                <\u002Fdiv>\n              <\u002Fsc-if>\n              <sc-if value=\"{{ cfgLetterShowAdminSign }}\" hint-placeholder-val=\"{{ true }}\">\n                <div style=\"margin-top:13px;padding-top:13px;border-top:1px solid #f1f4f9;\">\n                  <div style=\"display:flex;align-items:center;gap:9px;margin-bottom:9px;flex-wrap:wrap;\">\n                    <div style=\"font-size:12px;font-weight:750;color:#16233f;\">Coach sign-off<\u002Fdiv>\n                    <span style=\"{{ cfgLetterSignStyle }}\">{{ cfgLetterSignNote }}<\u002Fspan>\n                  <\u002Fdiv>\n                  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:8px;\">\n                    <sc-for list=\"{{ cfgLetterSignRows }}\" as=\"ls\" hint-placeholder-count=\"6\">\n                      <div style=\"{{ ls.rowStyle }}\">\n                        <span style=\"{{ ls.avatar }}\">{{ ls.initial }}<\u002Fspan>\n                        <span style=\"flex:1;min-width:0;font-size:12px;font-weight:650;color:#16233f;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">{{ ls.name }}<\u002Fspan>\n                        <span style=\"{{ ls.labelStyle }}\">{{ ls.label }}<\u002Fspan>\n                        <button sc-camel-on-click=\"{{ ls.remind }}\" title=\"Send a reminder\" style=\"border:none;background:transparent;color:#b6c1d1;cursor:pointer;font-size:12px;line-height:1;padding:0 2px;\" style-hover=\"color:#5e6ad2;\">↻<\u002Fbutton>\n                      <\u002Fdiv>\n                    <\u002Fsc-for>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-if>\n              <div style=\"display:flex;align-items:center;gap:11px;margin-top:13px;padding-top:13px;border-top:1px solid #f1f4f9;\">\n                <div style=\"flex:1;min-width:0;\"><div style=\"font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#8a97ac;\">Coach signature<\u002Fdiv><div style=\"font-size:12px;color:#9aa6b8;margin-top:2px;\">Captured at onboarding<\u002Fdiv><\u002Fdiv>\n                <div style=\"width:170px;height:52px;border:1.5px dashed #cbd5e6;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:11px;color:#a7b2c2;\">Signature<\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n            <sc-if value=\"{{ cfgLetterPromptOpen }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"position:fixed;inset:0;background:rgba(16,35,63,.42);backdrop-filter:blur(2px);z-index:80;display:flex;align-items:center;justify-content:center;padding:28px;animation:fadein .16s ease;\">\n                <div sc-camel-on-click=\"{{ cfgLetterStop }}\" style=\"width:560px;max-width:94vw;max-height:82vh;background:#fff;border-radius:16px;box-shadow:0 24px 60px rgba(16,35,63,.28);display:flex;flex-direction:column;overflow:hidden;\">\n                  <div style=\"padding:15px 18px;border-bottom:1px solid #eef1f6;\">\n                    <div style=\"font-size:15px;font-weight:750;color:#16233f;letter-spacing:-.01em;\">Commitment letter updated<\u002Fdiv>\n                    <div style=\"font-size:11.5px;color:#9aa6b8;margin-top:3px;\">Admin published {{ cfgLetterPromptVer }}. Read it and sign again — your clients see the signed version.<\u002Fdiv>\n                  <\u002Fdiv>\n                  <div style=\"overflow-y:auto;padding:16px 18px;\">\n                    <div style=\"font-size:13px;color:#2c3a54;line-height:1.7;text-wrap:pretty;background:#fbfcfe;border:1px solid #eef1f6;border-radius:11px;padding:15px 16px;\">{{ cfgLetterPromptText }}<\u002Fdiv>\n                    <div style=\"display:flex;align-items:center;gap:11px;margin-top:12px;\">\n                      <div style=\"flex:1;min-width:0;font-size:11px;color:#9aa6b8;\">Signing as <b style=\"color:#16233f;\">{{ cfgLetterPromptName }}<\u002Fb><\u002Fdiv>\n                      <div style=\"width:150px;height:46px;border:1.5px dashed #cbd5e6;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:11px;color:#a7b2c2;\">Signature<\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                  <div style=\"display:flex;gap:8px;padding:13px 18px;border-top:1px solid #eef1f6;background:#fbfcfe;\">\n                    <button sc-camel-on-click=\"{{ signCfgLetter }}\" style=\"height:38px;padding:0 17px;border-radius:9px;border:none;background:#2b8f5b;color:#fff;font-weight:700;font-size:13px;cursor:pointer;\">Sign &amp; accept<\u002Fbutton>\n                    <button sc-camel-on-click=\"{{ laterCfgLetter }}\" style=\"height:38px;padding:0 15px;border-radius:9px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-weight:650;font-size:13px;cursor:pointer;\">Later<\u002Fbutton>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n            <div style=\"display:none;\">\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsGallery }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;flex-wrap:wrap;\">\n                <div><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Gallery<\u002Fdiv><div style=\"font-size:11.5px;color:#9aa6b8;margin-top:2px;\">Admin-only view of every client upload plus common assets.<\u002Fdiv><\u002Fdiv>\n                <div style=\"display:flex;gap:7px;flex-wrap:wrap;\">\n                  <sc-for list=\"{{ cfgGalleryTabs }}\" as=\"g\" hint-placeholder-count=\"3\"><span style=\"font-size:11px;font-weight:650;color:#5a6b85;background:#f2f5fa;border:1px solid #e6ebf2;border-radius:999px;padding:5px 12px;\">{{ g.label }} · {{ g.count }}<\u002Fspan><\u002Fsc-for>\n                <\u002Fdiv>\n              <\u002Fdiv>\n              <div style=\"margin-bottom:14px;\">\n                <div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-bottom:9px;flex-wrap:wrap;\">\n                  <div><div style=\"font-size:12px;font-weight:750;color:#16233f;\">Videos<\u002Fdiv><div style=\"font-size:11px;color:#9aa6b8;margin-top:1px;\">Every video in the Gallery and the onboarding tag it currently carries.<\u002Fdiv><\u002Fdiv>\n                <\u002Fdiv>\n                <div style=\"display:flex;gap:9px;flex-wrap:wrap;\">\n                  <sc-for list=\"{{ cfgGalVideos }}\" as=\"gv\" hint-placeholder-count=\"6\">\n                    <div style=\"{{ gv.tileStyle }}\">\n                      <span style=\"{{ gv.thumbStyle }}\">▶<\u002Fspan>\n                      <span style=\"font-size:11px;font-weight:700;color:#16233f;line-height:1.35;\">{{ gv.name }}<\u002Fspan>\n                      <span style=\"display:flex;align-items:center;gap:6px;\">\n                        <span style=\"{{ gv.tagStyle }}\">{{ gv.tag }}<\u002Fspan>\n                        <span style=\"font-size:10px;color:#9aa6b8;font-variant-numeric:tabular-nums;\">{{ gv.dur }}<\u002Fspan>\n                      <\u002Fspan>\n                    <\u002Fdiv>\n                  <\u002Fsc-for>\n                <\u002Fdiv>\n              <\u002Fdiv>\n              <div style=\"font-size:12px;font-weight:750;color:#16233f;margin-bottom:9px;\">Images<\u002Fdiv>\n              <div style=\"display:grid;grid-template-columns:repeat(8,1fr);gap:8px;\">\n                <sc-for list=\"{{ cfgGalleryTiles }}\" as=\"tl\" hint-placeholder-count=\"8\">\n                  <div style=\"display:flex;flex-direction:column;gap:5px;min-width:0;\">\n                    <div style=\"{{ tl.style }}\">🖼️<\u002Fdiv>\n                    <sc-if value=\"{{ tl.hasLabel }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"font-size:9.5px;color:#8a97ac;line-height:1.35;text-wrap:pretty;\">{{ tl.label }}<\u002Fdiv><\u002Fsc-if>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsLaunchBank }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;margin-bottom:14px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"display:flex;align-items:center;gap:10px;margin-bottom:3px;flex-wrap:wrap;\">\n                <div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Rating scale<\u002Fdiv>\n                <span style=\"font-size:11px;color:#9aa6b8;margin-left:auto;\">{{ lbBandCount }}<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"font-size:11.5px;color:#9aa6b8;margin-bottom:12px;text-wrap:pretty;\">{{ lbBandNote }}<\u002Fdiv>\n              <div style=\"display:flex;flex-direction:column;gap:8px;\">\n                <sc-for list=\"{{ lbBands }}\" as=\"b\" hint-placeholder-count=\"4\">\n                  <div style=\"display:flex;align-items:center;gap:9px;flex-wrap:wrap;border:1px solid #f1f4f9;border-radius:11px;padding:9px 11px;background:#fbfcfe;\">\n                    <span style=\"{{ b.chipStyle }}\">{{ b.label }}<\u002Fspan>\n                    <input value=\"{{ b.label }}\" sc-camel-on-input=\"{{ b.onLabel }}\" disabled=\"{{ b.locked }}\" placeholder=\"Rating name\" style=\"{{ b.labelStyle }}\" style-focus=\"border-color:#5e6ad2;\">\n                    <span style=\"display:flex;align-items:center;gap:4px;\">\n                      <input type=\"number\" min=\"0\" max=\"100\" value=\"{{ b.pts }}\" sc-camel-on-input=\"{{ b.onPts }}\" disabled=\"{{ b.locked }}\" style=\"{{ b.ptsStyle }}\" style-focus=\"border-color:#5e6ad2;background:#fff;\">\n                      <span style=\"font-size:10px;color:#9aa6b8;\">pts<\u002Fspan>\n                    <\u002Fspan>\n                    <input value=\"{{ b.note }}\" sc-camel-on-input=\"{{ b.onNote }}\" disabled=\"{{ b.locked }}\" placeholder=\"What the coach should do at this rating…\" style=\"{{ b.noteStyle }}\" style-focus=\"border-color:#5e6ad2;\">\n                    <sc-if value=\"{{ lbEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ b.remove }}\" title=\"Remove rating\" style=\"border:none;background:transparent;color:#c7ccd6;cursor:pointer;font-size:15px;line-height:1;padding:0 2px;\" style-hover=\"color:#c0392b;\">×<\u002Fbutton><\u002Fsc-if>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n              <sc-if value=\"{{ lbEdit }}\" hint-placeholder-val=\"{{ true }}\">\n                <div style=\"display:flex;gap:8px;flex-wrap:wrap;margin-top:11px;\">\n                  <input value=\"{{ lbBandName }}\" sc-camel-on-input=\"{{ onLbBandName }}\" placeholder=\"Rating name · e.g. Outstanding\" style=\"flex:1 1 200px;min-width:170px;height:34px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;color:#16233f;outline:none;\" style-focus=\"border-color:#5e6ad2;\">\n                  <input value=\"{{ lbBandPts }}\" sc-camel-on-input=\"{{ onLbBandPts }}\" placeholder=\"Points\" style=\"flex:0 0 90px;height:34px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;color:#16233f;outline:none;font-variant-numeric:tabular-nums;\" style-focus=\"border-color:#5e6ad2;\">\n                  <button sc-camel-on-click=\"{{ addLbBand }}\" style=\"height:34px;padding:0 15px;border-radius:9px;border:1px dashed #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:12px;cursor:pointer;\">+ Add rating<\u002Fbutton>\n                <\u002Fdiv>\n              <\u002Fsc-if>\n            <\u002Fdiv>\n\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;margin-bottom:14px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"display:flex;align-items:center;gap:10px;margin-bottom:3px;flex-wrap:wrap;\">\n                <div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">LAUNCH assessment · domains<\u002Fdiv>\n                <span style=\"{{ lbTotalStyle }}\">{{ lbTotalLabel }}<\u002Fspan>\n                <span style=\"font-size:11px;color:#9aa6b8;margin-left:auto;\">{{ lbCount }}<\u002Fspan>\n                <sc-if value=\"{{ lbHasSections }}\" hint-placeholder-val=\"{{ false }}\">\n                  <span style=\"display:flex;gap:6px;\">\n                    <button sc-camel-on-click=\"{{ lbExpandAll }}\" style=\"height:24px;padding:0 10px;border-radius:7px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-weight:700;font-size:10px;cursor:pointer;\">Expand all<\u002Fbutton>\n                    <button sc-camel-on-click=\"{{ lbCollapseAll }}\" style=\"height:24px;padding:0 10px;border-radius:7px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-weight:700;font-size:10px;cursor:pointer;\">Collapse all<\u002Fbutton>\n                  <\u002Fspan>\n                <\u002Fsc-if>\n              <\u002Fdiv>\n              <div style=\"font-size:11.5px;color:#9aa6b8;margin-bottom:12px;\">{{ lbNote }}<\u002Fdiv>\n\n              <sc-if value=\"{{ lbEmpty }}\" hint-placeholder-val=\"{{ true }}\">\n                <div style=\"border:1px dashed #d9e0ec;border-radius:13px;padding:26px 18px;text-align:center;background:#fbfcfe;\">\n                  <div style=\"font-size:13px;font-weight:750;color:#16233f;\">Clean slate<\u002Fdiv>\n                  <div style=\"font-size:11.5px;color:#9aa6b8;margin-top:5px;text-wrap:pretty;\">{{ lbEmptyNote }}<\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-if>\n\n              <div style=\"display:flex;flex-direction:column;gap:11px;\">\n                <sc-for list=\"{{ lbSections }}\" as=\"sec\" hint-placeholder-count=\"0\">\n                  <div style=\"{{ sec.cardStyle }}\">\n                    <div style=\"display:flex;align-items:center;gap:9px;padding:11px 13px;background:#fbfcfe;border-bottom:1px solid #eef1f6;flex-wrap:wrap;\">\n                      <button sc-camel-on-click=\"{{ sec.toggleOpen }}\" title=\"{{ sec.caretTitle }}\" style=\"{{ sec.caretStyle }}\">{{ sec.caret }}<\u002Fbutton>\n                      <div contenteditable=\"{{ lbEditAttr }}\" sc-camel-on-blur=\"{{ sec.onTitle }}\" style=\"flex:1;min-width:120px;font-size:13px;font-weight:750;color:#16233f;outline:none;border:1px dashed transparent;border-radius:7px;padding:2px 6px;\" style-focus=\"border-color:#5e6ad2;background:#fff;\">{{ sec.title }}<\u002Fdiv>\n                      <span style=\"display:flex;align-items:center;gap:5px;\">\n                        <span style=\"font-size:9.5px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;color:#9aa6b8;\">Weight<\u002Fspan>\n                        <input type=\"number\" min=\"0\" max=\"100\" value=\"{{ sec.weight }}\" sc-camel-on-input=\"{{ sec.onWeight }}\" disabled=\"{{ sec.weightLocked }}\" title=\"Weightage · all sections total 100%\" style=\"{{ sec.weightStyle }}\" style-focus=\"border-color:#5e6ad2;background:#fff;\">\n                        <span style=\"font-size:11.5px;font-weight:700;color:#8a97ac;\">%<\u002Fspan>\n                      <\u002Fspan>\n                      <span style=\"{{ sec.qMetaStyle }}\">{{ sec.qMeta }}<\u002Fspan>\n                      <sc-if value=\"{{ sec.unscored }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"{{ sec.unscoredStyle }}\">General · unscored<\u002Fspan><\u002Fsc-if>\n                      <sc-if value=\"{{ sec.fixShow }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"{{ sec.fixStyle }}\">Fixed<\u002Fspan><\u002Fsc-if>\n                      <sc-if value=\"{{ lbEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ sec.toggleFixed }}\" title=\"{{ sec.fixTitle }}\" style=\"{{ sec.fixStyle }}\">{{ sec.fixLabel }}<\u002Fbutton><\u002Fsc-if>\n                      <span style=\"{{ sec.statusStyle }}\">{{ sec.statusLabel }}<\u002Fspan>\n                      <button sc-camel-on-click=\"{{ sec.toggle }}\" title=\"Show or hide this domain\" style=\"{{ sec.sw }}\"><span style=\"{{ sec.knob }}\"><\u002Fspan><\u002Fbutton>\n                      <sc-if value=\"{{ lbEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ sec.remove }}\" title=\"Delete domain\" style=\"border:none;background:transparent;color:#c7ccd6;cursor:pointer;font-size:15px;line-height:1;padding:0 2px;\" style-hover=\"color:#c0392b;\">×<\u002Fbutton><\u002Fsc-if>\n                    <\u002Fdiv>\n                    <sc-if value=\"{{ sec.expanded }}\" hint-placeholder-val=\"{{ true }}\">\n                    <div style=\"padding:8px 13px 11px;display:flex;flex-direction:column;gap:6px;\">\n                      <sc-if value=\"{{ sec.noQs }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"font-size:11.5px;color:#9aa6b8;padding:4px 2px;\">No questions in this domain yet.<\u002Fdiv><\u002Fsc-if>\n                      <sc-for list=\"{{ sec.qs }}\" as=\"q\" hint-placeholder-count=\"0\">\n                        <div style=\"display:flex;flex-direction:column;gap:0;\">\n                        <div style=\"{{ q.rowStyle }}\">\n                          <span style=\"flex:0 0 auto;font-size:10.5px;font-weight:700;color:#b6c1d1;font-variant-numeric:tabular-nums;\">{{ q.num }}<\u002Fspan>\n                          <div contenteditable=\"{{ lbEditAttr }}\" sc-camel-on-blur=\"{{ q.onText }}\" style=\"flex:1;min-width:0;font-size:12.5px;color:#3a4a63;line-height:1.5;outline:none;border:1px dashed transparent;border-radius:7px;padding:2px 6px;\" style-focus=\"border-color:#5e6ad2;background:#fbfcff;\">{{ q.text }}<\u002Fdiv>\n                          <button sc-camel-on-click=\"{{ q.toggleInfo }}\" title=\"Rating guidance shown in the client’s i pop-up\" style=\"{{ q.infoBtnStyle }}\">Info<\u002Fbutton>\n                          <span style=\"display:flex;align-items:center;gap:4px;\">\n                            <input type=\"number\" min=\"0\" max=\"100\" value=\"{{ q.max }}\" sc-camel-on-input=\"{{ q.onMax }}\" disabled=\"{{ q.maxLocked }}\" title=\"Points · all questions in this section total 100\" style=\"{{ q.maxStyle }}\" style-focus=\"border-color:#5e6ad2;background:#fbfcff;\">\n                            <span style=\"font-size:10px;color:#9aa6b8;\">pts<\u002Fspan>\n                          <\u002Fspan>\n                          <sc-if value=\"{{ q.fixShow }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"{{ q.fixStyle }}\">Fixed<\u002Fspan><\u002Fsc-if>\n                          <sc-if value=\"{{ lbEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ q.toggleFixed }}\" title=\"{{ q.fixTitle }}\" style=\"{{ q.fixStyle }}\">{{ q.fixLabel }}<\u002Fbutton><\u002Fsc-if>\n                          <span style=\"{{ q.statusStyle }}\">{{ q.statusLabel }}<\u002Fspan>\n                          <button sc-camel-on-click=\"{{ q.toggle }}\" title=\"Enable or disable this question\" style=\"{{ q.sw }}\"><span style=\"{{ q.knob }}\"><\u002Fspan><\u002Fbutton>\n                          <sc-if value=\"{{ lbEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ q.remove }}\" title=\"Remove question\" style=\"border:none;background:transparent;color:#c7ccd6;cursor:pointer;font-size:14px;line-height:1;padding:0 2px;\" style-hover=\"color:#c0392b;\">×<\u002Fbutton><\u002Fsc-if>\n                        <\u002Fdiv>\n                        <sc-if value=\"{{ q.infoOpen }}\" hint-placeholder-val=\"{{ false }}\">\n                          <div style=\"margin:6px 0 10px 26px;border:1px solid #eef1f6;border-left:2px solid #dcdff7;border-radius:10px;padding:11px 12px;background:#fbfcfe;display:flex;flex-direction:column;gap:7px;\">\n                            <div style=\"font-size:10px;font-weight:750;letter-spacing:.05em;text-transform:uppercase;color:#8a97ac;\">What each rating means for this question<\u002Fdiv>\n                            <sc-for list=\"{{ q.infoRows }}\" as=\"ir\" hint-placeholder-count=\"4\">\n                              <div style=\"display:flex;align-items:center;gap:9px;flex-wrap:wrap;\">\n                                <span style=\"{{ ir.chipStyle }}\">{{ ir.label }}<\u002Fspan>\n                                <input value=\"{{ ir.value }}\" sc-camel-on-input=\"{{ ir.onChange }}\" disabled=\"{{ ir.locked }}\" placeholder=\"When does this answer count as {{ ir.label }}?\" style=\"{{ ir.style }}\" style-focus=\"border-color:#5e6ad2;\">\n                              <\u002Fdiv>\n                            <\u002Fsc-for>\n                            <div style=\"display:flex;align-items:center;gap:9px;flex-wrap:wrap;\">\n                              <span style=\"flex:0 0 96px;text-align:center;font-size:9.5px;font-weight:750;letter-spacing:.03em;text-transform:uppercase;color:#8a97ac;\">Coach tip<\u002Fspan>\n                              <input value=\"{{ q.infoTip }}\" sc-camel-on-input=\"{{ q.onInfoTip }}\" disabled=\"{{ q.infoLocked }}\" placeholder=\"Anything the coach should watch for on this question…\" style=\"{{ q.infoTipStyle }}\" style-focus=\"border-color:#5e6ad2;\">\n                            <\u002Fdiv>\n                          <\u002Fdiv>\n                        <\u002Fsc-if>\n                        <\u002Fdiv>\n                      <\u002Fsc-for>\n                      <sc-if value=\"{{ lbEdit }}\" hint-placeholder-val=\"{{ true }}\">\n                        <div style=\"display:flex;gap:7px;margin-top:3px;flex-wrap:wrap;\">\n                          <input value=\"{{ sec.draft }}\" sc-camel-on-input=\"{{ sec.onDraft }}\" placeholder=\"Add a question to this domain…\" style=\"flex:1 1 220px;min-width:170px;height:32px;padding:0 11px;border:1px solid #e6ebf2;border-radius:8px;background:#fff;font-size:12px;color:#16233f;outline:none;\" style-focus=\"border-color:#5e6ad2;\">\n                          <input value=\"{{ sec.draftMax }}\" sc-camel-on-input=\"{{ sec.onDraftMax }}\" placeholder=\"Pts\" style=\"flex:0 0 62px;height:32px;padding:0 10px;border:1px solid #e6ebf2;border-radius:8px;background:#fff;font-size:12px;color:#16233f;outline:none;font-variant-numeric:tabular-nums;\" style-focus=\"border-color:#5e6ad2;\">\n                          <button sc-camel-on-click=\"{{ sec.addQ }}\" style=\"height:32px;padding:0 13px;border-radius:8px;border:1px dashed #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:11.5px;cursor:pointer;\">+ Add question<\u002Fbutton>\n                        <\u002Fdiv>\n                      <\u002Fsc-if>\n                    <\u002Fdiv>\n                    <\u002Fsc-if>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n\n              <sc-if value=\"{{ lbEdit }}\" hint-placeholder-val=\"{{ true }}\">\n                <div style=\"margin-top:14px;padding-top:13px;border-top:1px solid #f1f4f9;\">\n                  <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:3px;\">Add a domain<\u002Fdiv>\n                  <div style=\"font-size:11.5px;color:#9aa6b8;margin-bottom:11px;\">Scored domains share the 100% — a new one can only take the weight that is still free. Leave the weight at 0 for a general, unscored section (name, age, occupation and the like).<\u002Fdiv>\n                  <div style=\"display:flex;gap:8px;flex-wrap:wrap;\">\n                    <input value=\"{{ lbNewName }}\" sc-camel-on-input=\"{{ onLbNewName }}\" placeholder=\"Domain name · e.g. Gut Health\" style=\"flex:1 1 220px;min-width:180px;height:36px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;color:#16233f;outline:none;\" style-focus=\"border-color:#5e6ad2;\">\n                    <input value=\"{{ lbNewWeight }}\" sc-camel-on-input=\"{{ onLbNewWeight }}\" placeholder=\"Weight % · 0 = general\" style=\"flex:0 0 150px;height:36px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;color:#16233f;outline:none;font-variant-numeric:tabular-nums;\" style-focus=\"border-color:#5e6ad2;\">\n                    <button sc-camel-on-click=\"{{ addLbSection }}\" style=\"height:36px;padding:0 15px;border-radius:9px;border:none;background:#5e6ad2;color:#fff;font-weight:700;font-size:12.5px;cursor:pointer;\">+ Add domain<\u002Fbutton>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-if>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsSimple }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"display:flex;align-items:center;gap:13px;\">\n                <span style=\"font-size:20px;\">⚙️<\u002Fspan>\n                <div style=\"flex:1;min-width:0;\"><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">{{ cfgTitle }}<\u002Fdiv><div style=\"font-size:11.5px;color:#9aa6b8;margin-top:2px;\">{{ cfgNote }} · owned by {{ cfgOwner }}<\u002Fdiv><\u002Fdiv>\n              <\u002Fdiv>\n              <div style=\"margin-top:13px;padding-top:13px;border-top:1px solid #f1f4f9;\">\n                <div style=\"font-size:12px;font-weight:750;color:#16233f;margin-bottom:3px;\">Who gets it<\u002Fdiv>\n                <div style=\"font-size:11.5px;color:#9aa6b8;margin-bottom:11px;\">Admin always has access. Switch it on or off per person — off means the feature is hidden for that coach and their clients.<\u002Fdiv>\n                <div style=\"display:flex;flex-direction:column;gap:14px;\">\n                  <sc-for list=\"{{ cfgFeatGroups }}\" as=\"g\" hint-placeholder-count=\"2\">\n                    <div>\n                      <div style=\"display:flex;align-items:center;gap:9px;margin-bottom:8px;flex-wrap:wrap;\">\n                        <span style=\"{{ g.tagStyle }}\">{{ g.label }}<\u002Fspan>\n                        <span style=\"font-size:11px;color:#9aa6b8;\">{{ g.count }}<\u002Fspan>\n                        <span style=\"display:flex;gap:6px;margin-left:auto;\">\n                          <button sc-camel-on-click=\"{{ g.allOn }}\" style=\"height:24px;padding:0 10px;border-radius:7px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-weight:700;font-size:10px;cursor:pointer;\">Enable all<\u002Fbutton>\n                          <button sc-camel-on-click=\"{{ g.allOff }}\" style=\"height:24px;padding:0 10px;border-radius:7px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-weight:700;font-size:10px;cursor:pointer;\">Disable all<\u002Fbutton>\n                        <\u002Fspan>\n                      <\u002Fdiv>\n                      <div style=\"display:grid;grid-template-columns:repeat(2,1fr);gap:8px;\">\n                        <sc-for list=\"{{ g.people }}\" as=\"p\" hint-placeholder-count=\"6\">\n                          <div style=\"{{ p.rowStyle }}\">\n                            <span style=\"{{ p.avatar }}\">{{ p.initial }}<\u002Fspan>\n                            <div style=\"flex:1;min-width:0;\">\n                              <div style=\"font-size:12.5px;font-weight:700;color:#16233f;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">{{ p.name }}<\u002Fdiv>\n                              <div style=\"font-size:10.5px;color:#9aa6b8;margin-top:1px;\">{{ p.meta }}<\u002Fdiv>\n                            <\u002Fdiv>\n                            <button sc-camel-on-click=\"{{ p.toggle }}\" title=\"{{ p.title }}\" style=\"{{ p.sw }}\"><span style=\"{{ p.knob }}\"><\u002Fspan><\u002Fbutton>\n                          <\u002Fdiv>\n                        <\u002Fsc-for>\n                      <\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fsc-for>\n                <\u002Fdiv>\n                <div style=\"margin-top:10px;font-size:11px;color:#9aa6b8;\">{{ cfgRoleAccessNote }}<\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n\n          <sc-if value=\"{{ cfgIsLists }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;margin-bottom:14px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:3px;\">Dropdown options<\u002Fdiv>\n              <div style=\"font-size:11.5px;color:#9aa6b8;\">Add, rename, disable or delete options — disabled ones stay on record but disappear from the matching dropdown across the whole panel — banner types, headlines, health concerns, data points, discount slabs and placements.<\u002Fdiv>\n            <\u002Fdiv>\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:13px;padding:12px 14px;margin-bottom:14px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"font-size:11.5px;font-weight:750;color:#16233f;margin-bottom:9px;\">Preview · what coaches will see<\u002Fdiv>\n              <div style=\"display:grid;grid-template-columns:repeat(4,1fr);gap:9px;\">\n                <sc-for list=\"{{ cfgListPreview }}\" as=\"lp\" hint-placeholder-count=\"4\">\n                  <div style=\"background:#fbfcfe;border:1px solid #eef1f6;border-radius:10px;padding:9px 10px;min-width:0;\">\n                    <div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:6px;margin-bottom:6px;\">\n                      <span style=\"font-size:9px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:#5e6ad2;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">{{ lp.label }}<\u002Fspan>\n                      <span style=\"font-size:9px;font-weight:700;color:#b0bacb;white-space:nowrap;\">{{ lp.count }}<\u002Fspan>\n                    <\u002Fdiv>\n                    <div style=\"display:flex;flex-wrap:wrap;gap:4px;\">\n                      <sc-for list=\"{{ lp.chips }}\" as=\"c\" hint-placeholder-count=\"3\"><span style=\"font-size:9.5px;font-weight:650;color:#3a4a63;background:#fff;border:1px solid #e6ebf2;border-radius:999px;padding:2px 7px;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">{{ c.v }}<\u002Fspan><\u002Fsc-for>\n                      <span style=\"font-size:9.5px;font-weight:700;color:#9aa6b8;\">{{ lp.more }}<\u002Fspan>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n\n            <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start;\">\n              <sc-for list=\"{{ cfgListGroups }}\" as=\"lg\" hint-placeholder-count=\"6\">\n                <div style=\"{{ lg.cardStyle }}\">\n                  <div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-bottom:10px;\">\n                    <span style=\"font-size:11px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:#5e6ad2;\">{{ lg.label }}<\u002Fspan>\n                    <span style=\"font-size:10px;font-weight:700;color:#9aa6b8;font-variant-numeric:tabular-nums;\">{{ lg.count }} options<\u002Fspan>\n                  <\u002Fdiv>\n                  <div style=\"display:flex;flex-direction:column;gap:6px;\">\n                    <sc-for list=\"{{ lg.items }}\" as=\"it\" hint-placeholder-count=\"4\">\n                      <div style=\"{{ it.rowStyle }}\">\n                        <div contenteditable=\"{{ it.editAttr }}\" style=\"{{ it.itemTextStyle }}\" style-focus=\"border-color:#5e6ad2;background:#fff;\">{{ it.v }}<\u002Fdiv>\n                        <span style=\"{{ it.statusStyle }}\">{{ it.statusLabel }}<\u002Fspan>\n                        <button sc-camel-on-click=\"{{ it.toggle }}\" title=\"Show or hide in dropdowns\" style=\"{{ it.sw }}\"><span style=\"{{ it.knob }}\"><\u002Fspan><\u002Fbutton>\n                        <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ it.toggleItemEdit }}\" style=\"{{ it.itemBtnStyle }}\">{{ it.itemBtnLabel }}<\u002Fbutton><\u002Fsc-if>\n                        <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ it.remove }}\" title=\"Remove\" style=\"border:none;background:transparent;color:#c7ccd6;cursor:pointer;font-size:14px;line-height:1;padding:0 2px;\" style-hover=\"color:#c0392b;\">×<\u002Fbutton><\u002Fsc-if>\n                      <\u002Fdiv>\n                    <\u002Fsc-for>\n                  <\u002Fdiv>\n                  <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\">\n                    <div style=\"display:flex;gap:7px;margin-top:9px;\">\n                      <input value=\"{{ lg.draft }}\" sc-camel-on-input=\"{{ lg.onDraft }}\" placeholder=\"Add an option…\" style=\"flex:1;min-width:0;height:32px;padding:0 10px;border:1px solid #e6ebf2;border-radius:8px;background:#fff;font-size:11.5px;color:#16233f;outline:none;\" style-focus=\"border-color:#5e6ad2;\">\n                      <button sc-camel-on-click=\"{{ lg.add }}\" style=\"height:32px;padding:0 12px;border-radius:8px;border:none;background:#5e6ad2;color:#fff;font-weight:700;font-size:11.5px;cursor:pointer;\">Add<\u002Fbutton>\n                    <\u002Fdiv>\n                  <\u002Fsc-if>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsPending }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px dashed #d5deeb;border-radius:14px;padding:52px 26px;text-align:center;\">\n              <div style=\"width:48px;height:48px;border-radius:13px;background:#f2f5fa;display:flex;align-items:center;justify-content:center;margin:0 auto 13px;font-size:20px;\">💳<\u002Fdiv>\n              <div style=\"font-size:14.5px;font-weight:700;color:#16233f;margin-bottom:4px;\">Not decided yet<\u002Fdiv>\n              <div style=\"font-size:12.5px;color:#8a97ac;max-width:340px;margin:0 auto;line-height:1.55;\">Share the gateway you want (Razorpay, Stripe, PayU…) and I'll build the key management and webhook settings here.<\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsProgTesti }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);margin-bottom:14px;\">\n              <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:3px;\">Program focus<\u002Fdiv>\n              <div style=\"font-size:11.5px;color:#9aa6b8;margin-bottom:12px;\">The testimonial is shown only on this program's page.<\u002Fdiv>\n              <sc-raw-select disabled=\"{{ cfgReadOnly }}\" style=\"{{ cfgSelectStyle }}\">\n                <sc-for list=\"{{ cfgProgList }}\" as=\"p\" hint-placeholder-count=\"6\"><option value=\"{{ p.label }}\">{{ p.label }}<\u002Foption><\u002Fsc-for>\n              <\u002Fsc-raw-select>\n            <\u002Fdiv>\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);margin-bottom:14px;\">\n              <div style=\"display:grid;grid-template-columns:auto 1fr;gap:16px;align-items:start;\">\n                <div>\n                  <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:11px;\">Photo<\u002Fdiv>\n                  <div style=\"display:grid;grid-template-columns:minmax(0,200px);gap:12px;\">\n                    <div style=\"{{ afterFrame }}\">\n                      <span style=\"font-size:20px;\">📷<\u002Fspan><span style=\"font-size:11.5px;font-weight:700;color:#2b8f5b;\">Client photo<\u002Fspan>\n                      <button sc-camel-on-click=\"{{ upAfter }}\" style=\"height:29px;padding:0 13px;border-radius:8px;border:1px solid #bfe3ce;background:#fff;color:#2b8f5b;font-weight:700;font-size:11px;cursor:pointer;\">Upload photo<\u002Fbutton>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n                <div style=\"min-width:0;display:flex;flex-direction:column;gap:11px;\">\n                  <div>\n                    <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:6px;\">Headline<\u002Fdiv>\n                    <input value=\"{{ ptHeadline }}\" sc-camel-on-input=\"{{ onPtHeadline }}\" sc-camel-read-only=\"{{ cfgReadOnly }}\" placeholder=\"e.g. Down 18 kg on Fat Loss\" style=\"width:100%;height:38px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;font-weight:650;color:#16233f;outline:none;\" style-focus=\"border-color:#5e6ad2;\">\n                  <\u002Fdiv>\n                  <div style=\"flex:1;display:flex;flex-direction:column;\">\n                    <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:6px;\">Description<\u002Fdiv>\n                    <textarea placeholder=\"Program-specific story…\" sc-camel-read-only=\"{{ cfgReadOnly }}\" style=\"{{ cfgTextAreaTall }}\"><\u002Ftextarea>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n\n              <div style=\"margin-top:14px;padding-top:13px;border-top:1px solid #f1f4f9;\">\n                <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:3px;\">Preview<\u002Fdiv>\n                <div style=\"font-size:11px;color:#9aa6b8;margin-bottom:9px;\">How this story appears on the website.<\u002Fdiv>\n                <div style=\"display:flex;gap:12px;align-items:flex-start;\">\n                  <div style=\"flex:1;min-width:0;\">\n                    <div style=\"font-size:9px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:#0d9488;margin-bottom:4px;\">Web<\u002Fdiv>\n                    <div style=\"border:1px solid #e6ebf2;border-radius:9px;overflow:hidden;background:#fff;\">\n                      <div style=\"height:16px;background:#f2f5fa;border-bottom:1px solid #eef1f6;display:flex;align-items:center;gap:3px;padding:0 6px;\"><span style=\"width:5px;height:5px;border-radius:50%;background:#f6a2a2;\"><\u002Fspan><span style=\"width:5px;height:5px;border-radius:50%;background:#f3d38b;\"><\u002Fspan><span style=\"width:5px;height:5px;border-radius:50%;background:#a8dcbb;\"><\u002Fspan><\u002Fdiv>\n                      <div style=\"padding:9px;display:flex;gap:8px;align-items:center;\">\n                        <span style=\"{{ cfgPrevWebSlot }}\"><\u002Fspan>\n                        <span style=\"flex:1;min-width:0;display:flex;flex-direction:column;gap:3px;justify-content:center;\">\n                          <span style=\"font-size:9.5px;font-weight:750;color:#16233f;\">{{ ptHeadline }}<\u002Fspan>\n                          <span style=\"height:4px;border-radius:2px;background:#eef1f6;width:88%;display:block;\"><\u002Fspan>\n                          <span style=\"height:4px;border-radius:2px;background:#eef1f6;width:64%;display:block;\"><\u002Fspan>\n                        <\u002Fspan>\n                      <\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);margin-bottom:14px;\">\n              <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:11px;flex-wrap:wrap;\">\n                <div><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Live on the website<\u002Fdiv><div style=\"font-size:11px;color:#9aa6b8;margin-top:2px;\">Drag to reorder · toggle to hide without deleting.<\u002Fdiv><\u002Fdiv>\n                <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ addPtStory }}\" style=\"height:32px;padding:0 13px;border-radius:9px;border:1px dashed #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:12px;cursor:pointer;\">+ Add story<\u002Fbutton><\u002Fsc-if>\n              <\u002Fdiv>\n              <div style=\"display:flex;flex-direction:column;gap:7px;\">\n                <sc-for list=\"{{ ptStories }}\" as=\"p\" hint-placeholder-count=\"4\">\n                  <div draggable=\"{{ p.dragAttr }}\" sc-camel-on-drag-start=\"{{ p.onDragStart }}\" sc-camel-on-drag-over=\"{{ p.onDragOver }}\" sc-camel-on-drop=\"{{ p.onDrop }}\" style=\"{{ p.rowStyle }}\">\n                    <span sc-camel-on-click=\"{{ p.openLive }}\" style=\"position:absolute;inset:0;cursor:pointer;\"><\u002Fspan>\n                    <span style=\"font-size:11px;color:#c0c9d6;letter-spacing:-2px;flex:0 0 auto;\">⋮⋮<\u002Fspan>\n                    <span style=\"font-size:10px;color:#b0bacb;font-variant-numeric:tabular-nums;flex:0 0 auto;\">#{{ p.ord }}<\u002Fspan>\n                    <span style=\"flex:1;min-width:0;font-size:12px;font-weight:650;color:#16233f;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">{{ p.name }}<\u002Fspan>\n                    <span style=\"{{ p.tagStyle }}\">{{ p.prog }}<\u002Fspan>\n                    <span style=\"{{ p.statusStyle }}\">{{ p.statusLabel }}<\u002Fspan>\n                    <button sc-camel-on-click=\"{{ p.toggleOn }}\" title=\"Show or hide on the website\" style=\"{{ p.sw }}\"><span style=\"{{ p.knob }}\"><\u002Fspan><\u002Fbutton>\n                    <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\">\n                      <span style=\"display:flex;gap:5px;flex:0 0 auto;position:relative;z-index:1;\">\n                        <button sc-camel-on-click=\"{{ p.up }}\" style=\"width:22px;height:22px;border-radius:6px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-size:10px;cursor:pointer;\">↑<\u002Fbutton>\n                        <button sc-camel-on-click=\"{{ p.down }}\" style=\"width:22px;height:22px;border-radius:6px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-size:10px;cursor:pointer;\">↓<\u002Fbutton>\n                        <button sc-camel-on-click=\"{{ p.remove }}\" title=\"Remove\" style=\"border:none;background:transparent;color:#c7ccd6;cursor:pointer;font-size:14px;line-height:1;padding:0 2px;\" style-hover=\"color:#c0392b;\">×<\u002Fbutton>\n                      <\u002Fspan>\n                    <\u002Fsc-if>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsFooter }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);margin-bottom:14px;\">\n              <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;flex-wrap:wrap;\">\n                <div><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Footer columns<\u002Fdiv><div style=\"font-size:11.5px;color:#9aa6b8;margin-top:2px;\">Edit the heading and the links inside each column.<\u002Fdiv><\u002Fdiv>\n                <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ openFcForm }}\" style=\"height:32px;padding:0 13px;border-radius:9px;border:1px dashed #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:12px;cursor:pointer;\">+ Add column<\u002Fbutton><\u002Fsc-if>\n              <\u002Fdiv>\n              <sc-if value=\"{{ fcFormOpen }}\" hint-placeholder-val=\"{{ false }}\">\n                <div style=\"background:#fff;border:1.5px solid #dcdff7;border-radius:12px;padding:12px 13px;margin-bottom:11px;box-shadow:0 4px 14px rgba(94,106,210,.12);\">\n                  <div style=\"display:flex;align-items:center;gap:9px;margin-bottom:10px;\">\n                    <span style=\"font-size:13px;\">🧱<\u002Fspan>\n                    <div style=\"flex:1;min-width:0;font-size:12px;font-weight:750;color:#16233f;\">New footer column<\u002Fdiv>\n                    <button sc-camel-on-click=\"{{ closeFcForm }}\" style=\"width:24px;height:24px;border:none;background:#f2f5fa;border-radius:7px;color:#5a6b85;font-size:13px;cursor:pointer;\">×<\u002Fbutton>\n                  <\u002Fdiv>\n                  <div style=\"display:grid;grid-template-columns:1fr 1.6fr auto;gap:8px;align-items:center;\">\n                    <input value=\"{{ fcName }}\" sc-camel-on-input=\"{{ onFcName }}\" placeholder=\"Heading · e.g. Resources\" style=\"height:36px;padding:0 11px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;color:#16233f;outline:none;\" style-focus=\"border-color:#5e6ad2;\">\n                    <input value=\"{{ fcItems }}\" sc-camel-on-input=\"{{ onFcItems }}\" placeholder=\"Links · separate with ·\" style=\"height:36px;padding:0 11px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;color:#5a6b85;outline:none;\" style-focus=\"border-color:#5e6ad2;\">\n                    <button sc-camel-on-click=\"{{ saveFc }}\" style=\"height:36px;padding:0 15px;border-radius:9px;border:none;background:#5e6ad2;color:#fff;font-weight:700;font-size:12.5px;cursor:pointer;white-space:nowrap;\">Add column<\u002Fbutton>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-if>\n              <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:11px;\">\n                <sc-for list=\"{{ cfgFooterCols }}\" as=\"c\" hint-placeholder-count=\"4\">\n                  <div style=\"{{ c.colStyle }}\">\n                    <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:2px;\">\n                      <div contenteditable=\"{{ c.editAttr }}\" style=\"{{ c.titleStyle }}\" style-focus=\"border-color:#5e6ad2;background:#fff;\">{{ c.title }}<\u002Fdiv>\n                      <sc-if value=\"{{ cfgCanEdit }}\" hint-placeholder-val=\"{{ true }}\">\n                        <span style=\"display:flex;align-items:center;gap:5px;margin-left:auto;flex:0 0 auto;\">\n                          <span style=\"{{ c.statusStyle }}\">{{ c.statusLabel }}<\u002Fspan>\n                          <button sc-camel-on-click=\"{{ c.toggleOn }}\" title=\"Show or hide this column\" style=\"{{ c.sw }}\"><span style=\"{{ c.knob }}\"><\u002Fspan><\u002Fbutton>\n                          <button sc-camel-on-click=\"{{ c.toggleEdit }}\" style=\"{{ c.btnStyle }}\">{{ c.btnLabel }}<\u002Fbutton>\n                          <button sc-camel-on-click=\"{{ c.remove }}\" title=\"Remove column\" style=\"border:none;background:transparent;color:#c7ccd6;cursor:pointer;font-size:14px;line-height:1;padding:0 2px;\" style-hover=\"color:#c0392b;\">×<\u002Fbutton>\n                        <\u002Fspan>\n                      <\u002Fsc-if>\n                    <\u002Fdiv>\n                    <div contenteditable=\"{{ c.editAttr }}\" style=\"{{ c.itemsStyle }}\" style-focus=\"border-color:#5e6ad2;background:#fff;\">{{ c.items }}<\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"font-size:12.5px;font-weight:750;color:#16233f;margin-bottom:9px;\">Bottom line<\u002Fdiv>\n              <div contenteditable=\"{{ cfgEditAttr }}\" style=\"font-size:12.5px;font-weight:650;color:#16233f;outline:none;border-radius:6px;padding:3px 7px;border:1px dashed transparent;font-weight:500;color:#5a6b85;background:#fbfcfe;border:1px solid #eef1f6;padding:11px 13px;display:block;\" style-focus=\"border-color:#5e6ad2;background:#fff;\">{{ cfgFooterCopy }}<\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgIsLinks }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:11px;flex-wrap:wrap;\">\n                <div><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">Links<\u002Fdiv><div style=\"font-size:11.5px;color:#9aa6b8;margin-top:2px;\">Sho