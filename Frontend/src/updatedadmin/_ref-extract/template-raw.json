        <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:14px;padding:16px 17px;box-shadow:0 1px 2px rgba(16,35,63,.04);margin-bottom:14px;\">\n                <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;flex-wrap:wrap;\">\n                  <div><div style=\"font-size:12.5px;font-weight:750;color:#16233f;\">{{ exPriceTitle }}<\u002Fdiv><div style=\"font-size:11.5px;color:#9aa6b8;margin-top:2px;\">Admin sets the amount, the discount %, and how long that discount stays valid.<\u002Fdiv><\u002Fdiv>\n                  <button sc-camel-on-click=\"{{ openExForm }}\" style=\"height:34px;padding:0 14px;border-radius:9px;border:1px dashed #cbd5e6;background:#fff;color:#5e6ad2;font-weight:700;font-size:12.5px;cursor:pointer;\">+ Add program<\u002Fbutton>\n                <\u002Fdiv>\n                <sc-if value=\"{{ exFormOpen }}\" hint-placeholder-val=\"{{ false }}\">\n                  <div style=\"background:#fff;border:1.5px solid #dcdff7;border-radius:12px;padding:12px 13px;margin-bottom:11px;box-shadow:0 4px 14px rgba(94,106,210,.12);\">\n                    <div style=\"display:flex;align-items:center;gap:9px;margin-bottom:10px;\">\n                      <span style=\"font-size:13px;\">💠<\u002Fspan>\n                      <div style=\"flex:1;min-width:0;font-size:12px;font-weight:750;color:#16233f;\">New program<\u002Fdiv>\n                      <button sc-camel-on-click=\"{{ closeExForm }}\" style=\"width:24px;height:24px;border:none;background:#f2f5fa;border-radius:7px;color:#5a6b85;font-size:13px;cursor:pointer;\">×<\u002Fbutton>\n                    <\u002Fdiv>\n                    <div style=\"display:grid;grid-template-columns:1.6fr 1fr auto;gap:8px;align-items:center;\">\n                      <input value=\"{{ exName }}\" sc-camel-on-input=\"{{ onExName }}\" placeholder=\"Program name\" style=\"height:36px;padding:0 11px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;fon