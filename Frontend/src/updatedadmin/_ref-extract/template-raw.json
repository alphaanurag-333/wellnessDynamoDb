rap:wrap;\">\n                            <span style=\"font-size:18px;font-weight:800;letter-spacing:-.02em;font-variant-numeric:tabular-nums;line-height:1.05;{{ p.accent }}\">{{ p.current }}<\u002Fspan>\n                            <span style=\"font-size:11px;color:#3a4a63;font-weight:750;font-variant-numeric:tabular-nums;\">{{ p.val }}<\u002Fspan>\n                            <span style=\"font-size:9px;color:#9aa6b8;font-weight:600;\">{{ p.delta }}<\u002Fspan>\n                          <\u002Fdiv>\n                        <\u002Fdiv>\n                        <span style=\"color:#c0c9d6;font-size:15px;flex:0 0 auto;\">›<\u002Fspan>\n                        <div class=\"pg-ins\" style=\"position:absolute;bottom:calc(100% + 6px);left:0;z-index:20;width:280px;max-width:88vw;background:#fff;border:1px solid #e6e8fb;border-radius:12px;box-shadow:0 14px 34px rgba(16,35,63,.18);padding:11px;opacity:0;pointer-events:none;transform:translateY(-4px);transition:opacity .15s ease,transform .15s ease;\">\n                          <div style=\"font-size:9.5px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#8a97ac;margin-bottom:8px;\">{{ p.name }} · insights<\u002Fdiv>\n                          <div style=\"display:flex;flex-wrap:wrap;gap:6px;\">\n                            <sc-for list=\"{{ p.insights }}\" as=\"ins\" hint-placeholder-count=\"5\"><div style=\"{{ ins.cellStyle }}\"><div style=\"font-size:8.5px;color:#9aa6b8;font-weight:700;text-transform:uppercase;letter-spacing:.03em;margin-bottom:3px;\">{{ ins.label }}<\u002Fdiv><div style=\"font-size:12.5px;font-weight:750;color:#16233f;font-variant-numeric:tabular-nums;line-height:1;\">{{ ins.val }}<\u002Fdiv><\u002Fdiv><\u002Fsc-for>\n                          <\u002Fdiv>\n                        <\u002Fdiv>\n                      <\u002Fbutton>\n                      <\u002Fsc-if>\n                    <\u002Fsc-for>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n\n              <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px;\">\n                <div style=\"font-size:12px;font-weight:700;letter-spacing:.04em;color:#8a97ac;text-transform:uppercase;\">Daily activity<\u002Fdiv>\n                <span style=\"font-size:11px;color:#9aa6b8;\">Tap a metric for last 5 records<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"display:flex;gap:8px;flex-wrap:nowrap;margin-bottom:18px;\">\n                <sc-for list=\"{{ cdActCards }}\" as=\"a\" hint-placeholder-count=\"6\">\n                  <div sc-camel-on-click=\"{{ a.open }}\" sc-camel-on-mouse-enter=\"{{ a.hoverIn }}\" sc-camel-on-mouse-leave=\"{{ a.hoverOut }}\" class=\"cdact\" style=\"position:relative;overflow:hidden;flex:1 1 0;min-width:0;background:#fff;border:1px solid #eef1f6;border-radius:12px;padding:11px 11px 10px;box-shadow:0 1px 2px rgba(16,35,63,.04);cursor:pointer;transition:transform .15s ease,box-shadow .15s ease,border-color .15s ease;\" style-hover=\"border-color:#c5cbe8;box-shadow:0 6px 18px rgba(94,106,210,.12);transform:translateY(-2px);\">\n                    <span class=\"cdbig\">{{ a.emoji }}<\u002Fspan>\n                    <div style=\"display:flex;align-items:center;gap:7px;margin-bottom:9px;\"><span class=\"cdemoji\" style=\"font-size:16px;\">{{ a.emoji }}<\u002Fspan><span style=\"font-size:11.5px;color:#8a97ac;font-weight:600;\">{{ a.name }}<\u002Fspan><\u002Fdiv>\n                    <div style=\"font-size:16px;font-weight:770;letter-spacing:-.01em;margin-bottom:9px;{{ a.accent }}\">{{ a.latest }}<\u002Fdiv>\n                    <div style=\"display:flex;align-items:flex-end;gap:3px;height:26px;\">\n                      <sc-for list=\"{{ a.spark }}\" as=\"s\" hint-placeholder-count=\"7\"><div style=\"flex:1;display:flex;align-items:flex-end;height:100%;\"><div style=\"{{ s.barStyle }}\"><\u002Fdiv><\u002Fdiv><\u002Fsc-for>\n                    <\u002Fdiv>\n                    <div style=\"display:flex;align-items:center;justify-content:space-between;gap:6px;margin-top:10px;margin-bottom:5px;\"><span style=\"font-size:10px;color:#9aa6b8;font-weight:600;\">{{ a.targetLabel }}<\u002Fspan><span style=\"font-size:10.5px;font-weight:750;font-variant-numeric:tabular-nums;{{ a.pctStyle }}\">{{ a.pctLabel }}<\u002Fspan><\u002Fdiv>\n                    <div style=\"height:4px;background:#eef1f6;border-radius:3px;overflow:hidden;\"><div style=\"{{ a.barStyle }}\"><\u002Fdiv><\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n\n\n              <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin:4px 0 12px;\">\n                <div style=\"font-size:12px;font-weight:700;letter-spacing:.04em;color:#8a97ac;text-transform:uppercase;\">Nutrition · active supplements<\u002Fdiv>\n                <button sc-camel-on-click=\"{{ cdGoNutrition }}\" style=\"display:inline-flex;align-items:center;gap:5px;height:30px;padding:0 12px;border-radius:8px;border:1px solid #e6ebf2;background:#fff;color:#2b8f5b;font-weight:650;font-size:11.5px;cursor:pointer;\" style-hover=\"background:#f0fbf7;border-color:#bfe3ce;\">{{ cdNutriCount }} active · Open plan ›<\u002Fbutton>\n              <\u002Fdiv>\n              <button sc-camel-on-click=\"{{ cdGoNutrition }}\" style=\"display:block;width:100%;text-align:left;background:#fff;border:1px solid #eef1f6;border-radius:14px;overflow:hidden;margin-bottom:18px;box-shadow:0 1px 2px rgba(16,35,63,.04);cursor:pointer;font:inherit;transition:border-color .15s ease,box-shadow .15s ease;\" style-hover=\"border-color:#bfe3ce;box-shadow:0 6px 16px rgba(43,143,91,.1);\">\n                <div style=\"display:grid;grid-template-columns:1.4fr 2fr 1.15fr;gap:0;padding:9px 16px;background:#fbfcfe;border-bottom:1px solid #eef1f6;font-size:10px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#8a97ac;\">\n                  <div>Supplement<\u002Fdiv><div>Dosage<\u002Fdiv><div style=\"text-align:right;\">Runs out · date<\u002Fdiv>\n                <\u002Fdiv>\n                <sc-for list=\"{{ cdNutriItems }}\" as=\"n\" hint-placeholder-count=\"5\">\n                  <div style=\"display:grid;grid-template-columns:1.4fr 2fr 1.15fr;gap:0;align-items:center;padding:11px 16px;border-top:1px solid #f4f6fa;\">\n                    <div style=\"display:flex;align-items:center;gap:9px;min-width:0;\"><span style=\"{{ n.dotStyle }}\"><\u002Fspan><div style=\"min-width:0;\"><div style=\"font-size:12.5px;font-weight:700;color:#16233f;line-height:1.2;\">{{ n.name }}<\u002Fdiv><div style=\"font-size:10.5px;color:#9aa6b8;\">{{ n.when }}<\u002Fdiv><\u002Fdiv><\u002Fdiv>\n                    <div style=\"display:flex;gap:5px;flex-wrap:wrap;\">\n                      <sc-for list=\"{{ n.pills }}\" as=\"p\" hint-placeholder-count=\"1\"><span style=\"{{ p.pillStyle }}\">{{ p.label }} · {{ p.count }}<\u002Fspan><\u002Fsc-for>\n                    <\u002Fdiv>\n                    <div style=\"display:flex;align-items:center;justify-content:flex-end;gap:6px;\"><span style=\"font-size:11.5px;font-weight:700;color:#3a4a63;font-variant-numeric:tabular-nums;white-space:nowrap;\">{{ n.overDate }}<\u002Fspan><span style=\"{{ n.leftStyle }}\">{{ n.overLeft }}<\u002Fspan><\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fbutton>\n\n              <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:12px;padding:10px 14px;margin-bottom:10px;box-shadow:0 1px 2px rgba(16,35,63,.04);display:flex;align-items:center;gap:12px;flex-wrap:wrap;\">\n                <div style=\"display:flex;align-items:center;gap:7px;flex:0 0 auto;\"><span style=\"font-size:15px;\">💬<\u002Fspan><span style=\"font-size:12.5px;font-weight:700;color:#16233f;\">Message {{ drawerName }}<\u002Fspan><\u002Fdiv>\n                <input value=\"{{ cdMsg }}\" sc-camel-on-input=\"{{ onCdMsg }}\" placeholder=\"Write a message… pops up in their app\" style=\"flex:1;min-width:180px;height:36px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;color:#16233f;outline:none;\" style-focus=\"border-color:#5e6ad2;box-shadow:0 0 0 3px rgba(94,106,210,.14);\">\n                <button sc-camel-on-click=\"{{ sendCdMsg }}\" style=\"height:36px;padding:0 16px;border-radius:9px;border:none;background:#5e6ad2;color:#fff;font-weight:700;font-size:12.5px;cursor:pointer;flex:0 0 auto;\">Send<\u002Fbutton>\n              <\u002Fdiv>\n\n              <div style=\"background:#fff;border:1px solid #eef1f6;border-radius:12px;padding:10px 14px;margin-bottom:14px;box-shadow:0 1px 2px rgba(16,35,63,.04);display:flex;align-items:center;gap:8px;flex-wrap:wrap;\">\n                <div style=\"display:flex;align-items:center;gap:7px;flex:0 0 auto;\"><span style=\"font-size:15px;\">⏰<\u002Fspan><span style=\"font-size:12.5px;font-weight:700;color:#16233f;\">Reminders<\u002Fspan><\u002Fdiv>\n                <input value=\"{{ cdSchedName }}\" sc-camel-on-input=\"{{ onCdSchedName }}\" placeholder=\"Reminder (e.g. Take supplements)\" style=\"flex:1;min-width:150px;height:36px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;color:#16233f;outline:none;\" style-focus=\"border-color:#5e6ad2;\">\n                <input type=\"time\" value=\"{{ cdSchedTime }}\" sc-camel-on-input=\"{{ onCdSchedTime }}\" style=\"height:36px;padding:0 8px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12px;color:#16233f;outline:none;font-variant-numeric:tabular-nums;\">\n                <sc-raw-select value=\"{{ cdSchedRepeat }}\" sc-camel-on-change=\"{{ onCdSchedRepeat }}\" style=\"height:36px;padding:0 24px 0 10px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12px;color:#16233f;cursor:pointer;outline:none;\">\n                  <sc-for list=\"{{ cdRepeatOpts }}\" as=\"o\" hint-placeholder-count=\"7\"><option value=\"{{ o }}\">{{ o }}<\u002Foption><\u002Fsc-for>\n                <\u002Fsc-raw-select>\n                <button sc-camel-on-click=\"{{ addCdSched }}\" style=\"height:36px;padding:0 14px;border-radius:9px;border:none;background:#5e6ad2;color:#fff;font-weight:650;font-size:12.5px;cursor:pointer;flex:0 0 auto;\">Set<\u002Fbutton>\n                <button sc-camel-on-click=\"{{ openCdRemList }}\" style=\"height:36px;padding:0 13px;border-radius:9px;border:1px solid #e6ebf2;background:#fff;color:#5e6ad2;font-weight:650;font-size:12.5px;cursor:pointer;flex:0 0 auto;\">List ({{ cdSchedCount }})<\u002Fbutton>\n              <\u002Fdiv>\n              <\u002Fsc-if>\n\n              <div style=\"font-size:12px;font-weight:700;letter-spacing:.04em;color:#8a97ac;text-transform:uppercase;margin-bottom:10px;display:none;\">Jump to<\u002Fdiv>\n              <div style=\"display:none;flex-wrap:wrap;gap:8px;\">\n                <sc-for list=\"{{ cdJump }}\" as=\"j\" hint-placeholder-count=\"6\">\n                  <button sc-camel-on-click=\"{{ j.go }}\" style=\"height:36px;padding:0 14px;border-radius:9px;border:1px solid #e6ebf2;background:#fff;color:#16233f;font-weight:600;font-size:12.5px;cursor:pointer;\" style-hover=\"border-color:#5e6ad2;color:#5e6ad2;\">{{ j.label }} ›<\u002Fbutton>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <sc-if value=\"{{ mIsProfile }}\" hint-placeholder-val=\"{{ true }}\">\n              <div style=\"display:flex;align-items:flex-start;justify-content:space-between;gap:12px;\">\n                <div>\n                  <div style=\"font-size:19px;font-weight:740;letter-spacing:-.02em;margin-bottom:4px;\">Personal details<\u002Fdiv>\n                  <div style=\"font-size:13px;color:#8a97ac;margin-bottom:18px;\">{{ drawerEmail }}<\u002Fdiv>\n                <\u002Fdiv>\n                <div style=\"display:flex;gap:8px;flex:0 0 auto;\">\n                  <sc-if value=\"{{ duProfCanStart }}\" hint-placeholder-val=\"{{ false }}\">\n                    <button sc-camel-on-click=\"{{ duProfStart }}\" style=\"height:32px;padding:0 13px;display:flex;align-items:center;gap:7px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;color:#3a4a63;font-weight:640;font-size:12.5px;cursor:pointer;font-family:inherit;\" style-hover=\"border-color:#2b8f5b;color:#2b8f5b;\">{{ duProfEditIcon }} Edit<\u002Fbutton>\n                  <\u002Fsc-if>\n                  <sc-if value=\"{{ duProfEditing }}\" hint-placeholder-val=\"{{ false }}\">\n                    <button sc-camel-on-click=\"{{ duProfCancel }}\" style=\"height:32px;padding:0 13px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;color:#8a97ac;font-weight:600;font-size:12.5px;cursor:pointer;font-family:inherit;\">Cancel<\u002Fbutton>\n                    <button sc-camel-on-click=\"{{ duProfSave }}\" style=\"height:32px;padding:0 15px;border:none;border-radius:9px;background:#2b8f5b;color:#fff;font-weight:650;font-size:12.5px;cursor:pointer;font-family:inherit;\" style-hover=\"background:#23794c;\">Save changes<\u002Fbutton>\n                  <\u002Fsc-if>\n                <\u002Fdiv>\n              <\u002Fdiv>\n              <div style=\"display:flex;gap:8px;margin-bottom:18px;flex-wrap:wrap;align-items:center;\"><span style=\"{{ drawerTierStyle }}\">{{ drawerTier }}<\u002Fspan><sc-if value=\"{{ duCanConvert }}\" hint-placeholder-val=\"{{ false }}\"><button sc-camel-on-click=\"{{ duConvert }}\" title=\"Move this client up one tier by hand — for when the automatic upgrade did not go through\" style=\"height:24px;padding:0 10px;border-radius:999px;border:1px dashed #cbd5e6;background:#fff;color:#5e6ad2;font-size:10px;font-weight:750;letter-spacing:.02em;cursor:pointer;font-family:inherit;white-space:nowrap;\" style-hover=\"background:#eef0fc;border-color:#5e6ad2;\">{{ duConvertLabel }}<\u002Fbutton><\u002Fsc-if><sc-if value=\"{{ duCanDowngrade }}\" hint-placeholder-val=\"{{ false }}\"><button sc-camel-on-click=\"{{ duDowngrade }}\" title=\"{{ duDowngradeTitle }}\" style=\"height:24px;padding:0 10px;border-radius:999px;border:1px dashed #e3d4b4;background:#fff;color:#c2891b;font-size:10px;font-weight:750;letter-spacing:.02em;cursor:pointer;font-family:inherit;white-space:nowrap;\" style-hover=\"background:#fdf8ec;border-color:#c2891b;\">Move down to SEEK<\u002Fbutton><\u002Fsc-if><sc-if value=\"{{ duConverted }}\" hint-placeholder-val=\"{{ false }}\"><button sc-camel-on-click=\"{{ duRevert }}\" title=\"Undo this manual change\" style=\"height:24px;padding:0 10px;border-radius:999px;border:1px solid #e6ebf2;background:#f7f9fc;color:#8a97ac;font-size:10px;font-weight:700;cursor:pointer;font-family:inherit;white-space:nowrap;\" style-hover=\"color:#c0392b;\">Manual · undo<\u002Fbutton><\u002Fsc-if><span style=\"{{ drawerStatusStyle }}\"><span style=\"{{ drawerStatusDot }}\"><\u002Fspan>{{ drawerStatus }}<\u002Fspan><\u002Fdiv>\n              <div style=\"background:#fff;border:1px solid #e6ebf2;border-radius:12px;padding:4px 20px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n                <sc-for list=\"{{ drawerProfile }}\" as=\"p\" hint-placeholder-count=\"8\">\n                  <div style=\"display:flex;align-items:center;justify-content:space-between;gap:16px;padding:11px 0;border-bottom:1px solid #f4f6fa;min-height:42px;\">\n                    <span style=\"font-size:12.5px;color:#8a97ac;flex:0 0 auto;\">{{ p.k }}<\u002Fspan>\n                    <sc-if value=\"{{ p.editable }}\" hint-placeholder-val=\"{{ false }}\">\n                      <input value=\"{{ p.v }}\" sc-camel-on-input=\"{{ p.onEdit }}\" style=\"flex:1 1 auto;max-width:62%;height:32px;padding:0 10px;border:1px solid #dbe3ef;border-radius:8px;background:#fbfcfe;font-size:12.5px;font-weight:600;color:#16233f;text-align:right;outline:none;font-family:inherit;\" style-focus=\"border-color:#2b8f5b;background:#fff;\">\n                    <\u002Fsc-if>\n                    <sc-if value=\"{{ p.plain }}\" hint-placeholder-val=\"{{ true }}\">\n                      <span style=\"font-size:12.5px;font-weight:600;color:#16233f;text-align:right;\">{{ p.v }}<\u002Fspan>\n                    <\u002Fsc-if>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n              <sc-if value=\"{{ healthHidden }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"margin-top:16px;display:flex;align-items:center;gap:9px;background:#fdf6ec;border:1px solid #f6e2c2;border-radius:10px;padding:11px 14px;font-size:12px;color:#9a6a1c;\">{{ lockSmallIcon }} Some fields (contact, address) are hidden for your role by a data-point policy.<\u002Fdiv><\u002Fsc-if>\n            <\u002Fsc-if>\n\n            <sc-if value=\"{{ showLocked }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"display:flex;flex-direction:column;align-items:center;text-align:center;padding:60px 20px;\">\n                <div style=\"width:56px;height:56px;border-radius:14px;background:#fdf6ec;display:flex;align-items:center;justify-content:center;color:#c2661d;margin-bottom:14px;\">{{ lockSmallIcon }}<\u002Fdiv>\n                <div style=\"font-size:15px;font-weight:680;margin-bottom:5px;\">Restricted for your role<\u002Fdiv>\n                <div style=\"font-size:12.5px;color:#8a97ac;max-width:300px;\">This client's health data is hidden for the <b>{{ viewAsName }}<\u002Fb> role by a data-point policy.<\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <sc-if value=\"{{ showProtocol }}\" hint-placeholder-val=\"{{ false }}\">\n              <div style=\"font-size:19px;font-weight:740;letter-spacing:-.02em;margin-bottom:4px;\">Protocol settings<\u002Fdiv>\n              <div style=\"font-size:13px;color:#8a97ac;margin-bottom:18px;text-wrap:pretty;\">Step 9 of onboarding. {{ protoStatus }}<\u002Fdiv>\n              <div style=\"background:#fff;border:1px solid #e6ebf2;border-radius:14px;padding:17px 18px;box-shadow:0 1px 2px rgba(16,35,63,.04);margin-bottom:16px;\">\n                <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;flex-wrap:wrap;\">\n                  <div>\n                    <div style=\"font-size:13px;font-weight:750;color:#16233f;\">Working protocol<\u002Fdiv>\n                    <div style=\"font-size:11px;color:#9aa6b8;margin-top:2px;\">{{ protoDraftNote }}<\u002Fdiv>\n                  <\u002Fdiv>\n                  <sc-if value=\"{{ protoCanAct }}\" hint-placeholder-val=\"{{ true }}\">\n                    <div style=\"display:flex;gap:8px;\">\n                      <button sc-camel-on-click=\"{{ protoReset }}\" disabled=\"{{ protoResetOff }}\" style=\"{{ protoResetStyle }}\">Discard changes<\u002Fbutton>\n                      <button sc-camel-on-click=\"{{ protoSave }}\" disabled=\"{{ protoSaveOff }}\" style=\"{{ protoSaveStyle }}\">{{ protoSaveLabel }}<\u002Fbutton>\n                    <\u002Fdiv>\n                  <\u002Fsc-if>\n                <\u002Fdiv>\n\n                <div style=\"display:flex;flex-direction:column;gap:8px;\">\n                  <sc-for list=\"{{ protoPoints }}\" as=\"p\" hint-placeholder-count=\"3\">\n                    <div style=\"display:flex;align-items:center;gap:9px;\">\n                      <span style=\"{{ p.numStyle }}\">{{ p.num }}<\u002Fspan>\n                      <input value=\"{{ p.text }}\" sc-camel-on-input=\"{{ p.onEdit }}\" sc-camel-read-only=\"{{ protoReadOnly }}\" placeholder=\"Protocol point\" style=\"flex:1;min-width:0;height:38px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:13px;color:#16233f;outline:none;font-family:inherit;\" style-focus=\"border-color:#2b8f5b;\">\n                      <sc-if value=\"{{ protoCanAct }}\" hint-placeholder-val=\"{{ true }}\">\n                        <button sc-camel-on-click=\"{{ p.remove }}\" title=\"Remove point\" style=\"width:32px;height:32px;flex:0 0 32px;border:1px solid #eef1f6;border-radius:8px;background:#fff;color:#b6c1d1;cursor:pointer;font-family:inherit;font-size:15px;line-height:1;\" style-hover=\"color:#c0392b;border-color:#f6d0d1;\">×<\u002Fbutton>\n                      <\u002Fsc-if>\n                    <\u002Fdiv>\n                  <\u002Fsc-for>\n                  <sc-if value=\"{{ protoEmpty }}\" hint-placeholder-val=\"{{ false }}\">\n                    <div style=\"font-size:12.5px;color:#9aa6b8;padding:6px 0;\">No points yet. Add the first one below.<\u002Fdiv>\n                  <\u002Fsc-if>\n                <\u002Fdiv>\n\n                <sc-if value=\"{{ protoCanAct }}\" hint-placeholder-val=\"{{ true }}\">\n                  <div style=\"display:flex;gap:8px;margin-top:11px;flex-wrap:wrap;\">\n                    <input value=\"{{ protoNew }}\" sc-camel-on-input=\"{{ onProtoNew }}\" sc-camel-on-key-down=\"{{ onProtoKey }}\" placeholder=\"Add a protocol point and press Enter\" style=\"flex:1;min-width:200px;height:38px;padding:0 12px;border:1px dashed #cbd5e6;border-radius:9px;background:#fbfcfe;font-size:13px;color:#16233f;outline:none;font-family:inherit;\" style-focus=\"border-color:#2b8f5b;background:#fff;\">\n                    <button sc-camel-on-click=\"{{ protoAdd }}\" style=\"{{ protoAddStyle }}\">+ Add point<\u002Fbutton>\n                  <\u002Fdiv>\n                <\u002Fsc-if>\n              <\u002Fdiv>\n\n              <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin:2px 0 10px;flex-wrap:wrap;\">\n                <div style=\"font-size:12px;font-weight:700;letter-spacing:.04em;color:#8a97ac;text-transform:uppercase;\">History · {{ protoHistCount }}<\u002Fdiv>\n                <span style=\"font-size:11px;color:#9aa6b8;\">Every save is kept, newest first<\u002Fspan>\n              <\u002Fdiv>\n              <sc-if value=\"{{ protoHistEmpty }}\" hint-placeholder-val=\"{{ true }}\">\n                <div style=\"background:#fff;border:1px dashed #d5deeb;border-radius:12px;padding:30px 20px;text-align:center;font-size:12.5px;color:#9aa6b8;\">Nothing saved yet. Save the working protocol to start the history.<\u002Fdiv>\n              <\u002Fsc-if>\n              <div style=\"display:flex;flex-direction:column;gap:10px;\">\n                <sc-for list=\"{{ protoHist }}\" as=\"h\" hint-placeholder-count=\"2\">\n                  <div style=\"background:#fff;border:1px solid #e6ebf2;border-radius:12px;box-shadow:0 1px 2px rgba(16,35,63,.04);overflow:hidden;\">\n                    <button sc-camel-on-click=\"{{ h.toggle }}\" style=\"display:flex;align-items:center;gap:11px;width:100%;text-align:left;background:transparent;border:none;padding:13px 15px;cursor:pointer;font:inherit;\">\n                      <span style=\"{{ h.badge }}\">{{ h.version }}<\u002Fspan>\n                      <div style=\"flex:1;min-width:0;\">\n                        <div style=\"font-size:12.5px;font-weight:700;color:#16233f;\">{{ h.count }} points · {{ h.when }}<\u002Fdiv>\n                        <div style=\"font-size:11px;color:#9aa6b8;margin-top:2px;\">Saved by {{ h.by }}{{ h.delta }}<\u002Fdiv>\n                      <\u002Fdiv>\n                      <span style=\"{{ h.caretStyle }}\">{{ h.caret }}<\u002Fspan>\n                    <\u002Fbutton>\n                    <sc-if value=\"{{ h.open }}\" hint-placeholder-val=\"{{ false }}\">\n                      <div style=\"padding:2px 15px 14px;border-top:1px solid #f4f6fa;\">\n                        <div style=\"display:flex;flex-direction:column;gap:7px;margin:11px 0 12px;\">\n                          <sc-for list=\"{{ h.points }}\" as=\"pt\" hint-placeholder-count=\"3\">\n                            <div style=\"display:flex;gap:9px;align-items:flex-start;\">\n                              <span style=\"font-size:11px;font-weight:750;color:#b6c1d1;font-variant-numeric:tabular-nums;min-width:14px;