"<!DOCTYPE html>\n<html><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<script src=\"9e94dec1-7e04-4454-9cff-9d48495a32d7\"><\u002Fscript>\n<\u002Fhead>\n<body>\n<x-dc>\n<helmet>\n<style>\n@font-face{font-family:'Inter';src:url(\"b89b63ee-884e-45da-a8eb-c51e6f341a06\") format('truetype');font-weight:100 900;font-display:swap;}\n*{box-sizing:border-box;}\nhtml,body{margin:0;padding:0;}\nbody{font-family:'Inter',system-ui,sans-serif;background:#eef1f7;color:#16233f;-webkit-font-smoothing:antialiased;font-feature-settings:\"cv01\",\"ss03\";}\na{color:#2b8f5b;text-decoration:none;}\na:hover{color:#207347;}\n::-webkit-scrollbar{width:10px;height:10px;}\n::-webkit-scrollbar-thumb{background:#d3dae6;border-radius:8px;border:2px solid transparent;background-clip:content-box;}\n::-webkit-scrollbar-thumb:hover{background:#bcc6d6;background-clip:content-box;}\ninput,select,button{font-family:inherit;}\n@keyframes shimmer{0%{background-position:-560px 0;}100%{background-position:560px 0;}}\n.sk{background:linear-gradient(90deg,#eef1f6 25%,#e2e7f0 37%,#eef1f6 63%);background-size:560px 100%;animation:shimmer 1.3s infinite linear;border-radius:6px;}\n@keyframes fadein{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:none;}}\n@keyframes slidein{from{transform:translateX(100%);}to{transform:none;}}\n@keyframes toastpop{0%{opacity:0;transform:translateX(-50%) translateY(14px) scale(.94);}60%{transform:translateX(-50%) translateY(-2px) scale(1.02);}100%{opacity:1;transform:translateX(-50%) translateY(0) scale(1);}}\n@keyframes ringpulse{0%{box-shadow:0 0 0 0 rgba(94,106,210,.35);}70%{box-shadow:0 0 0 10px rgba(94,106,210,0);}100%{box-shadow:0 0 0 0 rgba(94,106,210,0);}}\n@keyframes risein{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:none;}}\n.pgcard:hover .pg-ins{opacity:1 !important;pointer-events:auto !important;transform:translateY(0) !important;}\n@keyframes prakglow{0%,100%{box-shadow:0 0 0 0 rgba(122,90,245,.28);}50%{box-shadow:0 0 0 6px rgba(122,90,245,0);}}\n@keyframes prakzen{0%,100%{transform:translateY(0) rotate(-4deg);}50%{transform:translateY(-2.5px) rotate(4deg);}}\n.prakchip{animation:prakglow 2.6s ease-in-out infinite;}\n.prakchip .prakemoji{display:inline-block;animation:prakzen 2.6s ease-in-out infinite;}\n.prakchip:hover .prakemoji{animation-duration:.7s;}\n@keyframes bellsplash{0%{opacity:0;transform:translate(-50%,-50%) scale(.25) rotate(-18deg);}25%{opacity:1;}45%{transform:translate(-50%,-50%) scale(1.15) rotate(12deg);}60%{transform:translate(-50%,-50%) scale(1.05) rotate(-8deg);}100%{opacity:0;transform:translate(-50%,-90%) scale(1.3) rotate(0deg);}}\n@keyframes splashring{0%{opacity:.55;transform:translate(-50%,-50%) scale(.3);}100%{opacity:0;transform:translate(-50%,-50%) scale(2.6);}}\n@keyframes courierwalk{0%{opacity:0;transform:translateX(-60vw);}16%{opacity:1;transform:translateX(0);}62%{opacity:1;transform:translateX(0);}100%{opacity:0;transform:translateX(62vw);}}\n@keyframes courierbob{0%,100%{}20%,60%{}30%{transform:translateY(-6px);}45%{transform:translateY(-3px);}}\n@keyframes bubbletalk{0%{opacity:0;transform:translate(-50%,12px) scale(.75);}16%{opacity:1;transform:translate(-50%,0) scale(1);}40%{opacity:1;}52%{opacity:0;transform:translate(-50%,-6px) scale(.9);}100%{opacity:0;}}\n@keyframes bubblesent{0%,52%{opacity:0;transform:translate(-50%,12px) scale(.75);}62%{opacity:1;transform:translate(-50%,0) scale(1.05);}70%{transform:translate(-50%,0) scale(1);}90%{opacity:1;}100%{opacity:0;transform:translate(-50%,-6px);}}\n@keyframes balloonrise{0%{opacity:0;transform:translateY(0) rotate(-4deg);}12%{opacity:1;}80%{opacity:1;}100%{opacity:0;transform:translateY(-115vh) rotate(4deg);}}\n@keyframes scoopdip{0%,100%{transform:rotate(0) translateY(0);}30%{transform:rotate(-32deg) translateY(1px);}55%{transform:rotate(18deg) translateY(-2px);}75%{transform:rotate(-8deg) translateY(0);}}\n.scoopanim{display:inline-block;animation:scoopdip 1.8s ease-in-out infinite;transform-origin:60% 80%;}\n@keyframes popscale{0%{opacity:0;transform:scale(.94);}100%{opacity:1;transform:scale(1);}}\n@keyframes emojipop{0%{transform:scale(1) rotate(0);}30%{transform:scale(1.4) rotate(-10deg);}55%{transform:scale(1.15) rotate(8deg);}75%{transform:scale(1.28) rotate(-4deg);}100%{transform:scale(1.22) rotate(0);}}\n.cdact:hover .cdemoji{animation:emojipop .55s cubic-bezier(.34,1.56,.64,1) forwards;display:inline-block;}\n@keyframes cdcenterpop{0%{opacity:0;transform:translate(-50%,-50%) scale(0) rotate(-22deg);}55%{opacity:1;transform:translate(-50%,-50%) scale(1.25) rotate(10deg);}78%{transform:translate(-50%,-50%) scale(.95) rotate(-4deg);}100%{opacity:.96;transform:translate(-50%,-50%) scale(1.1) rotate(0);}}\n.cdbig{position:absolute;top:46%;left:50%;transform:translate(-50%,-50%) scale(0);opacity:0;font-size:58px;pointer-events:none;filter:drop-shadow(0 8px 16px rgba(16,35,63,.22));z-index:2;}\n.cdact:hover .cdbig{animation:cdcenterpop .6s cubic-bezier(.34,1.56,.64,1) forwards;}\n@keyframes confettifall{0%{opacity:0;transform:translateY(0) rotate(0);}10%{opacity:1;}100%{opacity:.9;transform:translateY(108vh) rotate(540deg);}}\n@keyframes partybanner{0%{opacity:0;transform:translate(-50%,-50%) scale(.6);}30%{opacity:1;transform:translate(-50%,-50%) scale(1.08);}42%{transform:translate(-50%,-50%) scale(1);}82%{opacity:1;}100%{opacity:0;transform:translate(-50%,-50%) scale(1);}}\n@keyframes motivedash{0%{opacity:0;transform:translateY(-50%) translateX(-62vw);}18%{opacity:1;transform:translateY(-50%) translateX(0);}66%{opacity:1;transform:translateY(-50%) translateX(0);}100%{opacity:0;transform:translateY(-50%) translateX(64vw);}}\n@keyframes motivebob{0%,100%{transform:translateY(0) rotate(-3deg);}50%{transform:translateY(-7px) rotate(3deg);}}\n@keyframes motivebubble{0%{opacity:0;transform:translateX(-50%) translateY(10px) scale(.8);}18%{opacity:1;transform:translateX(-50%) translateY(0) scale(1);}80%{opacity:1;}100%{opacity:0;transform:translateX(-50%) translateY(-6px);}}\n@keyframes progrun{0%,100%{transform:translateY(0);}50%{transform:translateY(-5px);}}\n@keyframes progchew{0%,100%{transform:rotate(-9deg);}50%{transform:rotate(9deg) scale(1.1);}}\n@keyframes progfloat{0%,100%{transform:translateY(0) rotate(-5deg);}50%{transform:translateY(-4px) rotate(5deg);}}\n@keyframes progbeat{0%,100%{transform:scale(1);}18%{transform:scale(1.28);}36%{transform:scale(1);}54%{transform:scale(1.18);}}\n@keyframes progflutter{0%,100%{transform:rotate(-12deg) translateY(0);}50%{transform:rotate(12deg) translateY(-3px);}}\n.pgi{transition:font-size .15s ease;}\n.pgcard:hover .pgi{font-size:27px;filter:drop-shadow(0 5px 9px rgba(16,35,63,.28));}\n.pgcard{perspective:600px;}\n.pgcard .pgi{transform-origin:center bottom;}\n.pgcard:hover .pgi-fatloss{animation:hvrun .5s linear infinite !important;}\n.pgcard:hover .pgi-diabetes{animation:hveat .75s ease-in-out infinite !important;}\n.pgcard:hover .pgi-pcod{animation:hvbloom .9s ease-in-out infinite !important;}\n.pgcard:hover .pgi-hypertension{animation:hvbeat .8s ease-in-out infinite !important;}\n.pgcard:hover .pgi-thyroid{animation:hvflap .38s ease-in-out infinite !important;}\n@keyframes hvrun{0%{transform:translateX(-3px) translateZ(30px) rotate(-7deg);}25%{transform:translateX(0) translateY(-6px) translateZ(60px) rotate(5deg);}50%{transform:translateX(3px) translateZ(30px) rotate(7deg);}75%{transform:translateX(0) translateY(-6px) translateZ(60px) rotate(-5deg);}100%{transform:translateX(-3px) translateZ(30px) rotate(-7deg);}}\n@keyframes hveat{0%{transform:translateZ(0) scale(1);}38%{transform:translate(-5px,-4px) translateZ(70px) rotate(-16deg) scale(.9);}58%{transform:translate(-5px,-4px) translateZ(70px) rotate(-16deg) scale(.62);}70%{transform:translateZ(20px) scale(1.12);}100%{transform:translateZ(0) scale(1);}}\n@keyframes hvbloom{0%,100%{transform:translateZ(0) rotate(0) scale(1);}50%{transform:translateZ(80px) rotate(180deg) scale(1.35);}}\n@keyframes hvbeat{0%,100%{transform:translateZ(0) scale(1);}15%{transform:translateZ(90px) scale(1.55);}30%{transform:translateZ(0) scale(1);}45%{transform:translateZ(70px) scale(1.38);}60%{transform:translateZ(0) scale(1);}}\n@keyframes raindrop{0%{transform:translateY(-14vh) scaleY(.7);opacity:0;}12%{opacity:.85;}100%{transform:translateY(112vh) scaleY(1.15);opacity:.15;}}\n@keyframes rainsplash{0%{transform:scale(.3);opacity:.5;}100%{transform:scale(1.6);opacity:0;}}\n@keyframes hamswing{0%{transform:rotate(-58deg) scale(.8);opacity:0;}18%{opacity:1;}42%{transform:rotate(10deg) scale(1.04);}56%{transform:rotate(-10deg) scale(1);}72%{transform:rotate(4deg);}100%{transform:rotate(0) scale(1.06);opacity:0;}}\n@keyframes hamring{0%{transform:scale(.35);opacity:.5;}100%{transform:scale(2.2);opacity:0;}}\n@keyframes hamlabel{0%{transform:translateY(8px);opacity:0;}25%{transform:translateY(0);opacity:1;}75%{opacity:1;}100%{opacity:0;}}\n@keyframes stepblink{0%,100%{opacity:1;}50%{opacity:.3;}}\n@keyframes hvflap{0%,100%{transform:translateZ(20px) rotate(-24deg) translateY(0);}50%{transform:translateZ(80px) rotate(24deg) translateY(-7px);}}\n<\u002Fstyle>\n<script src=\"db3d8c25-99eb-46fd-b94a-d3601b2cfef4\"><\u002Fscript>\n<\u002Fhelmet>\n\n<div style=\"display:flex;height:100vh;width:100%;overflow:hidden;background:#eef1f7;\">\n\n  <aside style=\"width:250px;flex:0 0 250px;background:#ffffff;border-right:1px solid #e6ebf2;display:flex;flex-direction:column;height:100vh;\">\n    <div style=\"display:flex;align-items:center;gap:11px;padding:20px 18px;border-bottom:1px solid #eef1f6;\">\n      <div style=\"width:38px;height:38px;border-radius:10px;background:linear-gradient(135deg,#34a56a,#7cc79a);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:16px;flex:0 0 38px;box-shadow:0 2px 6px rgba(52,165,106,.35);\">IR<\u002Fdiv>\n      <div style=\"min-width:0;\">\n        <div style=\"font-weight:750;font-size:13.5px;letter-spacing:-.01em;color:#16233f;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">India Redefining Wellness<\u002Fdiv>\n        <div style=\"font-size:10.5px;letter-spacing:.14em;color:#8a97ac;font-weight:600;margin-top:1px;\">ADMIN CONSOLE<\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n    <nav style=\"flex:1;overflow-y:auto;padding:12px 10px;display:flex;flex-direction:column;gap:3px;\">\n      <sc-for list=\"{{ nav }}\" as=\"item\" hint-placeholder-count=\"6\">\n        <button sc-camel-on-click=\"{{ item.onClick }}\" style=\"{{ item.style }}\">\n          <span style=\"{{ item.iconWrap }}\">{{ item.icon }}<\u002Fspan>\n          <span>{{ item.label }}<\u002Fspan>\n          <sc-if value=\"{{ item.locked }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"margin-left:auto;font-size:10px;color:#c0c9d6;\">{{ item.lockGlyph }}<\u002Fspan><\u002Fsc-if>\n        <\u002Fbutton>\n      <\u002Fsc-for>\n    <\u002Fnav>\n    <div style=\"padding:12px 10px;border-top:1px solid #eef1f6;\">\n      <button style=\"display:flex;align-items:center;gap:11px;width:100%;padding:10px 12px;border:none;background:transparent;color:#8a97ac;font-size:13px;font-weight:600;border-radius:9px;cursor:pointer;text-align:left;\">\n        <span style=\"display:flex;\">{{ logoutIcon }}<\u002Fspan> Logout\n      <\u002Fbutton>\n    <\u002Fdiv>\n  <\u002Faside>\n\n  <div style=\"flex:1;display:flex;flex-direction:column;min-width:0;height:100vh;\">\n    <header style=\"height:62px;flex:0 0 62px;background:rgba(255,255,255,.85);backdrop-filter:blur(12px);border-bottom:1px solid #e6ebf2;display:flex;align-items:center;gap:12px;padding:0 16px;overflow-x:auto;z-index:20;\">\n      <div style=\"position:relative;flex:1 1 140px;min-width:120px;max-width:300px;\">\n        <span style=\"position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#9aa6b8;display:flex;\">{{ searchIcon }}<\u002Fspan>\n        <input placeholder=\"Search users, teams, policies…\" style=\"width:100%;height:38px;padding:0 12px 0 36px;border:1px solid #e6ebf2;border-radius:9px;background:#f6f8fb;font-size:13px;color:#16233f;outline:none;\">\n      <\u002Fdiv>\n      <div style=\"margin-left:auto;display:flex;align-items:center;gap:10px;min-width:0;flex:0 1 auto;\">\n        <sc-raw-select value=\"{{ uiState }}\" sc-camel-on-change=\"{{ setUiState }}\" title=\"Preview state\" style=\"flex:0 0 auto;height:34px;padding:0 22px 0 9px;border:1px solid #e6ebf2;border-radius:9px;background:#f2f4f9;font-size:11.5px;font-weight:650;color:#5a6b85;cursor:pointer;outline:none;\">\n          <option value=\"data\">Data<\u002Foption>\n          <option value=\"loading\">Loading<\u002Foption>\n          <option value=\"empty\">Empty<\u002Foption>\n        <\u002Fsc-raw-select>\n        <sc-if value=\"{{ isAdminRole }}\" hint-placeholder-val=\"{{ true }}\">\n          <div style=\"display:flex;align-items:center;gap:8px;padding:5px 6px 5px 12px;background:#f6f8fb;border:1px solid #e6ebf2;border-radius:10px;\">\n            <sc-raw-select value=\"{{ viewAs }}\" sc-camel-on-change=\"{{ onViewAs }}\" title=\"View the console as another role\" style=\"border:none;background:transparent;font-size:12.5px;font-weight:650;color:#16233f;outline:none;cursor:pointer;padding-right:2px;\">\n              <sc-for list=\"{{ roleOptions }}\" as=\"r\" hint-placeholder-count=\"4\"><option value=\"{{ r.id }}\">{{ r.label }}<\u002Foption><\u002Fsc-for>\n            <\u002Fsc-raw-select>\n          <\u002Fdiv>\n        <\u002Fsc-if>\n        <sc-if value=\"{{ notAdminRole }}\" hint-placeholder-val=\"{{ false }}\">\n          <div style=\"display:flex;align-items:center;gap:8px;padding:5px 6px 5px 12px;background:#f6f8fb;border:1px solid #e6ebf2;border-radius:10px;\">\n            <span style=\"font-size:12.5px;font-weight:650;color:#16233f;white-space:nowrap;\">{{ viewAsName }}<\u002Fspan>\n            <button sc-camel-on-click=\"{{ resetAdmin }}\" title=\"Back to the Admin view\" style=\"height:24px;padding:0 9px;border:1px solid #e6ebf2;border-radius:7px;background:#fff;color:#5e6ad2;font-weight:700;font-size:10.5px;cursor:pointer;font-family:inherit;white-space:nowrap;\">Admin<\u002Fbutton>\n          <\u002Fdiv>\n        <\u002Fsc-if>\n        <div style=\"display:inline-flex;gap:2px;background:#f2f5fa;border:1px solid #e6ebf2;border-radius:9px;padding:3px;flex:0 0 auto;\">\n          <button sc-camel-on-click=\"{{ setLangEn }}\" style=\"{{ langEnStyle }}\">EN<\u002Fbutton>\n          <button sc-camel-on-click=\"{{ setLangHi }}\" style=\"{{ langHiStyle }}\">हिं<\u002Fbutton>\n        <\u002Fdiv>\n        <div style=\"position:relative;\">\n          <button sc-camel-on-click=\"{{ toggleGlobalNotif }}\" title=\"Notifications\" style=\"position:relative;width:38px;height:38px;border-radius:10px;border:1px solid #e6ebf2;background:#f6f8fb;color:#5a6b85;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;\">🔔\n            <sc-if value=\"{{ gnHasUnread }}\" hint-placeholder-val=\"{{ true }}\"><span style=\"position:absolute;top:-4px;right:-4px;min-width:17px;height:17px;padding:0 4px;border-radius:999px;background:#e5484d;color:#fff;font-size:9.5px;font-weight:800;display:flex;align-items:center;justify-content:center;border:2px solid #fff;\">{{ gnUnread }}<\u002Fspan><\u002Fsc-if>\n          <\u002Fbutton>\n          <sc-if value=\"{{ gnOpen }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"position:absolute;top:46px;right:0;width:392px;max-height:440px;overflow-y:auto;background:#fff;border:1px solid #e6ebf2;border-radius:14px;box-shadow:0 24px 60px rgba(16,35,63,.24);z-index:70;animation:popscale .18s cubic-bezier(.2,1.1,.3,1) both;\">\n              <div style=\"display:flex;align-items:center;gap:9px;padding:13px 15px;border-bottom:1px solid #eef1f6;position:sticky;top:0;background:#fff;\">\n                <span style=\"font-size:14px;\">🔔<\u002Fspan>\n                <div style=\"flex:1;min-width:0;\"><div style=\"font-size:13px;font-weight:750;color:#16233f;\">Notifications<\u002Fdiv><div style=\"font-size:10.5px;color:#9aa6b8;\">{{ gnScopeNote }}<\u002Fdiv><\u002Fdiv>\n                <button sc-camel-on-click=\"{{ markAllRead }}\" style=\"height:26px;padding:0 10px;border-radius:7px;border:1px solid #e6ebf2;background:#fff;color:#5e6ad2;font-weight:700;font-size:10.5px;cursor:pointer;\">Mark all read<\u002Fbutton>\n              <\u002Fdiv>\n              <sc-if value=\"{{ gnEmpty }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"padding:26px;text-align:center;font-size:12px;color:#9aa6b8;\">Nothing new right now.<\u002Fdiv><\u002Fsc-if>\n              <sc-for list=\"{{ gnItems }}\" as=\"n\" hint-placeholder-count=\"5\">\n                <button sc-camel-on-click=\"{{ n.go }}\" class=\"cdact\" style=\"{{ n.rowStyle }}\">\n                  <span style=\"{{ n.iconWrap }}\">{{ n.icon }}<\u002Fspan>\n                  <span style=\"flex:1;min-width:0;display:flex;flex-direction:column;gap:2px;text-align:left;\">\n                    <span style=\"display:flex;align-items:center;gap:6px;flex-wrap:wrap;\"><span style=\"{{ n.kindStyle }}\">{{ n.kind }}<\u002Fspan><span style=\"font-size:9.5px;color:#b0bacb;\">{{ n.time }}<\u002Fspan><\u002Fspan>\n                    <span style=\"font-size:12px;font-weight:650;color:#16233f;line-height:1.35;text-wrap:pretty;\">{{ n.title }}<\u002Fspan>\n                    <span style=\"font-size:10.5px;color:#8a97ac;\">From {{ n.from }} · opens {{ n.dest }}<\u002Fspan>\n                  <\u002Fspan>\n                  <span style=\"color:#c0c9d6;font-size:15px;flex:0 0 auto;\">›<\u002Fspan>\n                <\u002Fbutton>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n        <\u002Fdiv>\n        <div style=\"display:flex;align-items:center;gap:9px;padding-left:4px;\">\n          <span style=\"{{ topBadge }}\">{{ viewAsName }}<\u002Fspan>\n          <button sc-camel-on-click=\"{{ openMyProfile }}\" title=\"My profile\" style=\"width:34px;height:34px;flex:0 0 34px;padding:0;border:none;border-radius:50%;background:linear-gradient(135deg,#34a56a,#7cc79a);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;font-family:inherit;cursor:pointer;box-shadow:0 1px 3px rgba(16,35,63,.18);\" style-hover=\"box-shadow:0 0 0 3px rgba(52,165,106,.22);\">{{ viewAsInitial }}<\u002Fbutton>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fheader>\n\n    <main style=\"flex:1;overflow-y:auto;padding:26px 30px 60px;\">\n\n      <sc-if value=\"{{ permissionDenied }}\" hint-placeholder-val=\"{{ false }}\">\n        <div style=\"max-width:520px;margin:8vh auto 0;text-align:center;animation:fadein .3s ease;\">\n          <div style=\"width:76px;height:76px;border-radius:20px;background:#fdeede;display:flex;align-items:center;justify-content:center;margin:0 auto 22px;color:#c2661d;\">{{ lockLargeIcon }}<\u002Fdiv>\n          <div style=\"font-size:22px;font-weight:750;letter-spacing:-.02em;margin-bottom:8px;\">You don't have access to this section<\u002Fdiv>\n          <p style=\"color:#5a6b85;font-size:14px;line-height:1.6;margin:0 auto 22px;max-width:400px;\">The <b>{{ viewAsName }}<\u002Fb> role isn't granted access to <b>{{ deniedViewName }}<\u002Fb>. Ask an administrator to attach a policy, or switch back to an Admin view.<\u002Fp>\n          <div style=\"display:flex;gap:10px;justify-content:center;\">\n            <button sc-camel-on-click=\"{{ backToDashboard }}\" style=\"height:40px;padding:0 18px;border-radius:9px;border:1px solid #e6ebf2;background:#fff;color:#16233f;font-weight:600;font-size:13px;cursor:pointer;\">Go to Dashboard<\u002Fbutton>\n            <button sc-camel-on-click=\"{{ resetAdmin }}\" style=\"height:40px;padding:0 18px;border-radius:9px;border:none;background:#34a56a;color:#fff;font-weight:600;font-size:13px;cursor:pointer;\">Switch to Admin<\u002Fbutton>\n          <\u002Fdiv>\n          <div style=\"margin-top:26px;padding:14px 16px;background:#fff;border:1px solid #e6ebf2;border-radius:10px;text-align:left;font-size:12.5px;color:#5a6b85;\">\n            <span style=\"color:#8a97ac;font-weight:600;\">Resolved:<\u002Fspan> hidden because <span style=\"color:#d64545;font-weight:600;\">role default deny<\u002Fspan> + no policy grant for this section.\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fsc-if>\n\n      <!-- DASHBOARD -->\n      <sc-if value=\"{{ showDashboard }}\" hint-placeholder-val=\"{{ false }}\">\n        <div style=\"animation:fadein .3s ease;\">\n          <div style=\"display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:22px;flex-wrap:wrap;gap:12px;\">\n            <div>\n              <h1 style=\"font-size:23px;font-weight:760;letter-spacing:-.025em;margin:0 0 4px;\">Dashboard<\u002Fh1>\n              <div style=\"font-size:13px;color:#8a97ac;display:flex;align-items:center;gap:7px;\"><span style=\"{{ scopeChip }}\">{{ scopeLabel }}<\u002Fspan>Updated just now<\u002Fdiv>\n            <\u002Fdiv>\n            <div style=\"display:flex;align-items:center;gap:9px;flex-wrap:wrap;\">\n              <sc-if value=\"{{ editable }}\" hint-placeholder-val=\"{{ true }}\">\n                <button style=\"height:38px;padding:0 16px;border-radius:9px;border:1px solid #e6ebf2;background:#fff;color:#16233f;font-weight:600;font-size:13px;cursor:pointer;display:flex;align-items:center;gap:7px;\">{{ exportIcon }} Export report<\u002Fbutton>\n              <\u002Fsc-if>\n              <button sc-camel-on-click=\"{{ saveNow }}\" title=\"{{ saveNowTitle }}\" style=\"{{ saveNowStyle }}\">{{ saveNowIcon }}<\u002Fbutton>\n            <\u002Fdiv>\n          <\u002Fdiv>\n\n          <sc-if value=\"{{ isLoading }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:18px;\">\n              <sc-for list=\"{{ eight }}\" as=\"n\" hint-placeholder-count=\"8\"><div style=\"background:#fff;border:1px solid #e6ebf2;border-radius:12px;padding:18px;\"><div class=\"sk\" style=\"width:38px;height:38px;border-radius:10px;margin-bottom:14px;\"><\u002Fdiv><div class=\"sk\" style=\"width:70%;height:26px;margin-bottom:8px;\"><\u002Fdiv><div class=\"sk\" style=\"width:50%;height:12px;\"><\u002Fdiv><\u002Fdiv><\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ isData }}\" hint-placeholder-val=\"{{ true }}\">\n            <sc-if value=\"{{ notAdminDash }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin:2px 0 10px;\">\n              <div style=\"font-size:12px;font-weight:700;letter-spacing:.04em;color:#8a97ac;text-transform:uppercase;\">{{ tQuickInsights }}<\u002Fdiv>\n              <span style=\"font-size:11px;color:#9aa6b8;\">Tap a card to jump to its section<\u002Fspan>\n            <\u002Fdiv>\n            <div style=\"display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:22px;\">\n              <sc-for list=\"{{ insights }}\" as=\"k\" hint-placeholder-count=\"8\">\n                <button sc-camel-on-click=\"{{ k.go }}\" class=\"cdact\" style=\"position:relative;overflow:hidden;text-align:left;background:#fff;border:1px solid #eef1f6;border-radius:12px;padding:13px 14px 12px;box-shadow:0 1px 2px rgba(16,35,63,.04);cursor:pointer;font:inherit;display:flex;flex-direction:column;gap:7px;transition:transform .15s ease,box-shadow .15s ease,border-color .15s ease;\" style-hover=\"border-color:#c5cbe8;box-shadow:0 6px 18px rgba(94,106,210,.12);transform:translateY(-2px);\">\n                  <span style=\"{{ k.topBar }}\"><\u002Fspan>\n                  <div style=\"display:flex;align-items:center;gap:9px;\">\n                    <span style=\"{{ k.iconWrap }}\">{{ k.icon }}<\u002Fspan>\n                    <span style=\"flex:1;font-size:11.5px;color:#5a6b85;font-weight:650;line-height:1.25;\">{{ k.label }}<\u002Fspan>\n                  <\u002Fdiv>\n                  <div style=\"font-size:24px;font-weight:800;letter-spacing:-.03em;font-variant-numeric:tabular-nums;line-height:1.05;{{ k.accent }}\">{{ k.value }}<\u002Fdiv>\n                  <sc-if value=\"{{ k.hasSub }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"font-size:10.5px;color:#9aa6b8;line-height:1.35;\">{{ k.sub }}<\u002Fdiv><\u002Fsc-if>\n                <\u002Fbutton>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n            <\u002Fsc-if>\n\n            <sc-if value=\"{{ isAdminDash }}\" hint-placeholder-val=\"{{ true }}\">\n              <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin:2px 0 10px;\">\n                <div style=\"font-size:12px;font-weight:700;letter-spacing:.04em;color:#8a97ac;text-transform:uppercase;\">{{ tUsers }}<\u002Fdiv>\n                <span style=\"font-size:11px;color:#9aa6b8;\">Tap a card to jump to its section<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"display:flex;align-items:stretch;gap:11px;margin-bottom:18px;\">\n                <div style=\"flex:1 1 0;min-width:0;display:flex;gap:9px;\">\n                  <sc-for list=\"{{ userInsightsA }}\" as=\"k\" hint-placeholder-count=\"2\">\n                    <button sc-camel-on-click=\"{{ k.go }}\" class=\"cdact\" style=\"position:relative;overflow:hidden;flex:1 1 0;min-width:0;text-align:left;background:#fff;border:1px solid #eef1f6;border-radius:12px;padding:12px 12px 11px;box-shadow:0 1px 2px rgba(16,35,63,.04);cursor:pointer;font:inherit;display:flex;flex-direction:column;gap:6px;transition:transform .15s ease,box-shadow .15s ease,border-color .15s ease;\" style-hover=\"border-color:#c5cbe8;box-shadow:0 6px 18px rgba(94,106,210,.12);transform:translateY(-2px);\">\n                      <span style=\"{{ k.topBar }}\"><\u002Fspan>\n                      <div style=\"display:flex;align-items:center;g