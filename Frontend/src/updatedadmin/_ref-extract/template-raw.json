ove }}\" title=\"Withdraw this slot\" style=\"border:none;background:transparent;padding:0 0 0 2px;color:#b6a068;font-size:13px;line-height:1;cursor:pointer;font-family:inherit;\">×<\u002Fbutton><\u002Fspan>\n                      <\u002Fsc-for>\n                    <\u002Fdiv>\n                    <div style=\"display:flex;align-items:center;justify-content:space-between;gap:9px;margin-top:10px;\">\n                      <span style=\"font-size:10.5px;color:#9aa6b8;\">{{ h.hint }}<\u002Fspan>\n                      <span style=\"display:flex;gap:7px;\">\n                        <button sc-camel-on-click=\"{{ h.offerMore }}\" style=\"height:28px;padding:0 11px;border:1px solid #dcdff7;border-radius:8px;background:#eef0fc;color:#5e6ad2;font-weight:700;font-size:11px;cursor:pointer;font-family:inherit;\">Offer more<\u002Fbutton>\n                        <button sc-camel-on-click=\"{{ h.release }}\" style=\"height:28px;padding:0 11px;border:1px solid #e6ebf2;border-radius:8px;background:#fff;color:#8a97ac;font-weight:640;font-size:11px;cursor:pointer;font-family:inherit;\">Release all<\u002Fbutton>\n                      <\u002Fspan>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n\n              <div style=\"font-size:12px;font-weight:700;letter-spacing:.04em;color:#8a97ac;text-transform:uppercase;margin:18px 0 9px;\">Awaiting confirmation · {{ calHeldCount }}<\u002Fdiv>\n              <sc-if value=\"{{ calHeldEmpty }}\" hint-placeholder-val=\"{{ true }}\">\n                <div style=\"background:#fff;border:1px dashed #d5deeb;border-radius:12px;padding:26px 20px;text-align:center;font-size:12.5px;color:#9aa6b8;text-wrap:pretty;\">No slots are on hold. Offer slots from a client's LAUNCH tab.<\u002Fdiv>\n              <\u002Fsc-if>\n              <div style=\"font-size:12px;font-weight:700;letter-spacing:.04em;color:#8a97ac;text-transform:uppercase;margin:18px 0 9px;\">Change requests · {{ calChangeCount }}<\u002Fdiv>\n              <sc-if value=\"{{ calChangeEmpty }}\" hint-placeholder-val=\"{{ true }}\">\n                <div style=\"background:#fff;border:1px dashed #d5deeb;border-radius:12px;padding:26px 20px;text-align:center;font-size:12.5px;color:#9aa6b8;text-wrap:pretty;\">No one has asked to move a session.<\u002Fdiv>\n              <\u002Fsc-if>\n              <div style=\"display:flex;flex-direction:column;gap:10px;\">\n                <sc-for list=\"{{ calChange }}\" as=\"c\" hint-placeholder-count=\"1\">\n                  <div style=\"background:#fff;border:1px solid #f6d9c7;border-radius:12px;padding:13px 15px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n                    <div style=\"display:flex;align-items:center;gap:9px;\">\n                      <span style=\"{{ c.avatar }}\">{{ c.initial }}<\u002Fspan>\n                      <div style=\"flex:1;min-width:0;\">\n                        <div style=\"font-size:13px;font-weight:730;color:#16233f;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">{{ c.client }}<\u002Fdiv>\n                        <div style=\"font-size:11px;color:#c2661d;margin-top:2px;\">{{ c.meta }}<\u002Fdiv>\n                      <\u002Fdiv>\n                    <\u002Fdiv>\n                    <div style=\"font-size:11.5px;color:#5a6b85;margin-top:8px;text-wrap:pretty;\">{{ c.reason }}<\u002Fdiv>\n                    <div style=\"font-size:10px;font-weight:750;letter-spacing:.05em;text-transform:uppercase;color:#8a97ac;margin:10px 0 6px;\">They prefer<\u002Fdiv>\n                    <div style=\"display:flex;gap:7px;flex-wrap:wrap;\">\n                      <sc-for list=\"{{ c.wants }}\" as=\"w\" hint-placeholder-count=\"2\">\n                        <button sc-camel-on-click=\"{{ w.accept }}\" title=\"Move the session here\" style=\"{{ w.style }}\">{{ w.label }}<\u002Fbutton>\n                      <\u002Fsc-for>\n                    <\u002Fdiv>\n                    <div style=\"display:flex;align-items:center;justify-content:space-between;gap:9px;margin-top:11px;\">\n                      <button sc-camel-on-click=\"{{ c.offer }}\" style=\"height:28px;padding:0 11px;border:1px solid #dcdff7;border-radius:8px;background:#eef0fc;color:#5e6ad2;font-weight:700;font-size:11px;cursor:pointer;font-family:inherit;\">Offer other slots<\u002Fbutton>\n                      <button sc-camel-on-click=\"{{ c.decline }}\" style=\"height:28px;padding:0 11px;border:1px solid #e6ebf2;border-radius:8px;background:#fff;color:#8a97ac;font-weight:640;font-size:11px;cursor:pointer;font-family:inherit;\">Keep as is<\u002Fbutton>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fsc-if>\n\n      <!-- CONFIGS -->\n      <sc-if value=\"{{ showConfigs }}\" hint-placeholder-val=\"{{ false }}\">\n        <div style=\"animation:fadein .3s ease;\">\n          <div style=\"display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:18px;flex-wrap:wrap;\"><div><h1 style=\"font-size:23px;font-weight:760;letter-spacing:-.025em;margin:0 0 4px;\">Configs<\u002Fh1><div style=\"font-size:13px;color:#8a97ac;\">Configuration groups scoped to the app, the web, or shared across both.<\u002Fdiv><\u002Fdiv>            <span style=\"flex:0 0 auto;margin-left:auto;\"><button sc-camel-on-click=\"{{ saveNow }}\" title=\"{{ saveNowTitle }}\" style=\"{{ saveNowStyle }}\">{{ saveNowIcon }}<\u002Fbutton><\u002Fspan>\n          <\u002Fdiv>\n          <div style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px;flex-wrap:wrap;\">\n            <div style=\"display:inline-flex;gap:3px;background:#eef1f6;border:1px solid #e6ebf2;border-radius:12px;padding:4px;\">\n              <sc-for list=\"{{ cfgTabs }}\" as=\"c\" hint-placeholder-count=\"3\"><button sc-camel-on-click=\"{{ c.pick }}\" style=\"{{ c.style }}\">{{ c.label }}<\u002Fbutton><\u002Fsc-for>\n            <\u002Fdiv>\n            <sc-if value=\"{{ cfgNotFeatures }}\" hint-placeholder-val=\"{{ true }}\">\n              <span style=\"font-size:11px;color:#9aa6b8;\">Tap the App / Web chip on a row to enable it per surface<\u002Fspan>\n            <\u002Fsc-if>\n          <\u002Fdiv>\n\n          <sc-if value=\"{{ cfgReadOnly }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"display:flex;align-items:center;gap:9px;background:#fbf3df;border:1px solid #f2e2a8;border-radius:11px;padding:10px 14px;margin-bottom:14px;\">\n              <span style=\"font-size:14px;\">🔒<\u002Fspan>\n              <span style=\"font-size:12px;font-weight:650;color:#8a6d00;\">{{ cfgRoleNote }}<\u002Fspan>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-if value=\"{{ cfgEmpty }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px dashed #d5deeb;border-radius:14px;padding:60px 28px;text-align:center;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"width:52px;height:52px;border-radius:14px;background:#f2f5fa;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;font-size:22px;\">{{ cfgIcon }}<\u002Fdiv>\n              <div style=\"font-size:15px;font-weight:700;color:#16233f;margin-bottom:5px;\">No {{ cfgScopeLabel }}-only configs<\u002Fdiv>\n              <div style=\"font-size:12.5px;color:#8a97ac;max-width:380px;margin:0 auto;line-height:1.55;text-wrap:pretty;\">{{ cfgScopeHint }}<\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <sc-for list=\"{{ cfgGroups }}\" as=\"g\" hint-placeholder-count=\"4\">\n            <div style=\"font-size:12px;font-weight:700;letter-spacing:.04em;color:#8a97ac;text-transform:uppercase;margin:2px 0 9px;\">{{ g.name }}<\u002Fdiv>\n            <div style=\"background:#fff;border:1px solid #e6ebf2;border-radius:12px;overflow:hidden;margin-bottom:16px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <sc-for list=\"{{ g.items }}\" as=\"m\" hint-placeholder-count=\"2\">\n                <div style=\"display:flex;align-items:center;gap:14px;padding:11px 16px;border-bottom:1px solid #f1f4f9;\">\n                  <div style=\"flex:1;min-width:0;\">\n                    <div style=\"display:flex;align-items:center;gap:7px;flex-wrap:wrap;\">\n                      <span style=\"font-size:13px;font-weight:700;color:#16233f;letter-spacing:-.01em;\">{{ m.name }}<\u002Fspan>\n                      <sc-for list=\"{{ m.surfaces }}\" as=\"sf\" hint-placeholder-count=\"2\"><button sc-camel-on-click=\"{{ sf.toggle }}\" title=\"Enable or disable on this surface\" style=\"{{ sf.style }}\">{{ sf.label }}<span style=\"{{ sf.dot }}\"><\u002Fspan><\u002Fbutton><\u002Fsc-for>\n                      <sc-for list=\"{{ m.caps }}\" as=\"cp\" hint-placeholder-count=\"2\"><span style=\"{{ cp.style }}\">{{ cp.label }}<\u002Fspan><\u002Fsc-for>\n                    <\u002Fdiv>\n                    <div style=\"font-size:11.5px;color:#9aa6b8;margin-top:1px;text-wrap:pretty;\">{{ m.note }} <span style=\"color:#c0c9d6;\">·<\u002Fspan> {{ m.owner }}<\u002Fdiv>\n                  <\u002Fdiv>\n                  <div style=\"display:flex;align-items:center;gap:9px;flex:0 0 auto;width:150px;justify-content:flex-end;\">\n                    <sc-if value=\"{{ m.hasToggle }}\" hint-placeholder-val=\"{{ true }}\"><span style=\"{{ m.statusStyle }}\">{{ m.statusLabel }}<\u002Fspan><\u002Fsc-if>\n                    <sc-if value=\"{{ m.hasToggle }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ m.toggle }}\" style=\"{{ m.sw }}\"><span style=\"{{ m.knob }}\"><\u002Fspan><\u002Fbutton><\u002Fsc-if>\n                  <\u002Fdiv>\n                  <button sc-camel-on-click=\"{{ m.open }}\" style=\"height:30px;padding:0 12px;border-radius:8px;border:1px solid #e6ebf2;background:#fff;color:#5e6ad2;font-weight:650;font-size:11.5px;cursor:pointer;white-space:nowrap;flex:0 0 auto;\">Manage ›<\u002Fbutton>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n          \n        <\u002Fdiv>\n      <\u002Fsc-if>\n\n    <\u002Fmain>\n  <\u002Fdiv>\n\n  <sc-if value=\"{{ nmModalOpen }}\" hint-placeholder-val=\"{{ false }}\">\n    <div sc-camel-on-click=\"{{ closeNmModal }}\" style=\"position:fixed;inset:0;z-index:90;background:rgba(16,35,63,.42);display:flex;align-items:center;justify-content:center;padding:20px;animation:fadein .2s ease both;\">\n      <div sc-camel-on-click=\"{{ cdStop }}\" style=\"width:460px;max-width:94vw;background:#fff;border-radius:16px;box-shadow:0 30px 80px rgba(16,35,63,.4);animation:popscale .24s cubic-bezier(.2,1.1,.3,1) both;\">\n        <div style=\"display:flex;align-items:center;gap:10px;padding:16px 18px 12px;border-bottom:1px solid #eef1f6;\">\n          <span style=\"font-size:17px;\">👤<\u002Fspan>\n          <div style=\"flex:1;\"><div style=\"font-size:15px;font-weight:750;color:#16233f;\">Create a team member<\u002Fdiv><div style=\"font-size:11px;color:#9aa6b8;\">Works for every role<\u002Fdiv><\u002Fdiv>\n          <button sc-camel-on-click=\"{{ closeNmModal }}\" style=\"width:30px;height:30px;border:none;background:#f2f5fa;border-radius:8px;color:#5a6b85;font-size:16px;cursor:pointer;\">×<\u002Fbutton>\n        <\u002Fdiv>\n        <div style=\"padding:16px 18px;display:flex;flex-direction:column;gap:9px;\">\n          <input value=\"{{ nmName }}\" sc-camel-on-input=\"{{ onNmName }}\" placeholder=\"Full name\" style=\"height:40px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:13px;color:#16233f;outline:none;\" style-focus=\"border-color:#5e6ad2;\">\n          <input value=\"{{ nmMobile }}\" sc-camel-on-input=\"{{ onNmMobile }}\" placeholder=\"Mobile number\" style=\"height:40px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:13px;color: