ight:700;font-size:12px;cursor:pointer;\">Send broadcast<\u002Fbutton>\n                  <div style=\"font-size:9.5px;color:#9aa6b8;margin-top:7px;\">Last sent {{ commLastSent }}<\u002Fdiv>\n                <\u002Fdiv>\n\n                <div style=\"flex:1 1 0;min-width:0;background:#fffdf5;border:1.5px solid #f2d675;border-radius:12px;padding:11px 13px;box-shadow:0 1px 2px rgba(16,35,63,.04);display:flex;flex-direction:column;\">\n                  <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:8px;\"><span style=\"font-size:15px;\">🏆<\u002Fspan><span style=\"font-size:11.5px;font-weight:750;color:#16233f;\">Champion<\u002Fspan><\u002Fdiv>\n                  <div style=\"flex:1;display:grid;grid-template-columns:1fr 1fr;gap:10px;\">\n                    <div style=\"min-width:0;display:flex;flex-direction:column;\">\n                      <div style=\"font-size:8.5px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:#a9861a;margin-bottom:5px;\">Client<\u002Fdiv>\n                      <div style=\"flex:1;display:flex;gap:6px;overflow-x:auto;padding-bottom:2px;align-items:stretch;\">\n                        <sc-for list=\"{{ champClients }}\" as=\"c\" hint-placeholder-count=\"2\">\n                          <div style=\"flex:0 0 auto;min-width:96px;background:#fff;border:1px solid #f6e6bb;border-radius:9px;padding:9px 11px;display:flex;flex-direction:column;justify-content:center;gap:3px;\">\n                            <span style=\"font-size:11px;font-weight:680;color:#16233f;white-space:nowrap;\">{{ c.name }}<\u002Fspan>\n                            <span style=\"font-size:12.5px;font-weight:780;color:#b8860b;font-variant-numeric:tabular-nums;\">{{ c.score }}<\u002Fspan>\n                          <\u002Fdiv>\n                        <\u002Fsc-for>\n                      <\u002Fdiv>\n                    <\u002Fdiv>\n                    <div style=\"min-width:0;display:flex;flex-direction:column;\">\n                      <