al }}<\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                  <div sc-camel-on-click=\"{{ stop }}\" style=\"display:flex;align-items:center;gap:6px;min-width:0;flex-wrap:wrap;\">\n                    <span style=\"{{ u.tierStyle }}\">{{ u.tierText }}<\u002Fspan>\n                    <sc-if value=\"{{ u.canConvert }}\" hint-placeholder-val=\"{{ false }}\"><button sc-camel-on-click=\"{{ u.convert }}\" title=\"{{ u.convertTitle }}\" style=\"height:20px;padding:0 7px;border-radius:999px;border:1px dashed #cbd5e6;background:#fff;color:#5e6ad2;font-size:9px;font-weight:750;letter-spacing:.02em;cursor:pointer;white-space:nowrap;font-family:inherit;\" style-hover=\"background:#eef0fc;border-color:#5e6ad2;\">{{ u.convertLabel }}<\u002Fbutton><\u002Fsc-if>\n                    <sc-if value=\"{{ u.canDowngrade }}\" hint-placeholder-val=\"{{ false }}\"><button sc-camel-on-click=\"{{ u.downgrade }}\" title=\"{{ u.downgradeTitle }}\" style=\"height:20px;padding:0 7px;border-radius:999px;border:1px dashed #e3d4b4;background:#fff;color:#c2891b;font-size:9px;font-weight:750;letter-spacing:.02em;cursor:pointer;white-space:nowrap;font-family:inherit;\" style-hover=\"background:#fdf8ec;border-color:#c2891b;\">↓ SEEK<\u002Fbutton><\u002Fsc-if>\n                    <sc-if value=\"{{ u.converted }}\" hint-placeholder-val=\"{{ false }}\"><button sc-camel-on-click=\"{{ u.revert }}\" title=\"Undo this manual change\" style=\"border:none;background:transparent;padding:0;color:#b6c1d1;font-size:9px;font-weight:700;cursor:pointer;white-space:nowrap;font-family:inherit;\" style-hover=\"color:#c0392b;\">undo<\u002Fbutton><\u002Fsc-if>\n                  <\u002Fdiv>\n                  <div sc-camel-on-click=\"{{ stop }}\">\n                    <sc-if value=\"{{ editable }}\" hint-placeholder-val=\"{{ true }}\">\n                      <sc-raw-select value=\"{{ u.coach }}\" sc-camel-on-change=\"{{ u.reassignWc }}\" title=\"Reassign wellness coach\" style=\"width:100%;height:30px;padding:0 20px 0 8px;border:1px solid #e6ebf2;border-radius:8px;background:#fff;font-size:11.5px;color:#16233f;font-weight:600;cursor:pointer;outline:none;\" style-focus=\"border-color:#5e6ad2;\">\n                        <sc-for list=\"{{ wcOpts }}\" as=\"o\" hint-placeholder-count=\"6\"><option value=\"{{ o.id }}\">{{ o.label }}<\u002Foption><\u002Fsc-for>\n                      <\u002Fsc-raw-select>\n                    <\u002Fsc-if>\n                    <sc-if value=\"{{ readOnly }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-size:12.5px;color:#5a6b85;\">{{ u.coach }}<\u002Fspan><\u002Fsc-if>\n                  <\u002Fdiv>\n                  <div sc-camel-on-click=\"{{ stop }}\">\n                    <sc-if value=\"{{ editable }}\" hint-placeholder-val=\"{{ true }}\">\n                      <sc-raw-select value=\"{{ u.awc }}\" sc-camel-on-change=\"{{ u.reassignAwc }}\" title=\"Reassign assistant coach\" style=\"width:100%;height:30px;padding:0 20px 0 8px;border:1px solid #e6ebf2;border-radius:8px;background:#fff;font-size:11.5px;color:#16233f;font-weight:600;cursor:pointer;outline:none;\" style-focus=\"border-color:#5e6ad2;\">\n                        <sc-for list=\"{{ awcOpts }}\" as=\"o\" hint-placeholder-count=\"8\"><option value=\"{{ o.id }}\">{{ o.label }}<\u002Foption><\u002Fsc-for>\n                      <\u002Fsc-raw-select>\n                    <\u002Fsc-if>\n                    <sc-if value=\"{{ readOnly }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-size:12.5px;color:#5a6b85;\">{{ u.awcLabel }}<\u002Fspan><\u002Fsc-if>\n                  <\u002Fdiv>\n                  <div style=\"font-size:12.5px;color:#8a97ac;font-variant-numeric:tabular-nums;\">{{ u.lastActive }}<\u002Fdiv>\n                  <div><span style=\"{{ u.statusStyle }}\"><span style=\"{{ u.statusDot }}\"><\u002Fspan>{{ u.status }}<\u002Fspan><\u002Fdiv>\n                  <div sc-camel-on-click=\"{{ stop }}\" style=\"display:flex;justify-content:flex-end;\">\n                    <sc-if value=\"{{ u.canDelete }}\" hint-placeholder-val=\"{{ false }}\">\n                      <button sc-camel-on-click=\"{{ u.askDelete }}\" title=\"{{ u.deleteTitle }}\" style=\"width:28px;height:28px;display:flex;align-items:center;justify-content:center;border:1px solid #eef1f6;border-radius:8px;background:#fff;color:#b6c1d1;cursor:pointer;transition:all .12s;\" style-hover=\"color:#c0392b;border-color:#f6d0d1;background:#fdeaea;\">{{ trashIcon }}<\u002Fbutton>\n                    <\u002Fsc-if>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fsc-if>\n          <\u002Fdiv>\n\n          <sc-if value=\"{{ delUserOpen }}\" hint-placeholder-val=\"{{ false }}\">\n            <div sc-camel-on-click=\"{{ cancelDelUser }}\" style=\"position:fixed;inset:0;background:rgba(11,22,40,.42);backdrop-filter:blur(2px);z-index:120;display:flex;align-items:center;justify-content:center;padding:20px;\">\n              <div sc-camel-on-click=\"{{ stop }}\" style=\"width:100%;max-width:400px;background:#fff;border:1px solid #e6ebf2;border-radius:14px;box-shadow:0 18px 50px rgba(16,35,63,.22);padding:22px;\">\n                <div style=\"display:flex;align-items:center;gap:11px;margin-bottom:12px;\">\n                  <div style=\"width:38px;height:38px;flex:0 0 38px;border-radius:10px;background:#fdeaea;color:#c0392b;display:flex;align-items:center;justify-content:center;\">{{ trashIcon }}<\u002Fdiv>\n                  <div style=\"font-size:16px;font-weight:720;letter-spacing:-.01em;color:#16233f;\">Delete {{ delUserName }}?<\u002Fdiv>\n                <\u002Fdiv>\n                <div style=\"font-size:12.5px;color:#8a97ac;line-height:1.6;text-wrap:pretty;margin-bottom:18px;\">This removes the client record, their coach assignment and all tracked history. This cannot be undone.<\u002Fdiv>\n                <div style=\"display:flex;gap:9px;justify-content:flex-end;\">\n                  <button sc-camel-on-click=\"{{ cancelDelUser }}\" style=\"height:36px;padding:0 15px;border-radius:9px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-weight:600;font-size:12.5px;cursor:pointer;font-family:inherit;\">Cancel<\u002Fbutton>\n                  <button sc-camel-on-click=\"{{ confirmDelUser }}\" style=\"height:36px;padding:0 16px;border-radius:9px;border:none;background:#c0392b;color:#fff;font-weight:650;font-size:12.5px;cursor:pointer;font-family:inherit;\" style-hover=\"background:#a53023;\">Delete user<\u002Fbutton>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n        <\u002Fdiv>\n      <\u002Fsc-if>\n\n      <!-- ACCESS CONTROL (HERO) -->\n      <sc-if value=\"{{ showAccess }}\" hint-placeholder-val=\"{{ false }}\">\n        <div style=\"animation:fadein .3s ease;\">\n          <div style=\"display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:18px;flex-wrap:nowrap;\">\n            <div style=\"flex:1 1 auto;min-width:0;\">\n            <h1 style=\"font-size:23px;font-weight:760;letter-spacing:-.025em;margin:0 0 4px;\">Access Control<\u002Fh1>\n            <div style=\"font-size:13px;color:#8a97ac;\">Hybrid RBAC — role baselines plus attachable policies. Precedence: <b style=\"color:#d64545;\">deny<\u002Fb> › <b style=\"color:#2b8f5b;\">allow<\u002Fb> › role default.<\u002Fdiv>\n            <\u002Fdiv>\n            <span style=\"flex:0 0 auto;margin-left:auto;\"><button sc-camel-on-click=\"{{ saveNow }}\" title=\"{{ saveNowTitle }}\" style=\"{{ saveNowStyle }}\">{{ saveNowIcon }}<\u002Fbutton><\u002Fspan>\n          <\u002Fdiv>\n\n          <div style=\"display:flex;gap:4px;background:#eef1f7;border:1px solid #e6ebf2;border-radius:11px;padding:4px;width:fit-content;margin-bottom:20px;\">\n            <button sc-camel-on-click=\"{{ acRoles }}\" style=\"{{ acRolesBtn }}\">Roles &amp; permissions<\u002Fbutton>\n            <button sc-camel-on-click=\"{{ acPolicies }}\" style=\"{{ acPoliciesBtn }}\">Policy library<\u002Fbutton>\n            <button sc-camel-on-click=\"{{ acSim }}\" style=\"{{ acSimBtn }}\">View as… simulator<\u002Fbutton>\n            <button sc-camel-on-click=\"{{ acApprovals }}\" style=\"{{ acApprovalsBtn }}\">Approvals<sc-if value=\"{{ acApprHasPending }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"margin-left:7px;font-size:10px;font-weight:750;color:#9a7a00;background:#fdf6e3;border:1px solid #f2e2a8;border-radius:999px;padding:1px 6px;font-variant-numeric:tabular-nums;\">{{ acApprPendingCount }}<\u002Fspan><\u002Fsc-if><\u002Fbutton>\n            <button sc-camel-on-click=\"{{ acAudit }}\" style=\"{{ acAuditBtn }}\">Audit log<\u002Fbutton>\n          <\u002Fdiv>\n\n          <!-- ROLES TAB -->\n          <sc-if value=\"{{ acIsRoles }}\" hint-placeholder-val=\"{{ true }}\">\n            <div style=\"display:grid;grid-template-columns:270px 1fr;gap:18px;align-items:start;\">\n              <div style=\"background:#fff;border:1px solid #e6ebf2;border-radius:12px;padding:12px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n                <div style=\"display:flex;justify-content:space-between;align-items:center;padding:6px 8px 12px;\">\n                  <span style=\"font-size:11px;font-weight:700;letter-spacing:.06em;color:#8a97ac;text-transform:uppercase;\">Roles<\u002Fspan>\n                  <button sc-camel-on-click=\"{{ createRole }}\" style=\"font-size:12px;font-weight:650;color:#2b8f5b;background:#e7f6ee;border:none;border-radius:7px;padding:5px 9px;cursor:pointer;\">+ Create<\u002Fbutton>\n                <\u002Fdiv>\n                <sc-for list=\"{{ roleList }}\" as=\"r\" hint-placeholder-count=\"4\">\n                  <button sc-camel-on-click=\"{{ r.select }}\" style=\"{{ r.style }}\">\n                    <div style=\"display:flex;align-items:center;gap:9px;\">\n                      <span style=\"{{ r.dot }}\"><\u002Fspan>\n                      <div style=\"text-align:left;\"><div style=\"font-size:13px;font-weight:650;color:#16233f;\">{{ r.name }}<\u002Fdiv><div style=\"font-size:11px;color:#8a97ac;\">{{ r.userCount }} users · {{ r.scope }}<\u002Fdiv><\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fbutton>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n\n              <div style=\"background:#fff;border:1px solid #e6ebf2;border-radius:12px;box-shadow:0 1px 2px rgba(16,35,63,.04);overflow:hidden;\">\n                <div style=\"padding:18px 22px;border-bottom:1px solid #eef1f6;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;\">\n                  <div>\n                    <div style=\"display:flex;align-items:center;gap:10px;\"><span style=\"{{ selRoleBadge }}\">{{ selRoleName }}<\u002Fspan><span style=\"font-size:12px;color:#8a97ac;\">permission editor<\u002Fspan><\u002Fdiv>\n                    <div style=\"font-size:12.5px;color:#8a97ac;margin-top:6px;\">{{ selRoleDesc }}<\u002Fdiv>\n                  <\u002Fdiv>\n                  <div style=\"display:flex;align-items:center;gap:8px;\">\n                    <span style=\"font-size:11.5px;color:#8a97ac;font-weight:600;\">Data scope<\u002Fspan>\n                    <div style=\"display:flex;gap:2px;background:#f2f4f9;border:1px solid #e6ebf2;border-radius:9px;padding:3px;\">\n                      <button sc-camel-on-click=\"{{ scopeAll }}\" style=\"{{ scopeAllBtn }}\">All<\u002Fbutton>\n                      <button sc-camel-on-click=\"{{ scopeTeam }}\" style=\"{{ scopeTeamBtn }}\">Team<\u002Fbutton>\n                      <button sc-camel-on-click=\"{{ scopeAssigned }}\" style=\"{{ scopeAssignedBtn }}\">Assigned<\u002Fbutton>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n\n                <div style=\"display:flex;align-items:center;gap:16px;padding:11px 22px;background:#fafbfd;border-bottom:1px solid #eef1f6;font-size:11.5px;color:#8a97ac;\">\n                  <span style=\"display:flex;align-items:center;gap:6px;\"><span style=\"width:11px;height:11px;border-radius:3px;background:#e7f6ee;border:1px solid #bfe6cf;\"><\u002Fspan>Allow<\u002Fspan>\n                  <span style=\"display:flex;align-items:center;gap:6px;\"><span style=\"width:11px;height:11px;border-radius:3px;background:#fdecec;border:1px solid #f5c6c6;\"><\u002Fspan>Deny<\u002Fspan>\n                  <span style=\"display:flex;align-items:center;gap:6px;\"><span style=\"width:11px;height:11px;border-radius:3px;background:#f3f5f9;border:1px solid #e3e8f0;\"><\u002Fspan>Inherit (role default)<\u002Fspan>\n                  <span style=\"margin-left:auto;\">Click any cell to cycle · expand a feature to set field-level visibility<\u002Fspan>\n                <\u002Fdiv>\n\n                <div style=\"overflow-x:auto;\">\n                  <div style=\"min-width:920px;\">\n                    <div style=\"display:grid;grid-template-columns:300px repeat(7,1fr);gap:6px;padding:12px 22px;border-bottom:1px solid #eef1f6;position:sticky;top:0;background:#fff;\">\n                      <div style=\"font-size:11px;font-weight:700;letter-spacing:.05em;color:#8a97ac;text-transform:uppercase;align-self:center;\">Feature / data point<\u002Fdiv>\n                      <sc-for list=\"{{ actionCols }}\" as=\"a\" hint-placeholder-count=\"7\"><div style=\"font-size:10.5px;font-weight:700;letter-spacing:.03em;color:#8a97ac;text-transform:uppercase;text-align:center;align-self:center;\">{{ a.label }}<\u002Fdiv><\u002Fsc-for>\n                    <\u002Fdiv>\n                    <sc-for list=\"{{ matrixRows }}\" as=\"row\" hint-placeholder-count=\"6\">\n                      <div style=\"{{ row.rowStyle }}\">\n                        <div style=\"{{ row.labelStyle }}\">\n                          <sc-if value=\"{{ row.isFeature }}\" hint-placeholder-val=\"{{ true }}\">\n                            <button sc-camel-on-click=\"{{ row.toggle }}\" style=\"width:20px;height:20px;border:none;background:transparent;cursor:pointer;color:#9aa6b8;display:flex;align-items:center;justify-content:center;padding:0;\">{{ row.caret }}<\u002Fbutton>\n                            <span style=\"font-weight:650;font-size:13px;color:#16233f;\">{{ row.label }}<\u002Fspan>\n                            <span style=\"font-size:10px;color:#a7b2c2;font-weight:600;background:#f2f5fa;padding:2px 6px;border-radius:5px;\">{{ row.section }}<\u002Fspan>\n                          <\u002Fsc-if>\n                          <sc-if value=\"{{ row.isDp }}\" hint-placeholder-val=\"{{ false }}\">\n                            <span style=\"font-size:12.5px;color:#5a6b85;\">{{ row.label }}<\u002Fspan>\n                            <label style=\"margin-left:auto;display:flex;align-items:center;gap:6px;font-size:10.5px;color:#8a97ac;cursor:pointer;\">\n                              <span>{{ row.visLabel }}<\u002Fspan>\n                              <button sc-camel-on-click=\"{{ row.toggleVis }}\" style=\"{{ row.visSwitch }}\"><span style=\"{{ row.visKnob }}\"><\u002Fspan><\u002Fbutton>\n                            <\u002Flabel>\n                          <\u002Fsc-if>\n                        <\u002Fdiv>\n                        <sc-for list=\"{{ row.cells }}\" as=\"c\" hint-placeholder-count=\"7\"><button sc-camel-on-click=\"{{ c.onClick }}\" style=\"{{ c.style }}\">{{ c.label }}<\u002Fbutton><\u002Fsc-for>\n                      <\u002Fdiv>\n                    <\u002Fsc-for>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <!-- POLICY LIBRARY -->\n          <sc-if value=\"{{ acIsPolicies }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;\">\n              <div style=\"font-size:13px;color:#8a97ac;\">Reusable allow/deny grants. Attach to a role or an individual user.<\u002Fdiv>\n              <button sc-camel-on-click=\"{{ createPolicy }}\" style=\"height:38px;padding:0 16px;border-radius:9px;border:none;background:linear-gradient(180deg,#ee8351,#e56d34);color:#fff;font-weight:650;font-size:13px;cursor:pointer;box-shadow:0 2px 6px rgba(229,109,52,.35);\">+ Create policy<\u002Fbutton>\n            <\u002Fdiv>\n            <div style=\"display:grid;grid-template-columns:repeat(2,1fr);gap:16px;\">\n              <sc-for list=\"{{ policies }}\" as=\"p\" hint-placeholder-count=\"4\">\n                <div style=\"background:#fff;border:1px solid #e6ebf2;border-radius:12px;padding:18px 20px;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n                  <div style=\"display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;\">\n                    <div><div style=\"font-weight:680;font-size:15px;letter-spacing:-.01em;\">{{ p.name }}<\u002Fdiv><div style=\"font-size:12px;color:#8a97ac;margin-top:3px;\">{{ p.desc }}<\u002Fdiv><\u002Fdiv>\n                    <span style=\"{{ p.scopeStyle }}\">{{ p.scope }}<\u002Fspan>\n                  <\u002Fdiv>\n                  <div style=\"display:flex;flex-direction:column;gap:6px;margin-bottom:14px;\">\n                    <sc-for list=\"{{ p.rules }}\" as=\"ru\" hint-placeholder-count=\"2\"><div style=\"display:flex;align-items:center;gap:8px;font-size:12px;\"><span style=\"{{ ru.badge }}\">{{ ru.type }}<\u002Fspan><span style=\"color:#5a6b85;\">{{ ru.text }}<\u002Fspan><\u002Fdiv><\u002Fsc-for>\n                  <\u002Fdiv>\n                  <div style=\"display:flex;align-items:center;justify-content:space-between;padding-top:12px;border-top:1px solid #f1f4f9;\">\n                    <div style=\"font-size:11.5px;color:#9aa6b8;\">Attached to <b style=\"color:#5a6b85;\">{{ p.attachedCount }}<\u002Fb><\u002Fdiv>\n                    <div style=\"display:flex;gap:8px;\">\n                      <button style=\"height:32px;padding:0 12px;border-radius:8px;border:1px solid #e6ebf2;background:#fff;font-size:12.5px;font-weight:600;color:#5a6b85;cursor:pointer;\">Edit<\u002Fbutton>\n                      <button sc-camel-on-click=\"{{ p.attach }}\" style=\"height:32px;padding:0 12px;border-radius:8px;border:none;background:#e7f6ee;color:#2b8f5b;font-size:12.5px;font-weight:650;cursor:pointer;\">Attach<\u002Fbutton>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <!-- SIMULATOR -->\n          <sc-if value=\"{{ acIsSim }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #e6ebf2;border-radius:12px;box-shadow:0 1px 2px rgba(16,35,63,.04);overflow:hidden;max-width:860px;\">\n              <div style=\"padding:18px 22px;border-bottom:1px solid #eef1f6;display:flex;align-items:center;gap:14px;flex-wrap:wrap;\">\n                <div style=\"font-weight:680;font-size:15px;\">Previewing access as<\u002Fdiv>\n                <sc-raw-select value=\"{{ simRole }}\" sc-camel-on-change=\"{{ onSimRole }}\" style=\"height:38px;padding:0 32px 0 14px;border:1px solid #e6ebf2;border-radius:9px;background:#f6f8fb;font-size:13px;font-weight:600;color:#16233f;outline:none;cursor:pointer;\">\n                  <sc-for list=\"{{ simOptions }}\" as=\"o\" hint-placeholder-count=\"5\"><option value=\"{{ o.id }}\">{{ o.label }}<\u002Foption><\u002Fsc-for>\n                <\u002Fsc-raw-select>\n                <span style=\"{{ simBadge }}\">scope: {{ simScope }}<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"padding:8px 0;\">\n                <sc-for list=\"{{ simRows }}\" as=\"s\" hint-placeholder-count=\"6\">\n                  <div style=\"display:flex;align-items:center;gap:14px;padding:13px 22px;border-bottom:1px solid #f4f6fa;\">\n                    <span style=\"{{ s.iconWrap }}\">{{ s.icon }}<\u002Fspan>\n                    <div style=\"flex:1;\"><div style=\"font-size:13.5px;font-weight:620;color:#16233f;\">{{ s.feature }}<\u002Fdiv><div style=\"font-size:11.5px;color:#9aa6b8;margin-top:2px;\">{{ s.reason }}<\u002Fdiv><\u002Fdiv>\n                    <span style=\"{{ s.pill }}\">{{ s.verdict }}<\u002Fspan>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <!-- APPROVALS -->\n          <sc-if value=\"{{ acIsApprovals }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"max-width:900px;\">\n              <div style=\"font-size:13px;color:#8a97ac;margin-bottom:16px;text-wrap:pretty;\">{{ acApprNote }}<\u002Fdiv>\n              <sc-if value=\"{{ acApprEmpty }}\" hint-placeholder-val=\"{{ false }}\">\n                <div style=\"background:#fff;border:1px solid #e6ebf2;border-radius:12px;padding:52px 20px;text-align:center;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n                  <div style=\"font-size:15px;font-weight:700;color:#16233f;margin-bottom:5px;\">Nothing waiting on you<\u002Fdiv>\n                  <div style=\"font-size:12.5px;color:#8a97ac;\">Permission and role requests raised by a Wellness Coach land here.<\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-if>\n              <div style=\"display:flex;flex-direction:column;gap:10px;\">\n                <sc-for list=\"{{ acApprRows }}\" as=\"a\" hint-placeholder-count=\"3\">\n                  <div style=\"{{ a.cardStyle }}\">\n                    <div style=\"display:flex;align-items:flex-start;gap:12px;flex-wrap:wrap;\">\n                      <span style=\"{{ a.kindStyle }}\">{{ a.kind }}<\u002Fspan>\n                      <div style=\"flex:1;min-width:0;\">\n                        <div style=\"font-size:13.5px;font-weight:700;color:#16233f;text-wrap:pretty;\">{{ a.title }}<\u002Fdiv>\n                        <div style=\"font-size:11.5px;color:#8a97ac;margin-top:3px;\">{{ a.meta }}<\u002Fdiv>\n                      <\u002Fdiv>\n                      <div style=\"display:flex;align-items:center;gap:8px;flex:0 0 auto;\">\n                        <sc-if value=\"{{ a.pending }}\" hint-placeholder-val=\"{{ true }}\">\n                          <sc-if value=\"{{ acApprCanDecide }}\" hint-placeholder-val=\"{{ true }}\">\n                            <button sc-camel-on-click=\"{{ a.reject }}\" style=\"height:31px;padding:0 12px;border:1px solid #f6d0d1;border-radius:8px;background:#fff;color:#c0392b;font-weight:640;font-size:11.5px;cursor:pointer;font-family:inherit;\">Reject<\u002Fbutton>\n                            <button sc-camel-on-click=\"{{ a.approve }}\" style=\"height:31px;padding:0 14px;border:none;border-radius:8px;background:#2b8f5b;color:#fff;font-weight:650;font-size:11.5px;cursor:pointer;font-family:inherit;\">Approve<\u002Fbutton>\n                          <\u002Fsc-if>\n                          <sc-if value=\"{{ acApprReadOnly }}\" hint-placeholder-val=\"{{ false }}\">\n                            <span style=\"{{ a.statusStyle }}\">{{ a.statusLabel }}<\u002Fspan>\n                          <\u002Fsc-if>\n                        <\u002Fsc-if>\n                        <sc-if value=\"{{ a.decided }}\" hint-placeholder-val=\"{{ false }}\">\n                          <span style=\"{{ a.statusStyle }}\">{{ a.statusLabel }}<\u002Fspan>\n                        <\u002Fsc-if>\n                      <\u002Fdiv>\n                    <\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n\n          <!-- AUDIT LOG -->\n          <sc-if value=\"{{ acIsAudit }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"max-width:900px;\">\n              <div style=\"font-size:13px;color:#8a97ac;margin-bottom:14px;\">Every access change and staff activity, newest first. Requests, approvals, rejections, direct admin edits and what each member did.<\u002Fdiv>\n              <div style=\"display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:12px;\">\n                <div style=\"position:relative;\">\n                  <span style=\"position:absolute;left:11px;top:50%;transform:translateY(-50%);color:#9aa6b8;display:flex;\">{{ searchIcon }}<\u002Fspan>\n                  <input value=\"{{ acLogQ }}\" sc-camel-on-input=\"{{ onAcLogQ }}\" placeholder=\"Search name, user ID, phone, coach or event\" style=\"width:330px;max-width:100%;height:36px;padding:0 12px 0 34px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;color:#16233f;outline:none;font-family:inherit;\" style-focus=\"border-color:#5e6ad2;\">\n                <\u002Fdiv>\n                <sc-raw-select value=\"{{ acLogKind }}\" sc-camel-on-change=\"{{ onAcLogKind }}\" style=\"height:36px;padding:0 30px 0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12.5px;font-weight:600;color:#16233f;cursor:pointer;outline:none;font-family:inherit;\">\n                  <option value=\"\">All types<\u002Foption>\n                  <option value=\"Role\">Role changes<\u002Foption>\n                  <option value=\"Permission\">Permission changes<\u002Foption>\n                  <option value=\"Activity\">Activity<\u002Foption>\n                <\u002Fsc-raw-select>\n                <span style=\"font-size:11.5px;color:#9aa6b8;font-variant-numeric:tabular-nums;\">{{ acLogCount }}<\u002Fspan>\n                <sc-if value=\"{{ acLogFiltered }}\" hint-placeholder-val=\"{{ false }}\">\n                  <button sc-camel-on-click=\"{{ clearAcLog }}\" style=\"height:36px;padding:0 13px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;color:#5a6b85;font-weight:600;font-size:12px;cursor:pointer;font-family:inherit;\">Clear<\u002Fbutton>\n                <\u002Fsc-if>\n              <\u002Fdiv>\n              <div style=\"background:#fff;border:1px solid #e6ebf2;border-radius:12px;overflow-x:auto;overflow-y:hidden;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n                <div style=\"display:grid;grid-template-columns:84px minmax(240px,1fr) 148px 104px 84px;gap:12px;min-width:760px;padding:11px 18px;background:#f7f9fc;border-bottom:1px solid #eef1f6;font-size:10.5px;font-weight:700;letter-spacing:.05em;color:#8a97ac;text-transform:uppercase;\">\n                  <div>Type<\u002Fdiv><div>Event<\u002Fdiv><div>Subject<\u002Fdiv><div>Actor<\u002Fdiv><div>When<\u002Fdiv>\n                <\u002Fdiv>\n                <sc-if value=\"{{ acLogEmpty }}\" hint-placeholder-val=\"{{ false }}\">\n                  <div style=\"padding:44px 20px;text-align:center;\">\n                    <div style=\"font-size:14px;font-weight:700;color:#16233f;margin-bottom:5px;\">No entries match<\u002Fdiv>\n                    <div style=\"font-size:12.5px;color:#8a97ac;\">Try a member name, user ID (IRW-1234), phone number, coach name or an action.<\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-if>\n                <sc-for list=\"{{ acAuditRows }}\" as=\"l\" hint-placeholder-count=\"6\">\n                  <div style=\"display:grid;grid-template-columns:84px minmax(240px,1fr) 148px 104px 84px;gap:12px;min-width:760px;padding:12px 18px;border-bottom:1px solid #f4f6fa;align-items:center;\">\n                    <div><span style=\"{{ l.kindStyle }}\">{{ l.kind }}<\u002Fspan><\u002Fdiv>\n                    <div style=\"min-width:0;\"><div style=\"font-size:12.5px;font-weight:620;color:#16233f;text-wrap:pretty;\">{{ l.text }}<\u002Fdiv><div style=\"font-size:11px;color:#9aa6b8;margin-top:2px;\">{{ l.detail }}<\u002Fdiv><\u002Fdiv>\n                    <div style=\"min-width:0;\"><div style=\"font-size:12px;font-weight:620;color:#16233f;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">{{ l.subject }}<\u002Fdiv><div style=\"font-size:10.5px;color:#9aa6b8;font-variant-numeric:tabular-nums;\">{{ l.subjectMeta }}<\u002Fdiv><\u002Fdiv>\n                    <div style=\"font-size:11.5px;color:#5a6b85;\">{{ l.actor }}<\u002Fdiv>\n                    <div style=\"font-size:11.5px;color:#9aa6b8;font-variant-numeric:tabular-nums;\">{{ l.when }}<\u002Fdiv>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n        <\u002Fdiv>\n      <\u002Fsc-if>\n\n      <!-- TEAMS -->\n      <sc-if value=\"{{ showTeams }}\" hint-placeholder-val=\"{{ false }}\">\n        <div style=\"animation:fadein .3s ease;\">\n          <div style=\"display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:20px;flex-wrap:nowrap;gap:12px;\">\n            <div style=\"flex:1 1 auto;min-width:0;\"><h1 style=\"font-size:23px;font-weight:760;letter-spacing:-.025em;margin:0 0 4px;\">Teams &amp; roles<\u002Fh1><div style=\"font-size:13px;color:#8a97ac;\">Each team = 1 Wellness Coach + N assistants + assigned clients. Manage every staff role below.<\u002Fdiv><\u002Fdiv>\n            <div style=\"display:flex;align-items:center;gap:9px;flex:0 0 auto;margin-left:auto;\">\n  <sc-if value=\"{{ editable }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ openNmModal }}\" style=\"height:38px;padding:0 16px;border-radius:9px;border:none;background:linear-gradient(180deg,#ee8351,#e56d34);color:#fff;font-weight:650;font-size:13px;cursor:pointer;box-shadow:0 2px 6px rgba(229,109,52,.35);\">+ Create team member<\u002Fbutton><\u002Fsc-if>\n              <button sc-camel-on-click=\"{{ saveNow }}\" title=\"{{ saveNowTitle }}\" style=\"{{ saveNowStyle }}\">{{ saveNowIcon }}<\u002Fbutton>\n            <\u002Fdiv>\n          <\u002Fdiv>\n          <div style=\"font-size:12px;font-weight:700;letter-spacing:.04em;color:#8a97ac;text-transform:uppercase;margin:2px 0 10px;\">{{ tTeam }}<\u002Fdiv>\n          <div style=\"display:inline-flex;gap:3px;background:#eef1f6;border:1px solid #e6ebf2;border-radius:12px;padding:4px;margin-bottom:16px;flex-wrap:nowrap;overflow-x:auto;max-width:100%;\">\n            <sc-for list=\"{{ teamRoleTabs }}\" as=\"t\" hint-placeholder-count=\"5\"><button sc-camel-on-click=\"{{ t.pick }}\" style=\"{{ t.style }}\">{{ t.label }} · {{ t.count }}<\u002Fbutton><\u002Fsc-for>\n          <\u002Fdiv>\n\n          <sc-if value=\"{{ staffFilterOn }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"display:inline-flex;align-items:center;gap:9px;background:#eef0fc;border:1px solid #dcdff7;border-radius:10px;padding:7px 12px;margin-bottom:12px;\">\n              <span style=\"font-size:11.5px;font-weight:650;color:#5e6ad2;\">Filter: {{ staffFilterLabel }}<\u002Fspan>\n              <button sc-camel-on-click=\"{{ clearStaffFilter }}\" title=\"Clear\" style=\"border:none;background:transparent;color:#8f9adf;cursor:pointer;font-size:15px;line-height:1;\">×<\u002Fbutton>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n          <sc-if value=\"{{ teamRoleIsStaff }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"background:#fff;border:1px solid #e6ebf2;border-radius:12px;overflow:hidden;box-shadow:0 1px 2px rgba(16,35,63,.04);\">\n              <div style=\"display:grid;grid-template-columns:2fr 1.4fr 1.3fr 1fr 110px;gap:12px;padding:12px 20px;background:#f7f9fc;border-bottom:1px solid #eef1f6;font-size:10.5px;font-weight:700;letter-spacing:.05em;color:#8a97ac;text-transform:uppercase;\">\n                <div>Name<\u002Fdiv><div>Role<\u002Fdiv><div>{{ staffCol3 }}<\u002Fdiv><div>Status<\u002Fdiv><div style=\"text-align:right;\">Actions<\u002Fdiv>\n              <\u002Fdiv>\n              <sc-for list=\"{{ staffRoster }}\" as=\"m\" hint-placeholder-count=\"6\">\n                <div sc-camel-on-click=\"{{ m.manage }}\" class=\"cdact\" style=\"display:grid;grid-template-columns:2fr 1.4fr 1.3fr 1fr 110px;gap:12px;padding:13px 20px;border-bottom:1px solid #f1f4f9;align-items:center;cursor:pointer;\">\n                  <div style=\"display:flex;align-items:center;gap:11px;min-width:0;\">\n                    <span style=\"{{ m.avatar }}\">{{ m.initial }}<\u002Fspan>\n                    <div style=\"min-width:0;\"><div style=\"font-size:13px;font-weight:650;color:#16233f;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">{{ m.name }}<\u002Fdiv><div style=\"font-size:11.5px;color:#9aa6b8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">{{ m.email }}<\u002Fdiv><\u002Fdiv>\n                  <\u002Fdiv>\n                  <div><span style=\"{{ m.roleStyle }}\">{{ m.role }}<\u002Fspan><\u002Fdiv>\n                  <div style=\"font-size:12px;color:#5a6b85;\">{{ m.meta }}<\u002Fdiv>\n                  <div><span style=\"{{ m.statusStyle }}\">{{ m.status }}<\u002Fspan><\u002Fdiv>\n                  <div style=\"display:flex;gap:6px;justify-content:flex-end;\">\n                    <sc-if value=\"{{ editable }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ m.remind }}\" title=\"Send reminder\" style=\"width:28px;height:28px;border-radius:8px;border:1px solid #dcdff7;background:#eef0fc;color:#5e6ad2;font-size:12px;line-height:1;cursor:pointer;\">🔔<\u002Fbutton><\u002Fsc-if>\n                    <button sc-camel-on-click=\"{{ m.manage }}\" style=\"height:28px;padding:0 10px;border-radius:8px;border:1px solid #e6ebf2;background:#fff;color:#5e6ad2;font-weight:650;font-size:11px;cursor:pointer;\">{{ staffOpenLabel }}<\u002Fbutton>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n        <\u002Fdiv>\n      <\u002Fsc-if>\n\n      <!-- FEATURES -->\n      <sc-if value=\"{{ showMyContent }}\" hint-placeholder-val=\"{{ false }}\">\n        <div style=\"animation:fadein .3s ease;\">\n          <div style=\"display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:20px;flex-wrap:wrap;\">\n            <div>\n              <h1 style=\"font-size:23px;font-weight:760;letter-spacing:-.025em;margin:0 0 4px;\">My Content<\u002Fh1>\n              <div style=\"font-size:13px;color:#8a97ac;text-wrap:pretty;\">{{ mcSubtitle }}<\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fdiv>\n\n          <sc-for list=\"{{ mcPeople }}\" as=\"p\" hint-placeholder-count=\"3\">\n            <div style=\"background:#fff;border:1px solid #e6ebf2;border-radius:14px;margin-bottom:14px;box-shadow:0 1px 2px rgba(16,35,63,.04);overflow:hidden;\">\n              <div style=\"display:flex;align-items:center;gap:12px;padding:14px 18px;border-bottom:1px solid #f1f4f9;background:#fbfcfe;\">\n                <span style=\"{{ p.avatar }}\">{{ p.initial }}<\u002Fspan>\n                <div style=\"flex:1;min-width:0;\">\n                  <div style=\"font-size:14.5px;font-weight:730;letter-spacing:-.01em;color:#16233f;\">{{ p.name }}<\u002Fdiv>\n                  <div style=\"font-size:11.5px;color:#9aa6b8;margin-top:2px;\">{{ p.role }} · {{ p.meta }}<\u002Fdiv>\n                <\u002Fdiv>\n                <span style=\"{{ p.liveStyle }}\">{{ p.liveLabel }}<\u002Fspan>\n              <\u002Fdiv>\n              <div style=\"padding:14px 18px;display:flex;flex-direction:column;gap:10px;\">\n                <sc-for list=\"{{ p.items }}\" as=\"c\" hint-placeholder-count=\"2\">\n                  <div style=\"{{ c.rowStyle }}\">\n                    <span style=\"{{ c.iconWrap }}\">{{ c.icon }}<\u002Fspan>\n                    <div style=\"flex:1;min-width:0;\">\n                      <div style=\"font-size:13px;font-weight:700;color:#16233f;\">{{ c.label }}<\u002Fdiv>\n                      <div style=\"font-size:11.5px;color:#9aa6b8;margin-top:2px;\">{{ c.meta }}<\u002Fdiv>\n                    <\u002Fdiv>\n                    <span style=\"{{ c.statusStyle }}\">{{ c.statusLabel }}<\u002Fspan>\n                    <button sc-camel-on-click=\"{{ c.view }}\" style=\"height:32px;padding:0 12px;border-radius:9px;border:1px solid #e6ebf2;background:#fff;color:#5a6b85;font-weight:650;font-size:11.5px;cursor:pointer;flex:0 0 auto;\">View<\u002Fbutton>\n                    <sc-if value=\"{{ c.canEdit }}\" hint-placeholder-val=\"{{ true }}\">\n                      <button sc-camel-on-click=\"{{ c.upload }}\" style=\"height:32px;padding:0 12px;border-radius:9px;border:1px solid #dcdff7;background:#eef0fc;color:#5e6ad2;font-weight:700;font-size:11.5px;cursor:pointer;flex:0 0 auto;\">{{ c.uploadLabel }}<\u002Fbutton>\n                      <button sc-camel-on-click=\"{{ c.toggle }}\" style=\"{{ c.sw }}\"><span style=\"{{ c.knob }}\"><\u002Fspan><\u002Fbutton>\n                    <\u002Fsc-if>\n                  <\u002Fdiv>\n                <\u002Fsc-for>\n              <\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n\n          <sc-if value=\"{{ mcReadOnly }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"font-size:12px;color:#9aa6b8;\">View only for your role — ask your wellness coach or an admin to upload or hide these.<\u002Fdiv>\n          <\u002Fsc-if>\n        <\u002Fdiv>\n      <\u002Fsc-if>\n\n      <!-- CALENDAR -->\n      <sc-if value=\"{{ showCalendar }}\" hint-placeholder-val=\"{{ false }}\">\n        <div style=\"animation:fadein .3s ease;\">\n          <div style=\"display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:18px;flex-wrap:wrap;\">\n            <div>\n              <h1 style=\"font-size:23px;font-weight:760;letter-spacing:-.025em;margin:0 0 4px;\">Calendar<\u002Fh1>\n              <div style=\"font-size:13px;color:#8a97ac;text-wrap:pretty;\">Confirmed sessions block your time. Slots you offer a client are held until they pick one — the rest are released automatically.<\u002Fdiv>\n            <\u002Fdiv>\n            <div style=\"display:flex;align-items:center;gap:14px;flex:0 0 auto;\">\n              <sc-for list=\"{{ calLegend }}\" as=\"l\" hint-placeholder-count=\"3\">\n                <span style=\"display:flex;align-items:center;gap:6px;font-size:11px;color:#8a97ac;\"><span style=\"{{ l.dot }}\"><\u002Fspan>{{ l.label }}<\u002Fspan>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fdiv>\n\n          <div style=\"display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:11px;\">\n            <div style=\"display:flex;gap:4px;\">\n              <button sc-camel-on-click=\"{{ calPrev }}\" title=\"Previous week\" style=\"width:32px;height:32px;display:flex;align-items:center;justify-content:center;border:1px solid #e6ebf2;border-radius:9px;background:#fff;color:#5a6b85;cursor:pointer;font-family:inherit;\">{{ calPrevIcon }}<\u002Fbutton>\n              <button sc-camel-on-click=\"{{ calNext }}\" title=\"Next week\" style=\"width:32px;height:32px;display:flex;align-items:center;justify-content:center;border:1px solid #e6ebf2;border-radius:9px;background:#fff;color:#5a6b85;cursor:pointer;font-family:inherit;\">{{ calNextIcon }}<\u002Fbutton>\n            <\u002Fdiv>\n            <div style=\"font-size:13px;font-weight:730;color:#16233f;\">{{ calRangeLabel }}<\u002Fdiv>\n            <button sc-camel-on-click=\"{{ calToday }}\" style=\"height:32px;padding:0 12px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;color:#5e6ad2;font-weight:700;font-size:12px;cursor:pointer;font-family:inherit;\">Today<\u002Fbutton>\n            <label style=\"display:flex;align-items:center;gap:7px;margin-left:auto;font-size:11px;color:#9aa6b8;\">Jump to\n              <input type=\"date\" value=\"{{ calJumpISO }}\" sc-camel-on-change=\"{{ onCalJump }}\" style=\"height:32px;padding:0 9px;border:1px solid #e6ebf2;border-radius:9px;background:#fff;font-size:12px;font-weight:700;color:#16233f;outline:none;font-family:inherit;cursor:pointer;\">\n            <\u002Flabel>\n          <\u002Fdiv>\n          <div style=\"display:flex;gap:7px;flex-wrap:wrap;margin-bottom:16px;\">\n            <sc-for list=\"{{ calDays }}\" as=\"d\" hint-placeholder-count=\"7\">\n              <button sc-camel-on-click=\"{{ d.pick }}\" style=\"{{ d.style }}\">\n                <span style=\"font-size:10px;font-weight:750;letter-spacing:.06em;text-transform:uppercase;opacity:.7;\">{{ d.dow }}<\u002Fspan>\n                <span style=\"font-size:17px;font-weight:780;font-variant-numeric:tabular-nums;line-height:1.1;\">{{ d.num }}<\u002Fspan>\n                <span style=\"font-size:9.5px;opacity:.75;\">{{ d.tag }}<\u002Fspan>\n              <\u002Fbutton>\n            <\u002Fsc-for>\n          <\u002Fdiv>\n\n          <div style=\"{{ calLayoutStyle }}\">\n            <div style=\"min-width:0;\">\n              <div style=\"display:flex;align-items:center;justify-content:space-between;gap:10px;margin:0 0 9px;flex-wrap:wrap;\">\n                <div style=\"font-size:12px;font-weight:700;letter-spacing:.04em;color:#8a97ac;text-transform:uppercase;\">{{ calDayLabel }}<\u002Fdiv>\n                <div style=\"display:flex;align-items:center;gap:9px;flex-wrap:wrap;\">\n                  <div style=\"display:inline-flex;gap:2px;background:#eef1f6;border:1px solid #e6ebf2;border-radius:9px;padding:3px;\">\n                    <sc-for list=\"{{ calModeOpts }}\" as=\"o\" hint-placeholder-count=\"2\"><button sc-camel-on-click=\"{{ o.pick }}\" style=\"{{ o.style }}\">{{ o.label }}<\u002Fbutton><\u002Fsc-for>\n                  <\u002Fdiv>\n                  <button sc-camel-on-click=\"{{ calToggleFull }}\" style=\"{{ calFullStyle }}\">{{ calFullLabel }}<\u002Fbutton>\n                  <span style=\"font-size:10.5px;color:#b6c1d1;\">Drag on the grid to block time<\u002Fspan>\n                <\u002Fdiv>\n              <\u002Fdiv>\n              <div style=\"background:#fff;border:1px solid #e6ebf2;border-radius:12px;box-shadow:0 1px 2px rgba(16,35,63,.04);overflow:hidden;\">\n                <div data-cal-scroll=\"1\" style=\"max-height:660px;overflow:auto;\">\n                  <div style=\"{{ calHeadStyle }}\">\n                    <div style=\"width:54px;flex:0 0 54px;background:#fbfcfe;\"><\u002Fdiv>\n                    <sc-for list=\"{{ calCols }}\" as=\"c\" hint-placeholder-count=\"1\">\n                      <div style=\"{{ c.headStyle }}\">\n                        <div style=\"font-size:9.5px;font-weight:750;letter-spacing:.06em;text-transform:uppercase;color:#9aa6b8;\">{{ c.dow }}<\u002Fdiv>\n                        <div style=\"{{ c.numStyle }}\">{{ c.num }}<\u002Fdiv>\n                      <\u002Fdiv>\n                    <\u002Fsc-for>\n                  <\u002Fdiv>\n                  <div style=\"{{ calInnerStyle }}\">\n                    <div style=\"{{ calGutterStyle }}\">\n                      <sc-for list=\"{{ calHours }}\" as=\"h\" hint-placeholder-count=\"24\">\n                        <span style=\"{{ h.style }}\">{{ h.label }}<\u002Fspan>\n                      <\u002Fsc-for>\n                    <\u002Fdiv>\n                    <sc-for list=\"{{ calCols }}\" as=\"c\" hint-placeholder-count=\"1\">\n                      <div sc-camel-on-mouse-down=\"{{ c.onDown }}\" sc-camel-on-mouse-move=\"{{ c.onMove }}\" sc-camel-on-mouse-up=\"{{ c.onUp }}\" sc-camel-on-mouse-leave=\"{{ c.onLeave }}\" style=\"{{ c.colStyle }}\">\n                        <sc-for list=\"{{ calLines }}\" as=\"l\" hint-placeholder-count=\"24\">\n                          <span style=\"{{ l.style }}\"><\u002Fspan>\n                        <\u002Fsc-for>\n                        <sc-if value=\"{{ c.showNow }}\" hint-placeholder-val=\"{{ false }}\">\n                          <span style=\"{{ calNowStyle }}\"><\u002Fspan>\n                        <\u002Fsc-if>\n                        <sc-for list=\"{{ c.events }}\" as=\"ev\" hint-placeholder-count=\"2\">\n                          <div title=\"{{ ev.tip }}\" style=\"{{ ev.style }}\">\n                            <sc-if value=\"{{ ev.showTime }}\" hint-placeholder-val=\"{{ true }}\"><div style=\"{{ ev.timeStyle }}\">{{ ev.time }}<\u002Fdiv><\u002Fsc-if>\n                            <div style=\"{{ ev.nameStyle }}\">{{ ev.name }}<\u002Fdiv>\n                            <sc-if value=\"{{ ev.roomy }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"{{ ev.subStyle }}\">{{ ev.sub }}<\u002Fdiv><\u002Fsc-if>\n                            <sc-if value=\"{{ ev.canRemove }}\" hint-placeholder-val=\"{{ false }}\">\n                              <button sc-camel-on-click=\"{{ ev.remove }}\" sc-camel-on-mouse-down=\"{{ stop }}\" title=\"Delete this block\" style=\"position:absolute;top:2px;right:4px;border:none;background:transparent;padding:0;color:rgba(255,255,255,.8);font-size:13px;line-height:1;cursor:pointer;font-family:inherit;\">×<\u002Fbutton>\n                            <\u002Fsc-if>\n                          <\u002Fdiv>\n                        <\u002Fsc-for>\n                        <sc-if value=\"{{ c.hasDrag }}\" hint-placeholder-val=\"{{ false }}\">\n                          <div style=\"{{ c.dragStyle }}\">{{ c.dragLabel }}<\u002Fdiv>\n                        <\u002Fsc-if>\n                      <\u002Fdiv>\n                    <\u002Fsc-for>\n                  <\u002Fdiv>\n                <\u002Fdiv>\n              <\u002Fdiv>\n            <\u002Fdiv>\n\n            <div>\n              <div style=\"font-size:12px;font-weight:700;letter-spacing:.04em;color:#8a97ac;text-transform:uppercase;margin:0 0 9px;\">Confirmed · {{ calBookedCount }}<\u002Fdiv>\n              <sc-if value=\"{{ calBookedEmpty }}\" hint-placeholder-val=\"{{ true }}\">\n                <div style=\"background:#fff;border:1px dashed #d5deeb;border-radius:12px;padding:24px 20px;text-align:center;font-size:12.5px;color:#9aa6b8;\">Nothing confirmed yet.<\u002Fdiv>\n              <\u002Fsc-if>\n              <div style=\"display:flex;flex-direction:column;gap:9px;\">\n                <sc-for list=\"{{ calBooked }}\" as=\"b\" hint-placeholder-count=\"2\">\n                  <div style=\"display:flex;align-items:center;gap:10px;background:#fff;border:1px solid #cdeede;border-radius:12px;padding:12px 14px;box-shadow:0 1px 2px rgba(16,35,6